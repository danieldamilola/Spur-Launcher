<UserControl x:Class="Spur.Views.FilePreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Spur.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceAcrylic}"
            BorderBrush="{DynamicResource GlassBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusWindow}"
            Padding="0"
            MaxWidth="320"
            MinWidth="260">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: file name + info -->
            <StackPanel Grid.Row="0" Margin="14,12,14,8">
                <TextBlock Text="{Binding PreviewFileName}"
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="13" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PreviewFileInfo}"
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Separator}"/>

            <!-- Content area -->
            <Grid Grid.Row="1">
                <!-- Text preview -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="280"
                              Visibility="{Binding PreviewContent, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding PreviewContent}"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="11"
                               LineHeight="16"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Padding="14,10"/>
                </ScrollViewer>

                <!-- Image preview -->
                <Image Source="{Binding PreviewImage}"
                       MaxHeight="280"
                       Stretch="Uniform"
                       Margin="14,10"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVis}}"/>

                <!-- Fallback: no preview available -->
                <TextBlock Text="Preview unavailable for this file type"
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="14,20"
                           x:Name="FallbackText"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
