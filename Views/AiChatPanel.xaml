<UserControl x:Class="Spur.Views.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             Loaded="OnLoaded" Unloaded="OnUnloaded">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═══ Scrollable chat area ═══ -->
    <ScrollViewer x:Name="ChatScroll"
                  Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="16,12,16,4">

      <StackPanel>
        <!-- Empty state -->
        <StackPanel x:Name="EmptyState"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,60,0,60">
          <Image Source="/Assets/Icons/find.png" Width="32" Height="32"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                 HorizontalAlignment="Center" Margin="0,0,0,12"
                 Opacity="0.5"/>
          <TextBlock Text="What can I help with?"
                     FontFamily="{DynamicResource Token.Font.Primary}"
                     FontSize="15" FontWeight="Medium"
                     Foreground="{DynamicResource TextPrimary}"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,4"/>
          <TextBlock Text="Type a question and press Enter"
                     FontFamily="{DynamicResource Token.Font.Primary}"
                     FontSize="12"
                     Foreground="{DynamicResource TextTertiary}"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Conversation cards (populated from code-behind) -->
        <StackPanel x:Name="ConversationPanel" Visibility="Collapsed">
          <StackPanel x:Name="ConversationItems"/>
        </StackPanel>

        <!-- Thinking indicator -->
        <StackPanel x:Name="ThinkingIndicator"
                    Orientation="Horizontal"
                    Margin="0,4,0,12"
                    Visibility="Collapsed">
          <Border Width="8" Height="8" CornerRadius="4"
                  Background="{DynamicResource AccentBrush}"
                  Margin="0,0,8,0" VerticalAlignment="Center"
                  Opacity="0.7"/>
          <TextBlock Text="Thinking..."
                     FontFamily="{DynamicResource Token.Font.Primary}"
                     FontSize="13" FontStyle="Italic"
                     Foreground="{DynamicResource TextTertiary}"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Error message -->
        <TextBlock x:Name="ErrorBlock"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Red}"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="13" Margin="0,0,0,8"
                   Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>

    <!-- ═══ Footer bar ═══ -->
    <Border Grid.Row="1"
            Padding="14,8"
            Background="{DynamicResource Depth2}"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: AI label + model name -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/Assets/Icons/find.png" Width="14" Height="14"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                 Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="AI"
                     FontFamily="{DynamicResource Token.Font.Primary}"
                     FontWeight="SemiBold" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"/>
          <TextBlock x:Name="ModelLabel" Text="AI"
                     FontFamily="{DynamicResource Token.Font.Primary}"
                     FontSize="11"
                     Foreground="{DynamicResource TextTertiary}"
                     VerticalAlignment="Center"/>
          <!-- Clear button -->
          <Button x:Name="ClearButton"
                  Click="OnClearClick"
                  Visibility="Collapsed"
                  Margin="12,0,0,0"
                  Padding="6,2"
                  Cursor="Hand"
                  Background="Transparent"
                  BorderThickness="0">
            <StackPanel Orientation="Horizontal">
              <ui:FontIcon Glyph="&#xE74D;" FontSize="11" Margin="0,0,4,0"
                           Foreground="{DynamicResource TextTertiary}"/>
              <TextBlock Text="Clear"
                         FontFamily="{DynamicResource Token.Font.Primary}"
                         FontSize="11"
                         Foreground="{DynamicResource TextTertiary}"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Right: Paste Response -->
        <Button Grid.Column="2"
                Click="OnPasteResponseClick"
                Padding="8,4"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Copy Response"
                       FontFamily="{DynamicResource Token.Font.Primary}"
                       FontSize="11"
                       Foreground="{DynamicResource TextTertiary}"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"/>
            <TextBlock Text="Ctrl+C"
                       FontFamily="{DynamicResource Token.Font.Primary}"
                       FontSize="10"
                       Foreground="{DynamicResource TextTertiary}"
                       VerticalAlignment="Center"
                       Opacity="0.6"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
