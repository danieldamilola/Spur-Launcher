<UserControl x:Class="Spur.Views.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:conv="clr-namespace:Spur.Converters">

    <Border Height="56"
            Margin="12,0,8,0"
            Background="Transparent"
            CornerRadius="16">
        <Grid Margin="0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SearchIconBorder"
                Grid.Column="0"
                VerticalAlignment="Center"
                Margin="0,0,12,0"
                AutomationProperties.Name="Search">
            <ui:FontIcon Glyph="&#xE11A;"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="20"/>
        </Border>

        <TextBox x:Name="SearchInput"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 FontFamily="{DynamicResource Token.Font.Primary}"
                 FontSize="{DynamicResource FontSearch}"
                 FontWeight="Normal"
                 Foreground="{DynamicResource TextPrimary}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 AutomationProperties.Name="Search query"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="OnTextChanged">
            <TextBox.Triggers>
                <EventTrigger RoutedEvent="TextBox.GotFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SearchIconBorder"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0.6" Duration="0:0:0.15"
                                             EasingFunction="{StaticResource AnimEaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="TextBox.LostFocus">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SearchIconBorder"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.25"
                                             EasingFunction="{StaticResource AnimEaseIn}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </TextBox.Triggers>
        </TextBox>

        <TextBlock x:Name="Placeholder"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="{DynamicResource FontSearch}"
                   FontWeight="Normal"
                   Foreground="{DynamicResource TextTertiary}"
                   Text="{Binding SearchPlaceholder, Mode=OneWay}"/>

        <Border Grid.Column="2"
                VerticalAlignment="Center"
                Margin="12,0,2,0"
                Padding="7,2"
                CornerRadius="6"
                Background="{DynamicResource SurfaceLow}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                AutomationProperties.Name="Dismiss (Escape)">
            <TextBlock FontFamily="{DynamicResource Token.Font.Mono}"
                       FontSize="{DynamicResource FontXs}"
                       Foreground="{DynamicResource TextTertiary}"
                       Text="esc"/>
        </Border>
        </Grid>
    </Border>
</UserControl>

