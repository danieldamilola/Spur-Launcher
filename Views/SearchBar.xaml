<UserControl x:Class="Arc.Views.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Height="52" Margin="20,0,20,0">
        <TextBox x:Name="SearchInput"
                 VerticalAlignment="Center"
                 FontFamily="{DynamicResource UIFont}"
                 FontSize="{DynamicResource FontSearch}"
                 FontWeight="Normal"
                 Foreground="{DynamicResource TextPrimary}"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="OnTextChanged"/>

        <TextBlock x:Name="Placeholder"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   FontFamily="{DynamicResource UIFont}"
                   FontSize="{DynamicResource FontSearch}"
                   FontWeight="Normal"
                   Foreground="{DynamicResource TextTertiary}"
                   Text="Search"/>
    </Grid>
</UserControl>
