<UserControl x:Class="Arc.Views.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Height="56"
            Margin="14,0,8,0"
            Background="Transparent"
            CornerRadius="16">
        <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="30" Height="30"
                CornerRadius="9"
                Background="{DynamicResource AccentGhost}"
                VerticalAlignment="Center"
                Margin="0,0,12,0">
            <Path Width="16" Height="16"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Stretch="Uniform"
                  Data="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm0 0 6 6"
                  Stroke="{DynamicResource Accent}"
                  StrokeThickness="1.5"
                  StrokeLineJoin="Round"
                  Fill="Transparent"/>
        </Border>

        <TextBox x:Name="SearchInput"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 FontFamily="{DynamicResource UIFont}"
                 FontSize="{DynamicResource FontSearch}"
                 FontWeight="Normal"
                 Foreground="{DynamicResource TextPrimary}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="OnTextChanged"/>

        <TextBlock x:Name="Placeholder"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   FontFamily="{DynamicResource UIFont}"
                   FontSize="{DynamicResource FontSearch}"
                   FontWeight="Normal"
                   Foreground="{DynamicResource TextTertiary}"
                   Text="{Binding SearchPlaceholder, Mode=OneWay}"/>

        <Border Grid.Column="2"
                VerticalAlignment="Center"
                Margin="12,0,2,0"
                Padding="7,2"
                CornerRadius="6"
                Background="{DynamicResource SurfaceLow}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <TextBlock FontFamily="{DynamicResource MonoFont}"
                       FontSize="{DynamicResource FontXs}"
                       Foreground="{DynamicResource TextTertiary}"
                       Text="esc"/>
        </Border>
        </Grid>
    </Border>
</UserControl>
