<UserControl x:Class="Spur.Views.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:conv="clr-namespace:Spur.Converters"
             xmlns:res="clr-namespace:Spur.Resources">

    <Border Height="56"
            Margin="16,0,16,0"
            Background="Transparent"
            CornerRadius="{DynamicResource RadiusWindow}">
        <Grid Margin="0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>



        <TextBox x:Name="SearchInput"
                 Grid.Column="1"
                 VerticalAlignment="Center"
                 FontFamily="{DynamicResource Token.Font.Primary}"
                 FontSize="{DynamicResource FontSearch}"
                 FontWeight="Normal"
                 Foreground="{DynamicResource TextPrimary}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 AutomationProperties.Name="Search query"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="OnTextChanged">

        </TextBox>

        <TextBlock x:Name="Placeholder"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="{DynamicResource FontSearch}"
                   FontWeight="Normal"
                   Foreground="{DynamicResource TextTertiary}"
                   Text="{Binding SearchPlaceholder, Mode=OneWay, FallbackValue={x:Static res:Strings.SearchPlaceholder}}"/>

        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0">
            <!-- Esc badge (hidden when clipboard is active) -->
            <Border Padding="8,4"
                    CornerRadius="{DynamicResource RadiusSm}"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    AutomationProperties.Name="Dismiss (Escape)">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveCategory}" Value="clipboard">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontFamily="{DynamicResource Token.Font.Mono}"
                           FontSize="{DynamicResource FontXs}"
                           Foreground="{DynamicResource TextTertiary}"
                           Text="esc"/>
            </Border>
            <!-- Clipboard ⋮ menu (only when clipboard category is active) -->
            <Border Padding="4,2"
                    CornerRadius="{DynamicResource RadiusSm}"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveCategory}" Value="clipboard">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Button x:Name="ClipMoreBtn" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" Click="OnClipMoreClick">
                    <TextBlock Text="⋯" FontSize="16" Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,2"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Clear unpinned" Command="{Binding Clipboard.ClearAllCommand}"/>
                            <Separator/>
                            <MenuItem Header="Close clipboard" Click="OnClipboardCloseClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Border>
        </Grid>
        </Grid>
    </Border>
</UserControl>

