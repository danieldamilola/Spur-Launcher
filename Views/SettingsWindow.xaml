<Window x:Class="Arc.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Arc.Views"
        Title="Spur Settings"
        Icon="pack://application:,,,/Icons/arc-launcher-32x32.ico"
        Width="900"
        Height="640"
        MinWidth="800"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Closing="OnClosing"
        Background="{DynamicResource SurfaceLow}">

    <views:SettingsView x:Name="SettingsViewControl"/>

</Window>
