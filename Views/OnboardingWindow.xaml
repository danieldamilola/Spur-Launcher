<Window x:Class="Spur.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Spur"
        Width="520"
        Height="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        AutomationProperties.Name="Welcome to Spur"
        MouseLeftButtonDown="OnDrag">

    <Border Background="{DynamicResource Depth1}"
            CornerRadius="16"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="48,40,48,16">
                <!-- Slide 1: Welcome -->
                <StackPanel x:Name="Slide1" VerticalAlignment="Center">
                    <Image Width="64" Height="64"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/Icons/spur-launcher-64x64.ico"/>
                    <TextBlock Text="Spur"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="36"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Spur your workflow."
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="15"
                               Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <TextBlock Text="A fast, minimal launcher for Windows. Nothing leaves your device — no tracking, no upsells, no clutter."
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="360"/>
                </StackPanel>

                <!-- Slide 2: Hotkey Setup -->
                <StackPanel x:Name="Slide2" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Choose your shortcut"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="How will you summon Spur?"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <Border x:Name="KeyCaptureBorder"
                            Focusable="True"
                            Cursor="Hand"
                            Background="{DynamicResource Depth2}"
                            CornerRadius="12"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="2"
                            Padding="32,24"
                            HorizontalAlignment="Center"
                            MinWidth="220"
                            AutomationProperties.Name="Click to set shortcut key"
                            PreviewKeyDown="OnKeyCaptureDown"
                            LostFocus="OnKeyCaptureLostFocus"
                            GotFocus="OnKeyCaptureGotFocus"
                            MouseLeftButtonDown="OnKeyCaptureClick">
                        <StackPanel>
                            <TextBlock x:Name="KeyCaptureText"
                                       Text="Alt + Space"
                                       FontFamily="{DynamicResource Token.Font.Mono}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="KeyCaptureHint"
                                       Text="Click here, then press a key combination"
                                       FontFamily="{DynamicResource Token.Font.Primary}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Try Alt+Space, Ctrl+Shift+K, or whatever feels natural."
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Slide 3: Theme -->
                <StackPanel x:Name="Slide3" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Pick your look"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="You can change this anytime in Settings."
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Dark -->
                        <Border x:Name="ThemeDarkCard"
                                Width="120"
                                CornerRadius="10"
                                Background="{DynamicResource Depth2}"
                                BorderBrush="{DynamicResource Accent}"
                                BorderThickness="2"
                                Padding="0"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                AutomationProperties.Name="Dark theme"
                                MouseLeftButtonDown="OnThemeDarkClick">
                            <StackPanel Margin="16">
                                <Border Width="88" Height="48" CornerRadius="6"
                                        Background="{DynamicResource OnboardingPreviewDark}" Margin="0,0,0,8"/>
                                <TextBlock Text="Dark"
                                           FontFamily="{DynamicResource Token.Font.Primary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Light -->
                        <Border x:Name="ThemeLightCard"
                                Width="120"
                                CornerRadius="10"
                                Background="{DynamicResource Depth2}"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                Padding="0"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                AutomationProperties.Name="Light theme"
                                MouseLeftButtonDown="OnThemeLightClick">
                            <StackPanel Margin="16">
                                <Border Width="88" Height="48" CornerRadius="6"
                                        Background="{DynamicResource OnboardingPreviewLight}" Margin="0,0,0,8"/>
                                <TextBlock Text="Light"
                                           FontFamily="{DynamicResource Token.Font.Primary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- System -->
                        <Border x:Name="ThemeSystemCard"
                                Width="120"
                                CornerRadius="10"
                                Background="{DynamicResource Depth2}"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                Padding="0"
                                Cursor="Hand"
                                AutomationProperties.Name="System theme"
                                MouseLeftButtonDown="OnThemeSystemClick">
                            <StackPanel Margin="16">
                                <Border Width="88" Height="48" CornerRadius="6"
                                        Background="{DynamicResource OnboardingPreviewDark}" Margin="0,0,0,8">
                                    <Border Width="44" Height="48" CornerRadius="0,0,0,6"
                                            Background="{DynamicResource OnboardingPreviewLight}" HorizontalAlignment="Right"/>
                                </Border>
                                <TextBlock Text="System"
                                           FontFamily="{DynamicResource Token.Font.Primary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Slide 4: Ready -->
                <StackPanel x:Name="Slide4" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="ReadyHeading"
                               Text="You're all set."
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="ReadySummary"
                               Text=""
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               Margin="0,0,0,32"/>
                    <TextBlock Text="Press Alt+Space anytime to open Spur."
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="48,0,48,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="0,0,8,0"
                             Fill="{DynamicResource TextPrimary}"
                             AutomationProperties.Name="Step 1 of 4"/>
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="0,0,8,0"
                             Fill="{DynamicResource BorderStrong}"
                             AutomationProperties.Name="Step 2 of 4"/>
                    <Ellipse x:Name="Dot3" Width="8" Height="8" Margin="0,0,8,0"
                             Fill="{DynamicResource BorderStrong}"
                             AutomationProperties.Name="Step 3 of 4"/>
                    <Ellipse x:Name="Dot4" Width="8" Height="8"
                             Fill="{DynamicResource BorderStrong}"
                             AutomationProperties.Name="Step 4 of 4"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Skip"
                        Margin="0,0,8,0"
                        FontFamily="{DynamicResource Token.Font.Primary}"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,8"
                        Cursor="Hand"
                        AutomationProperties.Name="Skip onboarding"
                        Click="OnSkipClick"/>

                <Button Grid.Column="2"
                        x:Name="NextButton"
                        Content="Continue"
                        FontFamily="{DynamicResource Token.Font.Primary}"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextPrimary}"
                        Background="{DynamicResource Depth2}"
                        BorderBrush="{DynamicResource BorderStrong}"
                        BorderThickness="1"
                        Padding="20,8"
                        Cursor="Hand"
                        AutomationProperties.Name="Continue"
                        Click="OnNextClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>