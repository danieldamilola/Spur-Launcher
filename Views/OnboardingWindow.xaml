<Window x:Class="Arc.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Arc"
        Width="520"
        Height="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnDrag">

    <Border Background="{DynamicResource Depth1}"
            CornerRadius="16"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="48,40,48,16">
                <!-- Step 1 -->
                <StackPanel x:Name="Slide1" VerticalAlignment="Center">
                    <Image Width="56" Height="56"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/Icons/arc-launcher-64x64.ico"/>
                    <TextBlock Text="Instant search for everything on your PC."
                               FontFamily="{DynamicResource UIFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Press Alt+Space anywhere to open Arc."
                               FontFamily="{DynamicResource UIFont}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Step 2 -->
                <StackPanel x:Name="Slide2" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Indexed locally on your device"
                               FontFamily="{DynamicResource UIFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <Border Background="{DynamicResource Depth2}"
                            CornerRadius="12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="20,16"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Apps installed on this PC"
                                       FontFamily="{DynamicResource UIFont}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Optional folders and clipboard history (Settings → Search)"
                                       FontFamily="{DynamicResource UIFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Nothing leaves your machine unless you choose web search."
                               FontFamily="{DynamicResource UIFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Step 3 -->
                <StackPanel x:Name="Slide3" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Try it now"
                               FontFamily="{DynamicResource UIFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    <Border Background="{DynamicResource Depth2}"
                            CornerRadius="12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="24,20"
                            HorizontalAlignment="Center">
                        <TextBlock Text="Alt + Space"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Type to search · Enter to launch · Escape to dismiss"
                               FontFamily="{DynamicResource UIFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="48,0,48,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="0,0,8,0"
                             Fill="{DynamicResource TextPrimary}"/>
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="0,0,8,0"
                             Fill="{DynamicResource BorderStrong}"/>
                    <Ellipse x:Name="Dot3" Width="8" Height="8"
                             Fill="{DynamicResource BorderStrong}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Skip"
                        Margin="0,0,8,0"
                        FontFamily="{DynamicResource UIFont}"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,8"
                        Cursor="Hand"
                        Click="OnSkipClick"/>

                <Button Grid.Column="2"
                        x:Name="NextButton"
                        Content="Continue"
                        FontFamily="{DynamicResource UIFont}"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextPrimary}"
                        Background="{DynamicResource Depth2}"
                        BorderBrush="{DynamicResource BorderStrong}"
                        BorderThickness="1"
                        Padding="20,8"
                        Cursor="Hand"
                        Click="OnNextClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
