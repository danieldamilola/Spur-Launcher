<UserControl x:Class="Arc.Views.ResultsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Arc.Views"
             xmlns:models="clr-namespace:Arc.Models"
             xmlns:conv="clr-namespace:Arc.Converters">

    <UserControl.Resources>

        <!-- ── Bool converters (also used by MainWindow via MergedDictionary) ── -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>

        <!-- ── Unified result template with clipboard actions ── -->
        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type models:SearchResult}">
            <Grid x:Name="RowRoot"
                  Height="{DynamicResource RowHeight}"
                  Background="Transparent"
                  Cursor="Hand"
                  ToolTip="{Binding Name}"
                  AutomationProperties.Name="{Binding Name}"
                  MouseLeftButtonDown="OnRowClick">

                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Run as Administrator"
                                  Command="{Binding DataContext.RunAsAdminCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  InputGestureText="Ctrl+Enter"/>
                        <MenuItem Header="Open file location"
                                  Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  InputGestureText="Ctrl+Shift+E"/>
                        <MenuItem Header="Copy path"
                                  Command="{Binding DataContext.CopySelectedPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  InputGestureText="Ctrl+C"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Selection rail -->
                <Border x:Name="SelectionRail"
                        Grid.Column="1"
                        Background="Transparent"
                        CornerRadius="2"
                        Margin="0,8,0,8"/>

                <!-- Row background -->
                <Border x:Name="RowBg"
                        Grid.Column="2"
                        Background="Transparent"
                        CornerRadius="{DynamicResource RadiusRow}"/>

                <Grid Grid.Column="2" Margin="12,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Grid.Column="0"
                            Width="32" Height="32"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceLow}"
                            VerticalAlignment="Center">
                        <Image x:Name="AppIcon"
                               Width="26" Height="26"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <Binding Path="IconPath">
                                    <Binding.Converter>
                                        <conv:PathToIconConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <Path x:Name="LucideIcon"
                              Width="15" Height="15"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed">
                            <Path.Data>
                                <Binding Path="LucideIcon">
                                    <Binding.Converter>
                                        <conv:LucideIconConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Path.Data>
                        </Path>
                    </Border>

                    <!-- Name + subtitle -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText"
                                   Text="{Binding Name}"
                                   FontFamily="{DynamicResource UIFont}"
                                   FontSize="{DynamicResource FontResult}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubtitleText"
                                   FontFamily="{DynamicResource UIFont}"
                                   FontSize="{DynamicResource FontMeta}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding DisplaySubtitle}"/>
                    </StackPanel>

                    <!-- Enter hint -->
                    <Border x:Name="EnterHint"
                            Grid.Column="3"
                            CornerRadius="6"
                            Background="{DynamicResource SurfaceRaised}"
                            Padding="7,3"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                        <TextBlock Text="↵"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextTertiary}"/>
                    </Border>

                    <!-- Clipboard actions -->
                    <StackPanel x:Name="ClipActions"
                                Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="PinBtn"
                                Width="26" Height="26"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" FocusVisualStyle="{x:Null}"
                                ToolTip="Pin"
                                Tag="{Binding IsPinned}"
                                Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="5">
                                        <Path Width="11" Height="11" Stretch="Uniform"
                                              x:Name="PinPath"
                                              Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Fill="Transparent"
                                              Data="M12 2l2 6h6l-5 4 2 6-5-4-5 4 2-6-5-4h6z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Depth3}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                            <Setter TargetName="PinPath" Property="Fill" Value="{DynamicResource TextPrimary}"/>
                                            <Setter TargetName="PinPath" Property="Stroke" Value="{DynamicResource TextPrimary}"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="26" Height="26"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" FocusVisualStyle="{x:Null}"
                                ToolTip="Remove"
                                Click="OnClipDeleteClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="5">
                                        <Path Width="11" Height="11" Stretch="Uniform"
                                              Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Fill="Transparent"
                                              Data="M3 6h18M19 6l-1 14H6L5 6M9 6V4h6v2"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Depth3}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <DataTemplate.Triggers>
                <!-- Hover (unselected) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource HoverBg}"/>
                </MultiDataTrigger>

                <!-- Selected -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="SelectionRail" Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="RowBg" Property="Background" Value="{DynamicResource SelectedBg}"/>
                    <Setter TargetName="EnterHint" Property="Visibility" Value="Visible"/>
                </DataTrigger>

                <!-- No file icon → Lucide fallback -->
                <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                    <Setter TargetName="AppIcon" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="LucideIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>

                <!-- Clipboard actions on hover -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                        <Condition Binding="{Binding Type}" Value="Clipboard"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ClipActions" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="EnterHint" Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Section label template -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type models:SectionLabel}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           FontFamily="{DynamicResource UIFont}"
                           FontSize="{DynamicResource FontHint}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextMuted}"
                           Padding="16,10,16,6"
                           TextOptions.TextFormattingMode="Display"/>
                <Button Grid.Column="1"
                        Content="Clear"
                        FontFamily="{DynamicResource UIFont}"
                        FontSize="10"
                        Foreground="{DynamicResource TextMuted}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="8,3,10,0"
                        VerticalAlignment="Bottom"
                        Command="{Binding DataContext.ClearClipboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        FocusVisualStyle="{x:Null}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Title}" Value="Clipboard">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>

        <local:ResultTemplateSelector x:Key="TemplateSelector"
                                      SectionTemplate="{StaticResource SectionTemplate}"
                                      ResultTemplate="{StaticResource ResultTemplate}"/>
    </UserControl.Resources>

    <ListBox x:Name="ResultsBox"
             ItemsSource="{Binding Results}"
             ItemTemplateSelector="{StaticResource TemplateSelector}"
             SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
             SelectionChanged="OnSelectionChanged"
             HorizontalContentAlignment="Stretch"
             Padding="0,2,0,4"
             MaxHeight="352"
             Focusable="False"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingStackPanel.IsVirtualizing="True"
             VirtualizingStackPanel.VirtualizationMode="Recycling"
             ScrollViewer.CanContentScroll="True"/>
</UserControl>
