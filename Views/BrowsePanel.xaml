<UserControl x:Class="Arc.Views.BrowsePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Arc.Models"
             xmlns:conv="clr-namespace:Arc.Converters"
             Background="Transparent">

    <!--
        BrowsePanel — category browse (files / clipboard / actions).
        Uses shared templates from CommonStyles.xaml.
        Click handling via PreviewMouseLeftButtonDown on each ListBox.
    -->

    <Grid>

    <!-- ═══ Loading ═══ -->
    <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ProgressBar Grid.Row="1" IsIndeterminate="True"
                     Foreground="{DynamicResource Accent}"
                     Background="Transparent"
                     Height="2"
                     HorizontalAlignment="Center" Width="120"/>
    </Grid>

    <!-- ═══ Files section ═══ -->
    <Grid x:Name="FilesSection" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Recent files"
                   Style="{DynamicResource ShelfHeaderStyle}"/>

        <ListBox x:Name="FilesList" Grid.Row="1"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 FocusVisualStyle="{x:Null}"
                 ItemTemplate="{DynamicResource ResultRowTemplate}"
                 PreviewMouseLeftButtonDown="OnItemClick"/>
    </Grid>

    <!-- ═══ Clipboard section ═══ -->
    <Grid x:Name="ClipSection" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Clipboard"
                   Style="{DynamicResource ShelfHeaderStyle}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,6">
            <TextBlock x:Name="ClipCount"
                       FontFamily="{DynamicResource UIFont}"
                       FontSize="{DynamicResource FontXs}"
                       Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>

            <Button Style="{DynamicResource FilterChipStyle}"
                    Content="Clear all"
                    Click="OnClearClipboard"/>
        </StackPanel>

        <ListBox x:Name="ClipList" Grid.Row="2"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 FocusVisualStyle="{x:Null}"
                 ItemTemplate="{DynamicResource ClipResultTemplate}"
                 PreviewMouseLeftButtonDown="OnItemClick"/>
    </Grid>

    <!-- ═══ Actions section ═══ -->
    <Grid x:Name="ActionsSection" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Commands"
                   Style="{DynamicResource ShelfHeaderStyle}"/>

        <ListBox x:Name="ActionsList" Grid.Row="1"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 FocusVisualStyle="{x:Null}"
                 ItemTemplate="{DynamicResource ActionResultTemplate}"
                 PreviewMouseLeftButtonDown="OnItemClick"/>
    </Grid>

    </Grid>

</UserControl>
