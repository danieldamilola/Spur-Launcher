<Window x:Class="Spur.Views.EyedropperOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Cursor="Cross"
        Title="EyedropperOverlay">

    <!-- Info panel that follows the cursor showing zoomed preview and color info -->
    <Canvas x:Name="OverlayCanvas">
        <Border x:Name="InfoPanel"
                Background="#E0202020"
                CornerRadius="8"
                Padding="8"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                Canvas.Left="0" Canvas.Top="0"
                Visibility="Visible">
            <StackPanel>
                <!-- Pixel zoom grid (9x9) -->
                <Border BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,0,6"
                        HorizontalAlignment="Center">
                    <UniformGrid x:Name="ZoomGrid" Rows="9" Columns="9"
                                 Width="108" Height="108"/>
                </Border>

                <!-- Color swatch + hex -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Border x:Name="ColorSwatch"
                            Width="20" Height="20"
                            CornerRadius="3"
                            BorderBrush="#40FFFFFF" BorderThickness="1"
                            Margin="0,0,6,0"/>
                    <TextBlock x:Name="HexText"
                               FontFamily="Consolas" FontSize="14"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Text="#000000"/>
                </StackPanel>

                <!-- RGB value -->
                <TextBlock x:Name="RgbText"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center"
                           Text="rgb(0, 0, 0)"/>

                <!-- Instruction -->
                <TextBlock FontSize="10" Foreground="#888888"
                           HorizontalAlignment="Center" Margin="0,4,0,0"
                           Text="Click to pick · Esc to cancel"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
