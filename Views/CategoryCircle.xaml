<UserControl x:Class="Spur.Views.CategoryCircle"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             Width="38" Height="44"

             RenderTransformOrigin="0.5,0.5"

             Opacity="0"

             IsHitTestVisible="False"

             MouseEnter="OnMouseEnter"

             MouseLeave="OnMouseLeave">



    <UserControl.RenderTransform>

        <ScaleTransform x:Name="CircleScale" ScaleX="0.92" ScaleY="0.92"/>

    </UserControl.RenderTransform>



    <StackPanel Width="38" VerticalAlignment="Center">

        <Border x:Name="Root"

                Width="34" Height="34"

                HorizontalAlignment="Center"

                CornerRadius="12"

                Background="{DynamicResource SurfaceLow}"

                BorderBrush="{DynamicResource BorderBrush}"

                BorderThickness="1"

                SnapsToDevicePixels="True"
                ToolTip="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}">

            <Button x:Name="Btn"

                    Background="Transparent"

                    BorderThickness="0"

                    Cursor="Hand"

                    AutomationProperties.Name="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"><Button.Template>

                    <ControlTemplate TargetType="Button">

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </ControlTemplate>

                </Button.Template>

                <Path x:Name="IconPath"

                      Width="16" Height="16"

                      Stretch="Uniform"

                      Stroke="{DynamicResource TextSecondary}"

                      StrokeThickness="1.5"

                      Fill="Transparent"/>

            </Button>

        </Border>

    </StackPanel>

</UserControl>


