<UserControl x:Class="Spur.Views.CategoryCircle"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             Width="52" Height="52"

             RenderTransformOrigin="0.5,0.5"

             Opacity="0"

             IsHitTestVisible="False">



    <UserControl.RenderTransform>

        <ScaleTransform x:Name="CircleScale" ScaleX="0.92" ScaleY="0.92"/>

    </UserControl.RenderTransform>



    <StackPanel Width="52" VerticalAlignment="Center">

        <Border x:Name="Root"
                Width="50" Height="50"
                HorizontalAlignment="Center"
                CornerRadius="{DynamicResource RadiusWindow}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                ToolTip="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Depth2}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Btn}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Button x:Name="Btn"

                    Background="Transparent"

                    BorderThickness="0"

                    Cursor="Hand"

                    AutomationProperties.Name="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"><Button.Template>

                    <ControlTemplate TargetType="Button">

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </ControlTemplate>

                </Button.Template>

                <Path x:Name="IconPath"
                      Width="22" Height="22"
                      Stretch="Uniform"
                      StrokeThickness="1.5"
                      Fill="Transparent">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

            </Button>

        </Border>

    </StackPanel>

</UserControl>




