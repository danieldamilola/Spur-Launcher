<Window x:Class="Spur.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spur"
        Width="400" Height="250"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    <Border Background="#1A1A2E"
            CornerRadius="16"
            Margin="10"
            Effect="{StaticResource PopupShadow}">
        <Border.Resources>
            <DropShadowEffect x:Key="PopupShadow"
                              ShadowDepth="0"
                              BlurRadius="20"
                              Color="#000000"
                              Opacity="0.5"/>
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Spur branding -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="Spur"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="#E0E0E0"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="0"
                                          BlurRadius="12"
                                          Color="#4A90D9"
                                          Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Getting things ready…"
                           FontSize="13"
                           Foreground="#8888AA"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- Indeterminate progress bar -->
            <ProgressBar Grid.Row="2"
                         IsIndeterminate="True"
                         Height="3"
                         Margin="40,0"
                         Background="#2A2A3E"
                         Foreground="#4A90D9"
                         BorderThickness="0"/>
        </Grid>
    </Border>
</Window>
