<UserControl x:Class="Spur.Views.ClipboardManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Spur.Models"
             Background="Transparent">

    <!--
        ClipboardManager — standalone clipboard history browser.
        Extracted from the launcher's main search flow.
        DataContext → ClipboardViewModel.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Search/filter ═══ -->
        <Border Grid.Row="0" Style="{StaticResource SettingsInputFrame}"
                Margin="12,10,12,6">
            <TextBox x:Name="FilterBox"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{DynamicResource UIFont}"
                     FontSize="12"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"
                     Padding="8,6"
                     Foreground="{DynamicResource TextPrimary}"
                     CaretBrush="{DynamicResource Accent}"
                     AutomationProperties.Name="Filter clipboard entries"/>
        </Border>

        <!-- ═══ Actions bar ═══ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,2,12,8">
            <Button Style="{StaticResource FilterChipStyle}"
                    Content="Clear all"
                    Command="{Binding ClearAllCommand}"
                    AutomationProperties.Name="Clear all clipboard entries"/>
            <TextBlock Text="{Binding StatusText}"
                       FontFamily="{DynamicResource UIFont}"
                       FontSize="{DynamicResource FontXs}"
                       Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
        </StackPanel>

        <!-- ═══ Entry list ═══ -->
        <ListBox x:Name="ClipList"
                 Grid.Row="2"
                 ItemsSource="{Binding Entries}"
                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 FocusVisualStyle="{x:Null}"
                 AutomationProperties.Name="Clipboard history">

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ClipboardEntry}">
                    <Grid x:Name="RowRoot"
                          Margin="4,1"
                          Background="Transparent"
                          Cursor="Hand"
                          AutomationProperties.Name="{Binding Preview}">

                        <Border x:Name="RowBg"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Background="Transparent"/>
                        <Border x:Name="HoverOverlay"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Background="{DynamicResource HoverBg}"
                                Opacity="0"/>

                        <Grid Margin="10,6,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="11"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Image preview (only visible when IsImage) -->
                            <Border x:Name="ImgBox"
                                    Grid.Column="0"
                                    Width="30" Height="30"
                                    CornerRadius="{DynamicResource RadiusSm}"
                                    Background="{DynamicResource Depth2}"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <Image Width="28" Height="28"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Image}"/>
                            </Border>

                            <!-- Text icon -->
                            <Border x:Name="TextIconBox"
                                    Grid.Column="0"
                                    Width="30" Height="30"
                                    CornerRadius="{DynamicResource RadiusSm}"
                                    Background="{DynamicResource Depth2}"
                                    VerticalAlignment="Center">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2"/>
                            </Border>

                            <!-- Content -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Preview}"
                                           FontFamily="{DynamicResource UIFont}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding TimeAgo}"
                                           FontFamily="{DynamicResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           Opacity="0.8"/>
                            </StackPanel>

                            <!-- Pin + Delete buttons -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Pin button -->
                                <Button x:Name="PinBtn"
                                        Width="24" Height="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="2,0"
                                        ToolTip="Pin"
                                        Tag="{Binding}"
                                        AutomationProperties.Name="Pin entry"
                                        Click="OnPinClick">
                                    <Path Width="10" Height="10" Stretch="Uniform"
                                          Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Data="M12 2l2 6h6l-5 4 2 6-5-4-5 4 2-6-5-4h6z"/>
                                </Button>

                                <!-- Delete button -->
                                <Button Width="24" Height="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="2,0"
                                        ToolTip="Remove"
                                        AutomationProperties.Name="Delete entry"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Data="M18 6L6 18M6 6l12 12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <DataTemplate.Triggers>
                        <!-- Hover -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource AnimEaseOut}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2"
                                                         EasingFunction="{StaticResource AnimEaseIn}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Image entry -->
                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                            <Setter TargetName="ImgBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="TextIconBox" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ═══ Detail preview ═══ -->
        <Border Grid.Row="3"
                x:Name="DetailPanel"
                BorderBrush="{DynamicResource Separator}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Depth2}"
                Visibility="Collapsed"
                MaxHeight="120">
            <Grid Margin="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Copy"
                            Style="{StaticResource SettingsSoftButton}"
                            Command="{Binding CopyCommand}"
                            CommandParameter="{Binding SelectedEntry}"
                            AutomationProperties.Name="Copy selected entry"/>
                    <Button Content="Delete"
                            Style="{StaticResource SettingsSoftButton}"
                            Margin="6,0,0,0"
                            Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding SelectedEntry}"
                            Foreground="{DynamicResource TextMuted}"
                            AutomationProperties.Name="Delete selected entry"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="72">
                    <TextBlock Text="{Binding SelectedContent}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

</UserControl>
