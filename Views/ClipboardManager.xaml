<UserControl x:Class="Spur.Views.ClipboardManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:models="clr-namespace:Spur.Models"
             Background="Transparent">

    <!--
        ClipboardManager — standalone clipboard history browser.
        Extracted from the launcher's main search flow.
        DataContext → ClipboardViewModel.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Content area: list + detail panel ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Entry list ═══ -->
            <ListBox x:Name="ClipList"
                     Grid.Column="0"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     PreviewMouseLeftButtonUp="OnListMouseClick"
                     AutomationProperties.Name="Clipboard history">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="FocusVisualStyle">
                            <Setter.Value>
                                <Style>
                                    <Setter Property="Control.Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="{DynamicResource RadiusRow}" Margin="1" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Style>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ClipboardEntry}">
                        <Grid x:Name="RowRoot"
                              Height="{DynamicResource RowHeightTall}"
                              Background="Transparent"
                              Cursor="Hand"
                              AutomationProperties.Name="{Binding Preview}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Selection rail -->
                            <Border x:Name="SelectionRail"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    CornerRadius="2"
                                    Margin="0,8,0,8"/>

                            <!-- Row background -->
                            <Border x:Name="RowBg"
                                    Grid.Column="2"
                                    Background="Transparent"
                                    CornerRadius="{DynamicResource RadiusRow}"/>

                            <Border x:Name="HoverOverlay"
                                    Grid.Column="2"
                                    CornerRadius="{DynamicResource RadiusRow}"
                                    Background="{DynamicResource HoverBg}"
                                    Opacity="0"/>

                            <!-- Selected overlay -->
                            <Border x:Name="SelectedOverlay"
                                    Grid.Column="2"
                                    CornerRadius="{DynamicResource RadiusRow}"
                                    Background="{DynamicResource SelectedBg}"
                                    Opacity="0"/>

                            <Grid Grid.Column="2" Margin="12,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Image preview (only visible when IsImage) -->
                                <Border x:Name="ImgBox"
                                        Grid.Column="0"
                                        Width="32" Height="32"
                                        CornerRadius="{DynamicResource RadiusMd}"
                                        Background="{DynamicResource SurfaceLow}"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <Image Width="30" Height="30"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding Image}"/>
                                </Border>

                                <!-- Text icon -->
                                <Border x:Name="TextIconBox"
                                        Grid.Column="0"
                                        Width="32" Height="32"
                                        CornerRadius="{DynamicResource RadiusMd}"
                                        Background="{DynamicResource SurfaceLow}"
                                        VerticalAlignment="Center">
                                    <Image Source="/Assets/Icons/copy.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Content -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Preview}"
                                               FontFamily="{DynamicResource Token.Font.Primary}"
                                               FontSize="{DynamicResource FontBase}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TimeAgo}"
                                               FontFamily="{DynamicResource Token.Font.Secondary}"
                                               FontSize="{DynamicResource FontSm}"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Margin="0,1,0,0"/>
                                     <TextBlock x:Name="TruncWarning" Text="⚠ Truncated" 
                                                FontFamily="{DynamicResource Token.Font.Primary}"
                                                FontSize="{DynamicResource FontCaption}"
                                                Foreground="#E5A100"
                                                Visibility="Collapsed"
                                                Margin="6,1,0,0"/>
                                     <TextBlock x:Name="PinnedIndicator" Text="◉ Pinned"
                                                FontFamily="{DynamicResource Token.Font.Primary}"
                                                FontSize="{DynamicResource FontCaption}"
                                                Foreground="{DynamicResource Accent}"
                                                Visibility="Collapsed"
                                                Margin="6,1,0,0"/>
                                 </StackPanel>

                                <!-- Preview + Pin + Delete buttons -->
                                <StackPanel x:Name="ActionButtons" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0">
                                    <!-- Preview button -->
                                    <Button x:Name="PreviewBtn"
                                            Width="28" Height="28"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="1,0"
                                            ToolTip="Preview"
                                            AutomationProperties.Name="Preview entry"
                                            Click="OnPreviewClick"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="◉" FontSize="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Width="28" Height="28" CornerRadius="6" Background="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Pin button -->
                                    <Button x:Name="PinBtn"
                                            Width="28" Height="28"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="1,0"
                                            ToolTip="Pin"
                                            AutomationProperties.Name="Pin entry"
                                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock x:Name="PinGlyph" Text="●" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Width="28" Height="28" CornerRadius="6" Background="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Delete button -->
                                    <Button Width="28" Height="28"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="1,0"
                                            ToolTip="Remove"
                                            AutomationProperties.Name="Delete entry"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Width="28" Height="28" CornerRadius="6" Background="Transparent">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <DataTemplate.Triggers>
                            <!-- Hover -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.08"
                                                             EasingFunction="{StaticResource AnimEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.08"
                                                             EasingFunction="{StaticResource AnimEaseIn}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <!-- Image entry -->
                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                <Setter TargetName="ImgBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TextIconBox" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>

                            <!-- Selection rail + selected overlay when selected -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter TargetName="SelectionRail" Property="Background" Value="{DynamicResource Accent}"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <!-- Pin visual indicator: swap glyph + color when pinned -->
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="PinGlyph" Property="Text" Value="◉"/>
                                <Setter TargetName="PinGlyph" Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="PinBtn" Property="ToolTip" Value="Unpin"/>
                                <Setter TargetName="PinnedIndicator" Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                            <!-- Show action buttons on hover -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                <Setter TargetName="ActionButtons" Property="Opacity" Value="1"/>
                            </DataTrigger>
                            <!-- Show action buttons when selected -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter TargetName="ActionButtons" Property="Opacity" Value="1"/>
                            </DataTrigger>
                            <!-- Truncation indicator -->
                            <DataTrigger Binding="{Binding IsTruncated}" Value="True">
                                <Setter TargetName="TruncWarning" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- Always show for pinned items -->
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="ActionButtons" Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ═══ Detail panel separator ═══ -->
            <Border x:Name="DetailSeparator"
                    Grid.Column="1"
                    Width="1"
                    Margin="12,0"
                    Background="{DynamicResource GlassBorder}"
                    VerticalAlignment="Stretch"/>

            <!-- ═══ Detail panel (inline mode) ═══ -->
            <Border x:Name="DetailPanel"
                    Grid.Column="2"
                    Width="240"
                    Margin="8,0,0,0"
                    Padding="12"
                    CornerRadius="{DynamicResource RadiusRow}"
                    Background="{DynamicResource SurfaceLow}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <!-- Metadata -->
                    <TextBlock Text="{Binding SelectedMetadata}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="{DynamicResource FontSm}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"/>

                    <!-- Content preview -->
                    <ScrollViewer MaxHeight="200"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding SelectedContent}"
                                   FontFamily="{DynamicResource Token.Font.Mono}"
                                   FontSize="{DynamicResource FontSm}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Padding="0,0,4,0"/>
                    </ScrollViewer>

                    <!-- Image preview (when image is selected) -->
                    <Image x:Name="DetailImage"
                           MaxHeight="160"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           Margin="0,8,0,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding SelectedEntry.Image}"
                           Visibility="{Binding IsImageSelected, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="DetailPinBtn"
                                Height="28"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="4,0"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Toggle pin">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DetailPinGlyph" Text="Pin to top" FontSize="{DynamicResource FontSm}" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>
                        </Button>
                        <Button Height="28"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="4,0"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Merge with above"
                                Click="OnMergeClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Merge (no separator)" 
                                              Command="{Binding MergeWithCommand}"
                                              CommandParameter="none"/>
                                    <MenuItem Header="Merge with space" 
                                              Command="{Binding MergeWithCommand}"
                                              CommandParameter="space"/>
                                    <MenuItem Header="Merge with newline" 
                                              Command="{Binding MergeWithCommand}"
                                              CommandParameter="newline"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/Icons/copy.png" Width="12" Height="12" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,6,0"/>
                                <TextBlock Text="Merge ▾" FontSize="{DynamicResource FontSm}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Keyboard hints -->
                    <StackPanel Margin="0,12,0,0" Opacity="0.7">
                        <TextBlock FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="{DynamicResource FontCaption}"
                                   Foreground="{DynamicResource TextMuted}">
                            <Run Text="Enter"/> <Run Text="Paste" Foreground="{DynamicResource TextTertiary}"/>
                        </TextBlock>
                        <TextBlock FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="{DynamicResource FontCaption}"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,0">
                            <Run Text="Del"/> <Run Text="Remove" Foreground="{DynamicResource TextTertiary}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Empty state ═══ -->
            <StackPanel Grid.ColumnSpan="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        x:Name="EmptyState"
                        AutomationProperties.LiveSetting="Polite">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Image Source="/Assets/Icons/clipboard.png" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5"/>
                <TextBlock Text="Clipboard is empty"
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="{DynamicResource FontHeading}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Copy something to get started"
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="{DynamicResource FontBody}"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
