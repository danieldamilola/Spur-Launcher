<UserControl x:Class="Spur.Views.ClipboardManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:models="clr-namespace:Spur.Models"
             Background="Transparent">

    <!--
        ClipboardManager — standalone clipboard history browser.
        Extracted from the launcher's main search flow.
        DataContext → ClipboardViewModel.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Actions bar ═══ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,10,12,8">
            <Button Style="{StaticResource SettingsSoftButton}"
                    Command="{Binding ClearAllCommand}"
                    AutomationProperties.Name="Clear all clipboard entries"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE74D;" FontSize="13" Margin="0,0,6,0"/>
                    <TextBlock Text="Clear all" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding StatusText}"
                       FontFamily="{DynamicResource Token.Font.Primary}"
                       FontSize="{DynamicResource FontXs}"
                       Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
        </StackPanel>

        <!-- ═══ Content area: list + detail panel ═══ -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Entry list ═══ -->
            <ListBox x:Name="ClipList"
                     Grid.Column="0"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     FocusVisualStyle="{x:Null}"
                     PreviewMouseLeftButtonUp="OnListMouseClick"
                     AutomationProperties.Name="Clipboard history">

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ClipboardEntry}">
                        <Grid x:Name="RowRoot"
                              Height="{DynamicResource RowHeightTall}"
                              Background="Transparent"
                              Cursor="Hand"
                              AutomationProperties.Name="{Binding Preview}">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Selection rail -->
                            <Border x:Name="SelectionRail"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    CornerRadius="2"
                                    Margin="0,8,0,8"/>

                            <!-- Row background -->
                            <Border x:Name="RowBg"
                                    Grid.Column="2"
                                    Background="Transparent"
                                    CornerRadius="{DynamicResource RadiusRow}"/>

                            <Border x:Name="HoverOverlay"
                                    Grid.Column="2"
                                    CornerRadius="{DynamicResource RadiusRow}"
                                    Background="{DynamicResource HoverBg}"
                                    Opacity="0"/>

                            <!-- Selected overlay -->
                            <Border x:Name="SelectedOverlay"
                                    Grid.Column="2"
                                    CornerRadius="{DynamicResource RadiusRow}"
                                    Background="{DynamicResource SelectedBg}"
                                    Opacity="0"/>

                            <Grid Grid.Column="2" Margin="12,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Image preview (only visible when IsImage) -->
                                <Border x:Name="ImgBox"
                                        Grid.Column="0"
                                        Width="32" Height="32"
                                        CornerRadius="8"
                                        Background="{DynamicResource SurfaceLow}"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <Image Width="30" Height="30"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding Image}"/>
                                </Border>

                                <!-- Text icon -->
                                <Border x:Name="TextIconBox"
                                        Grid.Column="0"
                                        Width="32" Height="32"
                                        CornerRadius="8"
                                        Background="{DynamicResource SurfaceLow}"
                                        VerticalAlignment="Center">
                                    <ui:FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Content -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Preview}"
                                               FontFamily="{DynamicResource Token.Font.Primary}"
                                               FontSize="{DynamicResource FontBase}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TimeAgo}"
                                               FontFamily="{DynamicResource Token.Font.Secondary}"
                                               FontSize="{DynamicResource FontSm}"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Pin + Delete buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Pin button -->
                                    <Button x:Name="PinBtn"
                                            Width="24" Height="24"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="2,0"
                                            ToolTip="Pin"
                                            Tag="{Binding}"
                                            AutomationProperties.Name="Pin entry"
                                            Click="OnPinClick">
                                        <ui:FontIcon x:Name="PinGlyph" Glyph="&#xE718;" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </Button>

                                    <!-- Delete button -->
                                    <Button Width="24" Height="24"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="2,0"
                                            ToolTip="Remove"
                                            AutomationProperties.Name="Delete entry"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <ui:FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <DataTemplate.Triggers>
                            <!-- Hover -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.08"
                                                             EasingFunction="{StaticResource AnimEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.08"
                                                             EasingFunction="{StaticResource AnimEaseIn}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <!-- Image entry -->
                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                <Setter TargetName="ImgBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TextIconBox" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>

                            <!-- Selection rail + selected overlay when selected -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                <Setter TargetName="SelectionRail" Property="Background" Value="{DynamicResource Accent}"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>

                            <!-- Pin visual indicator: swap glyph + color when pinned -->
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="PinGlyph" Property="Glyph" Value="&#xE841;"/>
                                <Setter TargetName="PinGlyph" Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="PinBtn" Property="ToolTip" Value="Unpin"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ═══ Detail panel separator ═══ -->
            <Border x:Name="DetailSeparator"
                    Grid.Column="1"
                    Width="1"
                    Margin="12,0"
                    Background="{DynamicResource GlassBorder}"
                    VerticalAlignment="Stretch"/>

            <!-- ═══ Detail panel (inline mode) ═══ -->
            <Border x:Name="DetailPanel"
                    Grid.Column="2"
                    Width="240"
                    Margin="8,0,0,0"
                    Padding="12"
                    CornerRadius="{DynamicResource RadiusRow}"
                    Background="{DynamicResource SurfaceLow}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Details"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="{DynamicResource FontBody}" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,8"/>
                    <Button x:Name="DetailPinBtn"
                            Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="4,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Toggle pin">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon x:Name="DetailPinGlyph" Glyph="&#xE718;" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0"/>
                            <TextBlock Text="Pin to top" FontSize="{DynamicResource FontSm}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ Empty state ═══ -->
            <StackPanel Grid.ColumnSpan="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        x:Name="EmptyState">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📋"
                           FontSize="{DynamicResource FontXxl}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Clipboard is empty"
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="{DynamicResource FontHeading}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Copy something to get started"
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="{DynamicResource FontBody}"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
