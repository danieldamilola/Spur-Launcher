<UserControl x:Class="Spur.Views.Controls.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Color preview swatch -->
        <Border x:Name="ColorPreview"
                Width="24" Height="24" CornerRadius="6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Margin="0,0,8,0" VerticalAlignment="Center"
                Cursor="Hand"
                MouseLeftButtonDown="OnPreviewClick">
            <Border.Background>
                <SolidColorBrush x:Name="PreviewBrush" Color="#0078D7"/>
            </Border.Background>
        </Border>

        <!-- Hex input TextBox -->
        <TextBox x:Name="HexTextBox"
                 Width="80" VerticalAlignment="Center"
                 Text="{Binding ColorHex, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Dropdown toggle button -->
        <Border Margin="4,0,0,0" VerticalAlignment="Center"
                Background="Transparent" Cursor="Hand"
                MouseLeftButtonDown="OnDropdownClick"
                ToolTip="Pick a preset color">
            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" Margin="2,0"/>
        </Border>

        <!-- Popup with preset swatches -->
        <Popup x:Name="SwatchPopup"
               PlacementTarget="{Binding ElementName=ColorPreview}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="-4" VerticalOffset="4">
            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="8" Margin="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Opacity="0.2" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Preset colors"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="2,0,0,6"/>
                    <UniformGrid x:Name="SwatchGrid" Columns="5"/>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
