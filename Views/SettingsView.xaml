<UserControl x:Class="Spur.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:conv="clr-namespace:Spur.Converters"
             xmlns:settings="clr-namespace:Spur.Views.Settings">

    <UserControl.Resources>
        <local:SectionVisibilityConverter x:Key="SectionVisibility"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceLow}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════ SIDEBAR ═══════ -->
        <Grid Grid.Column="0" Background="{DynamicResource Depth2}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="16,20,16,6">
                <TextBlock Text="Settings"
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Keep Spur quiet, fast, and tuned to how you work."
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource SettingsInputFrame}"
                    Margin="12,2,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <ui:FontIcon Grid.Column="0" 
                                   Glyph="&#xE11A;"
                                   Foreground="{DynamicResource TextTertiary}"
                                   FontSize="14"
                                   Margin="8,0,4,0" VerticalAlignment="Center"/>
                          
                    <TextBlock Grid.Column="1" Text="Search settings..."
                               Foreground="{DynamicResource TextTertiary}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <TextBox Grid.Column="1" x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{DynamicResource Token.Font.Primary}"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,6"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource Accent}"
                             AutomationProperties.Name="Search settings"/>
                </Grid>
            </Border>

            <!-- Nav -->
            <ListBox Grid.Row="2"
                     x:Name="NavList"
                     ItemsSource="{Binding FilteredSections}"
                     SelectedItem="{Binding SelectedSection}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Margin="0,4,0,0"
                     AutomationProperties.Name="Settings navigation">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="NavBg"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="0"
                                Margin="8,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Accent bar -->
                                <Border x:Name="AccentBar"
                                        Grid.Column="0"
                                        Width="3"
                                        Background="Transparent"
                                        CornerRadius="2"
                                        Margin="0,4"/>

                                <!-- Icon -->
                                <ui:FontIcon x:Name="NavIcon"
                                               Grid.Column="1"
                                               Glyph="{Binding IconGlyph}"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="11,0,10,0"/>

                                <!-- Label -->
                                <TextBlock x:Name="NavLabel"
                                           Grid.Column="2"
                                           Text="{Binding Name}"
                                           FontFamily="{DynamicResource Token.Font.Primary}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,10,12,10"/>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- Selected state -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                         Value="True">
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="NavLabel"  Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter TargetName="NavIcon"   Property="Foreground" Value="{DynamicResource Accent}"/>
                            </DataTrigger>

                            <!-- Unselected text color -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                         Value="False">
                                <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Setter TargetName="NavIcon"  Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </DataTrigger>

                            <!-- Hover (only when NOT selected) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="False"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Close button -->
            <Button Grid.Row="3"
                    Click="OnCloseClick"
                    Margin="12,12,12,16"
                    Padding="10,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    AutomationProperties.Name="Close settings">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBg" CornerRadius="6" Background="Transparent"
                                Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE711;"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                <TextBlock Text="Close"
                                           FontFamily="{DynamicResource Token.Font.Primary}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBg" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ═══════ SEPARATOR ═══════ -->
        <Border Grid.Column="1" Background="{DynamicResource Separator}"/>

        <!-- ═══════ CONTENT ═══════ -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,20,32,28">
                <settings:GeneralSettingsPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=General}"/>
                <settings:SearchSettingsPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Search}"/>
                <settings:ActionsSettingsPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Actions}"/>
                <settings:ExtrasSettingsPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Extras}"/>
                <settings:AboutSettingsPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=About}"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>


