<UserControl x:Class="Arc.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Arc.Views"
             xmlns:conv="clr-namespace:Arc.Converters">

    <UserControl.Resources>
        <local:SectionVisibilityConverter x:Key="SectionVisibility"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceLow}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════ SIDEBAR ═══════ -->
        <Grid Grid.Column="0" Background="{DynamicResource Depth2}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="16,20,16,6">
                <TextBlock Text="Settings"
                           FontFamily="{DynamicResource UIFont}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Keep Spur quiet, fast, and tuned to how you work."
                           FontFamily="{DynamicResource UIFont}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Search -->
            <Border Grid.Row="1" Style="{StaticResource SettingsInputFrame}"
                    Margin="12,2,12,12">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{DynamicResource UIFont}"
                         FontSize="12"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="8,6"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource Accent}"/>
            </Border>

            <!-- Nav -->
            <ListBox Grid.Row="2"
                     x:Name="NavList"
                     ItemsSource="{Binding FilteredSections}"
                     SelectedItem="{Binding SelectedSection}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Margin="0,4,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="NavBg"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="0"
                                Margin="8,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Accent bar -->
                                <Border x:Name="AccentBar"
                                        Grid.Column="0"
                                        Width="3"
                                        Background="Transparent"
                                        CornerRadius="2"
                                        Margin="0,4"/>

                                <!-- Icon -->
                                <Path x:Name="NavIcon"
                                      Grid.Column="1"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      StrokeThickness="1.5"
                                      Fill="Transparent"
                                      VerticalAlignment="Center"
                                      Margin="11,0,10,0">
                                    <Path.Data>
                                        <Binding Path="LucideIcon"
                                                 Converter="{x:Static conv:LucideIconConverter.Instance}"/>
                                    </Path.Data>
                                </Path>

                                <!-- Label -->
                                <TextBlock x:Name="NavLabel"
                                           Grid.Column="2"
                                           Text="{Binding Name}"
                                           FontFamily="{DynamicResource UIFont}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,10,12,10"/>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- Selected state -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                         Value="True">
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="NavLabel"  Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter TargetName="NavIcon"   Property="Stroke"     Value="{DynamicResource Accent}"/>
                            </DataTrigger>

                            <!-- Unselected text color -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                         Value="False">
                                <Setter TargetName="NavLabel" Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Setter TargetName="NavIcon"  Property="Stroke"     Value="{DynamicResource TextSecondary}"/>
                            </DataTrigger>

                            <!-- Hover (only when NOT selected) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="False"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="NavBg" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Close button -->
            <Button Grid.Row="3"
                    Click="OnCloseClick"
                    Margin="12,12,12,16"
                    Padding="10,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBg" CornerRadius="6" Background="Transparent"
                                Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{DynamicResource TextMuted}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0">
                                    <Path.Data>
                                        <Binding Source="{StaticResource Icon.Settings.Close}"
                                                 Converter="{x:Static conv:LucideIconConverter.Instance}"/>
                                    </Path.Data>
                                </Path>
                                <TextBlock Text="Close"
                                           FontFamily="{DynamicResource UIFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBg" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ═══════ SEPARATOR ═══════ -->
        <Border Grid.Column="1" Background="{DynamicResource Separator}"/>

        <!-- ═══════ CONTENT ═══════ -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,20,32,28">

<StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=General}">
                        <TextBlock Text="Look and feel" Style="{StaticResource SettingsKicker}"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SettingsIconBox}">
                                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" Fill="Transparent">
                                                <Path.Data>
                                                    <Binding Source="{StaticResource Icon.Settings.Appearance}" Converter="{x:Static conv:LucideIconConverter.Instance}"/>
                                                </Path.Data>
                                            </Path>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Theme" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Choose a quiet surface or follow Windows." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource SettingsPillGroup}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Dark" IsChecked="{Binding ThemeDark}" Style="{StaticResource SegmentedRadio}" GroupName="Theme"/>
                                                <RadioButton Content="Light" IsChecked="{Binding ThemeLight}" Style="{StaticResource SegmentedRadio}" GroupName="Theme"/>
                                                <RadioButton Content="System" IsChecked="{Binding ThemeSystem}" Style="{StaticResource SegmentedRadio}" GroupName="Theme"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Divider}"/>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SettingsIconBox}">
                                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" Fill="Transparent">
                                                <Path.Data>
                                                    <Binding Source="{StaticResource Icon.Settings.Theme}" Converter="{x:Static conv:LucideIconConverter.Instance}"/>
                                                </Path.Data>
                                            </Path>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Window opacity" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="A little glass, without making text hard to read." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <Slider Grid.Column="2" Minimum="0.5" Maximum="1.0"
                                                Value="{Binding WindowOpacity, Mode=TwoWay}"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Behavior" Style="{StaticResource SettingsKicker}"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SettingsIconBox}">
                                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" Fill="Transparent">
                                                <Path.Data>
                                                    <Binding Source="{StaticResource Icon.Settings.Hotkey}" Converter="{x:Static conv:LucideIconConverter.Instance}"/>
                                                </Path.Data>
                                            </Path>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Shortcut" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="{Binding Shortcut}" Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <local:ToggleSwitch IsOn="{Binding HotkeyEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button x:Name="EditShortcutBtn" Content="Edit" Click="OnEditShortcutClick" Style="{StaticResource SettingsSoftButton}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Divider}"/>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SettingsIconBox}">
                                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" Fill="Transparent">
                                                <Path.Data>
                                                    <Binding Source="{StaticResource Icon.Settings.Behavior}" Converter="{x:Static conv:LucideIconConverter.Instance}"/>
                                                </Path.Data>
                                            </Path>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Position" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Where Spur opens on screen." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource SettingsPillGroup}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Center" IsChecked="{Binding PositionCenter}" Style="{StaticResource SegmentedRadio}" GroupName="Position"/>
                                                <RadioButton Content="Top" IsChecked="{Binding PositionTop}" Style="{StaticResource SegmentedRadio}" GroupName="Position"/>
                                                <RadioButton Content="Left" IsChecked="{Binding PositionLeft}" Style="{StaticResource SegmentedRadio}" GroupName="Position"/>
                                                <RadioButton Content="Right" IsChecked="{Binding PositionRight}" Style="{StaticResource SegmentedRadio}" GroupName="Position"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Divider}"/>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SettingsIconBox}">
                                            <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" Fill="Transparent">
                                                <Path.Data>
                                                    <Binding Source="{StaticResource Icon.Settings.AI}" Converter="{x:Static conv:LucideIconConverter.Instance}"/>
                                                </Path.Data>
                                            </Path>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Polish" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Motion and sound feedback." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Motion" Style="{StaticResource SettingsHint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <local:ToggleSwitch IsOn="{Binding AnimationEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <TextBlock Text="Sound" Style="{StaticResource SettingsHint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <local:ToggleSwitch IsOn="{Binding SoundEffectEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Startup" Style="{StaticResource SettingsKicker}"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Launch with Windows" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Make Spur available as soon as you sign in." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <local:ToggleSwitch Grid.Column="1" IsOn="{Binding LaunchOnStartup, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Divider}"/>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Tray icon" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Keep Spur reachable without cluttering the taskbar." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <local:ToggleSwitch Grid.Column="1" IsOn="{Binding ShowTrayIcon, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Search}">
                        <TextBlock Text="What Spur can find" Style="{StaticResource SettingsKicker}"/>
                        <Border Style="{StaticResource Panel}">
                            <WrapPanel Margin="16,14,10,8">
                                <CheckBox Content="Apps" IsChecked="{Binding IndexApps, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Files" IsChecked="{Binding IndexFiles, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Folders" IsChecked="{Binding IndexFolders, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Clipboard" IsChecked="{Binding IndexClipboard, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Calculator" IsChecked="{Binding IndexCalculator, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Windows settings" IsChecked="{Binding IndexWindowsSettings, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="URLs" IsChecked="{Binding IndexUrls, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Web searches" IsChecked="{Binding IndexWebSearches, Mode=TwoWay}" Margin="0,0,18,8"/>
                            </WrapPanel>
                        </Border>

                        <TextBlock Text="Search feel" Style="{StaticResource SettingsKicker}"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Fuzzy matching" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Find things even when the spelling or order is not exact." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <local:ToggleSwitch Grid.Column="1" IsOn="{Binding FuzzySearch, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Divider}"/>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Result count" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Show enough choices without turning the launcher into a list view." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource SettingsPillGroup}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="5" IsChecked="{Binding Results5}" Style="{StaticResource SegmentedRadio}" GroupName="Results"/>
                                                <RadioButton Content="8" IsChecked="{Binding Results8}" Style="{StaticResource SegmentedRadio}" GroupName="Results"/>
                                                <RadioButton Content="10" IsChecked="{Binding Results10}" Style="{StaticResource SegmentedRadio}" GroupName="Results"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Divider}"/>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Precision" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Use strict matching if you prefer predictable, literal results." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding QuerySearchPrecisionOptions}"
                                                  SelectedItem="{Binding QuerySearchPrecision, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Folders" Style="{StaticResource SettingsKicker}"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel Margin="16,14">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SettingsInputFrame}">
                                        <TextBox Text="{Binding NewFolderPath, UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
                                    </Border>
                                    <Button Grid.Column="2" Content="Browse" Click="OnBrowseFolderClick" Style="{StaticResource SettingsSoftButton}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding IndexedFoldersList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" Style="{StaticResource SettingsHint}" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1"
                                                        Content="Remove"
                                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SettingsSoftButton}"
                                                        Height="24"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Actions}">
                        <TextBlock Text="Commands" Style="{StaticResource SettingsKicker}"/>
                        <Border Style="{StaticResource Panel}">
                            <WrapPanel Margin="16,14,10,8">
                                <CheckBox Content="Calculator" IsChecked="{Binding ActionCalc, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Color tools" IsChecked="{Binding ActionColor, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Currency" IsChecked="{Binding ActionCurrency, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Password generator" IsChecked="{Binding ActionPasswordGen, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Quick note" IsChecked="{Binding ActionQuickNote, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="IP tools" IsChecked="{Binding ActionIp, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Kill process" IsChecked="{Binding ActionKillProcess, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="Screenshot" IsChecked="{Binding ActionScreenshot, Mode=TwoWay}" Margin="0,0,18,8"/>
                                <CheckBox Content="System commands" IsChecked="{Binding ActionSystem, Mode=TwoWay}" Margin="0,0,18,8"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Extras}">
                        <TextBlock Text="Optional tools" Style="{StaticResource SettingsKicker}"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="AI assistant" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Enable only if you want AI commands inside Spur." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <local:ToggleSwitch Grid.Column="1" IsOn="{Binding ActionAi, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Divider}"/>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Timer" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Small countdown commands from the launcher." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <local:ToggleSwitch Grid.Column="1" IsOn="{Binding ActionTimer, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="AI provider" Style="{StaticResource SettingsKicker}"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Provider and model" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Stored locally. Spur only uses this when AI is enabled." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding AiProvider, Mode=TwoWay}" Width="120"/>
                                            <ComboBox ItemsSource="{Binding CurrentModels}" SelectedItem="{Binding AiModel, Mode=TwoWay}" Width="180" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Divider}"/>
                                <Border Style="{StaticResource SettingsRow}">
                                    <StackPanel>
                                        <TextBlock Text="API key" Style="{StaticResource SettingsTitle}"/>
                                        <TextBlock Text="Protected with Windows user encryption." Style="{StaticResource SettingsHint}"/>
                                        <Border Style="{StaticResource SettingsInputFrame}" Margin="0,10,0,0">
                                            <PasswordBox x:Name="AiApiKeyBox"
                                                         PasswordChanged="OnAiApiKeyChanged"
                                                         FontFamily="{DynamicResource UIFont}"
                                                         FontSize="12"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         VerticalContentAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=About}">
                        <TextBlock Text="Maintenance" Style="{StaticResource SettingsKicker}"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="App catalog" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Refresh if a newly installed app does not show up." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshAppsCommand}" Style="{StaticResource SettingsSoftButton}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Divider}"/>
                                <Border Style="{StaticResource SettingsRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Reset settings" Style="{StaticResource SettingsTitle}"/>
                                            <TextBlock Text="Restore Spur to a fresh, simple default state." Style="{StaticResource SettingsHint}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Reset" Command="{Binding ResetToDefaultsCommand}" Style="{StaticResource SettingsSoftButton}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="About" Style="{StaticResource SettingsKicker}"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel Margin="16,14">
                                <TextBlock Text="{Binding Version}" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="{Binding Credits}" Style="{StaticResource SettingsHint}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding License}" Style="{StaticResource SettingsHint}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>