<UserControl x:Class="Spur.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:settings="clr-namespace:Spur.Views.Settings"
             xmlns:res="clr-namespace:Spur.Resources">

  <ui:NavigationView x:Name="NavView"
                     PaneDisplayMode="Left"
                     OpenPaneLength="210"
                     IsPaneToggleButtonVisible="False"
                     IsBackButtonVisible="Collapsed"
                     IsSettingsVisible="False"
                     IsBackEnabled="False"
                     AlwaysShowHeader="False"
                     SelectionChanged="NavView_SelectionChanged"
                     Background="{DynamicResource Depth2}"
                     Foreground="{DynamicResource TextPrimary}">

    <!-- Logo + app name at top of pane -->
    <ui:NavigationView.PaneCustomContent>
      <StackPanel Margin="0,28,0,16" HorizontalAlignment="Center">
        <Image Source="pack://application:,,,/Icons/spur-64x64.ico"
               Width="52" Height="52"
               HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Spur"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="14" FontWeight="Medium"
                   Foreground="{DynamicResource TextPrimary}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,0"/>
        <TextBlock Text="{x:Static res:Strings.SettingsTitle}"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="11"
                   Foreground="{DynamicResource TextTertiary}"
                   HorizontalAlignment="Center"
                   Margin="0,1,0,0"/>
      </StackPanel>
    </ui:NavigationView.PaneCustomContent>

    <!-- Navigation items -->
    <ui:NavigationView.MenuItems>
      <ui:NavigationViewItem x:Name="NavGeneral" Content="General">
        <ui:NavigationViewItem.Icon>
          <ui:BitmapIcon ShowAsMonochrome="False" UriSource="pack://application:,,,/Assets/Icons/general.png"/>
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>
      <ui:NavigationViewItem x:Name="NavSearch" Content="Search">
        <ui:NavigationViewItem.Icon>
          <ui:BitmapIcon ShowAsMonochrome="False" UriSource="pack://application:,,,/Assets/Icons/searchnav.png"/>
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>
      <ui:NavigationViewItem x:Name="NavHotkeys" Content="Hotkeys">
        <ui:NavigationViewItem.Icon>
          <ui:BitmapIcon ShowAsMonochrome="False" UriSource="pack://application:,,,/Assets/Icons/shortcut.png"/>
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>
      <ui:NavigationViewItem x:Name="NavAi" Content="AI">
        <ui:NavigationViewItem.Icon>
          <ui:BitmapIcon ShowAsMonochrome="False" UriSource="pack://application:,,,/Assets/Icons/ainav.png"/>
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>
      <ui:NavigationViewItem x:Name="NavAddOns" Content="Add-ons">
        <ui:NavigationViewItem.Icon>
          <ui:BitmapIcon ShowAsMonochrome="False" UriSource="pack://application:,,,/Assets/Icons/addonsnav.png"/>
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>
      <ui:NavigationViewItem x:Name="NavStore" Content="Store">
        <ui:NavigationViewItem.Icon>
          <ui:BitmapIcon ShowAsMonochrome="False" UriSource="pack://application:,,,/Assets/Icons/storenav.png"/>
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>
      <ui:NavigationViewItem x:Name="NavAbout" Content="About">
        <ui:NavigationViewItem.Icon>
          <ui:BitmapIcon ShowAsMonochrome="False" UriSource="pack://application:,,,/Assets/Icons/aboutnav.png"/>
        </ui:NavigationViewItem.Icon>
      </ui:NavigationViewItem>
    </ui:NavigationView.MenuItems>

    <!-- Content area -->
    <ScrollViewer Background="{DynamicResource Depth1}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="ContentPanel" Margin="36,28,36,32"/>
    </ScrollViewer>
  </ui:NavigationView>
</UserControl>
