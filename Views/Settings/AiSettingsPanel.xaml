<UserControl x:Class="Spur.Views.Settings.AiSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel>
        <!-- Page heading -->
        <TextBlock Text="AI"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- ── PROVIDER ── -->
        <TextBlock Text="PROVIDER"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <!-- AI Provider -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/provider.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="AI Provider" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Choose which AI service to use." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding Providers}" SelectedItem="{Binding AiProvider, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Model -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/model.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Model" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Select a model or type any custom model name." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding CurrentModels}" Text="{Binding AiModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEditable="True" IsTextSearchEnabled="True" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── API KEY ── -->
        <TextBlock Text="API KEY"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
            <Grid MinHeight="56" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                    <Image Source="/Assets/Icons/apikey.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="API Key" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Protected with Windows DPAPI encryption. Never leaves your machine." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="3" Background="{DynamicResource SelectedBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" VerticalAlignment="Center">
                    <PasswordBox x:Name="AiApiKeyBox"
                                 PasswordChanged="OnAiApiKeyChanged"
                                 FontFamily="{DynamicResource Token.Font.Primary}"
                                 FontSize="12"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Padding="10,6"
                                 VerticalContentAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ── BEHAVIOR ── -->
        <TextBlock Text="BEHAVIOR"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid MinHeight="56" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                    <Image Source="/Assets/Icons/maxlength.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Enable AI" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Show AI results when searching." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
                <local:ToggleSwitch Grid.Column="3" IsOn="{Binding AiEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
