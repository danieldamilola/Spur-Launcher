<UserControl x:Class="Spur.Views.Settings.GeneralSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:conv="clr-namespace:Spur.Converters"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel>
        <!-- Page heading -->
        <TextBlock Text="General"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- ── Look & Feel ── -->
        <TextBlock Text="LOOK AND FEEL"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="#1C1C1F" CornerRadius="10" BorderBrush="#1AFFFFFF" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <!-- Theme -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="#2C2C30" VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Theme" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Choose a quiet surface or follow Windows." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="3" Background="#252529" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Dark"   IsChecked="{Binding ThemeDark}"   Style="{StaticResource SegmentedRadio}" GroupName="Theme" AutomationProperties.Name="Dark theme"/>
                            <RadioButton Content="Light"  IsChecked="{Binding ThemeLight}"  Style="{StaticResource SegmentedRadio}" GroupName="Theme" AutomationProperties.Name="Light theme"/>
                            <RadioButton Content="System" IsChecked="{Binding ThemeSystem}" Style="{StaticResource SegmentedRadio}" GroupName="Theme" AutomationProperties.Name="System theme"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Height="1" Background="#12FFFFFF" Margin="0"/>

                <!-- Window opacity -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="#2C2C30" VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE294;" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Window opacity" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="A little glass, without making text hard to read." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Slider Grid.Column="3" Minimum="0.5" Maximum="1.0" Value="{Binding WindowOpacity, Mode=TwoWay}" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Window opacity"/>
                </Grid>

                <Border Height="1" Background="#12FFFFFF" Margin="0"/>

                <!-- Bar width -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="#2C2C30" VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE89F;" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Bar width" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Adjust the width of the search bar." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Slider Grid.Column="3" Minimum="400" Maximum="1000" Value="{Binding BarWidth, Mode=TwoWay}" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Bar width"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Behavior ── -->
        <TextBlock Text="BEHAVIOR"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium" 
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="#1C1C1F" CornerRadius="10" BorderBrush="#1AFFFFFF" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <!-- Shortcut -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="#2C2C30" VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE765;" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Shortcut" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding Shortcut}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                        <ui:ToggleSwitch IsOn="{Binding HotkeyEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="Enable hotkey"/>
                        <Button x:Name="EditShortcutBtn" Content="Edit" Click="OnEditShortcutClick" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit shortcut"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="#12FFFFFF" Margin="0"/>

                <!-- Position -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="#2C2C30" VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE707;" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Position" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Where Spur opens on screen." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="3" Background="#252529" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Center" IsChecked="{Binding PositionCenter}" Style="{StaticResource SegmentedRadio}" GroupName="Position" AutomationProperties.Name="Center position"/>
                            <RadioButton Content="Top"    IsChecked="{Binding PositionTop}"    Style="{StaticResource SegmentedRadio}" GroupName="Position" AutomationProperties.Name="Top position"/>
                            <RadioButton Content="Left"   IsChecked="{Binding PositionLeft}"   Style="{StaticResource SegmentedRadio}" GroupName="Position" AutomationProperties.Name="Left position"/>
                            <RadioButton Content="Right"  IsChecked="{Binding PositionRight}"  Style="{StaticResource SegmentedRadio}" GroupName="Position" AutomationProperties.Name="Right position"/>
                            <RadioButton Content="Custom" IsChecked="{Binding PositionCustom}" Style="{StaticResource SegmentedRadio}" GroupName="Position" AutomationProperties.Name="Custom position"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Height="1" Background="#12FFFFFF" Margin="0"/>

                <!-- Polish -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="#2C2C30" VerticalAlignment="Center">
                        <ui:FontIcon Glyph="&#xE945;" FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Polish" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Motion and sound feedback." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="Motion" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <local:ToggleSwitch IsOn="{Binding AnimationEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="Sound" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <local:ToggleSwitch IsOn="{Binding SoundEffectEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ── Startup ── -->
        <TextBlock Text="STARTUP"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium" 
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="#1C1C1F" CornerRadius="10" BorderBrush="#1AFFFFFF" BorderThickness="1">
            <StackPanel>
                <!-- Launch with Windows -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Launch with Windows" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Make Spur available as soon as you sign in." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding LaunchOnStartup, Mode=TwoWay}" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                </Grid>

                <Border Height="1" Background="#12FFFFFF" Margin="0"/>

                <!-- Tray icon -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tray icon" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Keep Spur reachable without cluttering the taskbar." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding ShowTrayIcon, Mode=TwoWay}" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
