<UserControl x:Class="Spur.Views.Settings.GeneralSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:conv="clr-namespace:Spur.Converters"
             xmlns:controls="clr-namespace:Spur.Views.Controls"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel>
        <!-- Page heading -->
        <TextBlock Text="General"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="{DynamicResource FontXl}" FontWeight="Medium"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- ── Appearance ── -->
        <TextBlock Text="APPEARANCE"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <!-- Theme -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/theme.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Theme" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Choose a quiet surface or follow Windows." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="3" Background="{DynamicResource SelectedBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Dark"   IsChecked="{Binding ThemeDark}"   Style="{StaticResource SegmentedRadio}" GroupName="Theme"/>
                            <RadioButton Content="Light"  IsChecked="{Binding ThemeLight}"  Style="{StaticResource SegmentedRadio}" GroupName="Theme"/>
                            <RadioButton Content="System" IsChecked="{Binding ThemeSystem}" Style="{StaticResource SegmentedRadio}" GroupName="Theme"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Accent Color Mode -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/accent.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Accent color" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Change the active color." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="3" Background="{DynamicResource SelectedBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Theme"  IsChecked="{Binding AccentModeTheme}"  Style="{StaticResource SegmentedRadio}" GroupName="Accent"/>
                            <RadioButton Content="System" IsChecked="{Binding AccentModeSystem}" Style="{StaticResource SegmentedRadio}" GroupName="Accent"/>
                            <RadioButton Content="Custom" IsChecked="{Binding AccentModeCustom}" Style="{StaticResource SegmentedRadio}" GroupName="Accent"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0" Visibility="{Binding AccentModeCustom, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Custom Accent Hex -->
                <Grid MinHeight="56" Margin="18,0" Visibility="{Binding AccentModeCustom, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/accent.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Custom hex color" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="e.g. #D7CFC2 or #0078D7" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <controls:ColorPickerControl Grid.Column="3" ColorHex="{Binding CustomAccentColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Window opacity -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/opacity.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Window opacity" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="A little glass, without making text hard to read." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Slider Grid.Column="3" Minimum="0.5" Maximum="1.0" Value="{Binding WindowOpacity, Mode=TwoWay}" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Window opacity"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Bar width -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/barwidth.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Bar width" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Adjust the width of the search bar." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Slider Grid.Column="3" Minimum="400" Maximum="1000" Value="{Binding BarWidth, Mode=TwoWay}" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Bar width"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- View Mode -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/viewmode.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="View mode" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Adjust the density of search results." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="3" Background="{DynamicResource SelectedBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Compact"     IsChecked="{Binding ViewModeCompact}"     Style="{StaticResource SegmentedRadio}" GroupName="ViewMode"/>
                            <RadioButton Content="Comfortable" IsChecked="{Binding ViewModeComfortable}" Style="{StaticResource SegmentedRadio}" GroupName="ViewMode"/>
                            <RadioButton Content="Spacious"    IsChecked="{Binding ViewModeSpacious}"    Style="{StaticResource SegmentedRadio}" GroupName="ViewMode"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Window Mode -->
                <Border Height="1" Background="{DynamicResource Separator}" Margin="18,0"/>
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/windowmode.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Window mode" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Compact shows only the search bar until you type." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="3" Background="{DynamicResource SelectedBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Compact"  IsChecked="{Binding WindowModeCompact}"  Style="{StaticResource SegmentedRadio}" GroupName="WindowMode"/>
                            <RadioButton Content="Expanded" IsChecked="{Binding WindowModeExpanded}" Style="{StaticResource SegmentedRadio}" GroupName="WindowMode"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Behavior ── -->
        <TextBlock Text="BEHAVIOR"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium" 
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <!-- Shortcut -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/shortcut.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Shortcut" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding Shortcut}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                        <local:ToggleSwitch IsOn="{Binding HotkeyEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Enable hotkey"/>
                        <Button x:Name="EditShortcutBtn" Click="OnEditShortcutClick" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit shortcut" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE70F;" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Edit" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Clipboard Shortcut -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/clipboard.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Clipboard Shortcut" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding ClipboardShortcut}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                        <Button x:Name="EditClipboardShortcutBtn" Click="OnEditClipboardShortcutClick" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit clipboard shortcut" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE70F;" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Edit" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Position -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/position.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Position" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Where Spur opens on screen." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="3" Background="{DynamicResource SelectedBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Center" IsChecked="{Binding PositionCenter}" Style="{StaticResource SegmentedRadio}" GroupName="Position" AutomationProperties.Name="Center position"/>
                            <RadioButton Content="Top"    IsChecked="{Binding PositionTop}"    Style="{StaticResource SegmentedRadio}" GroupName="Position" AutomationProperties.Name="Top position"/>
                            <RadioButton Content="Left"   IsChecked="{Binding PositionLeft}"   Style="{StaticResource SegmentedRadio}" GroupName="Position" AutomationProperties.Name="Left position"/>
                            <RadioButton Content="Right"  IsChecked="{Binding PositionRight}"  Style="{StaticResource SegmentedRadio}" GroupName="Position" AutomationProperties.Name="Right position"/>
                            <RadioButton Content="Custom" IsChecked="{Binding PositionCustom}" Style="{StaticResource SegmentedRadio}" GroupName="Position" AutomationProperties.Name="Custom position"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Preferred monitor -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/monitor.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Preferred monitor" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Which display to open the launcher on." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding MonitorOptions}"
                              SelectedItem="{Binding PreferredMonitor, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Polish -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/info.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Polish" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Motion and sound feedback." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="Motion" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <local:ToggleSwitch IsOn="{Binding AnimationEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="Sound" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <local:ToggleSwitch IsOn="{Binding SoundEffectEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ── Startup ── -->
        <TextBlock Text="STARTUP"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium" 
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <!-- Launch with Windows -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/startup.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Launch with Windows" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Make Spur available as soon as you sign in." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <local:ToggleSwitch Grid.Column="3" IsOn="{Binding LaunchOnStartup, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Tray icon -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/tray.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Tray icon" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Keep Spur reachable without cluttering the taskbar." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <local:ToggleSwitch Grid.Column="3" IsOn="{Binding ShowTrayIcon, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Text="PINNED CATEGORIES"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium" 
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,16,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel>

                <!-- Slot 1 -->
                <Grid MinHeight="52" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <TextBlock Text="1" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="Slot 1" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableCategories}" DisplayMemberPath="Name"
                              SelectedItem="{Binding PinnedCategory1, Mode=TwoWay}"
                              Width="140" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Slot 2 -->
                <Grid MinHeight="52" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <TextBlock Text="2" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="Slot 2" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableCategories}" DisplayMemberPath="Name"
                              SelectedItem="{Binding PinnedCategory2, Mode=TwoWay}"
                              Width="140" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Slot 3 -->
                <Grid MinHeight="52" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <TextBlock Text="3" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="Slot 3" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableCategories}" DisplayMemberPath="Name"
                              SelectedItem="{Binding PinnedCategory3, Mode=TwoWay}"
                              Width="140" VerticalAlignment="Center"/>
                </Grid>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
