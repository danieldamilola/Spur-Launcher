<UserControl x:Class="Spur.Views.Settings.HotkeySettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel>
        <TextBlock Text="Hotkeys"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="{DynamicResource FontXl}" FontWeight="Medium"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- ── Launcher ── -->
        <TextBlock Text="LAUNCHER"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <!-- Toggle launcher -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/shortcut.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Toggle launcher" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding Shortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="3" IsOn="{Binding HotkeyEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="Enable launcher hotkey"/>
                    <Button Grid.Column="4" x:Name="EditShortcutBtn" Click="OnEditShortcutClick" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit launcher shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}"/>

                <!-- Toggle clipboard -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/clipboard.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Toggle clipboard" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding ClipboardShortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="EditClipShortcutBtn" Click="OnEditClipboardShortcutClick" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit clipboard shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Navigation ── -->
        <TextBlock Text="NAVIGATION"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <!-- Category: Files -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/folder.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Category: Files" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding CategoryFilesShortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="EditCatFilesBtn" Click="OnGenericEdit" Tag="CategoryFilesShortcut" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit files shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}"/>

                <!-- Category: AI -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/ai.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Category: AI" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding CategoryAiShortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="EditCatAiBtn" Click="OnGenericEdit" Tag="CategoryAiShortcut" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit AI shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}"/>

                <!-- Category: Clipboard -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/clipboard.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Category: Clipboard" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding CategoryClipboardShortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="EditCatClipBtn" Click="OnGenericEdit" Tag="CategoryClipboardShortcut" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit clipboard category shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Actions ── -->
        <TextBlock Text="ACTIONS"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <!-- Toggle preview -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/preview.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Toggle preview" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding PreviewToggleShortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="EditPreviewBtn" Click="OnGenericEdit" Tag="PreviewToggleShortcut" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit preview shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}"/>

                <!-- Toggle pin -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/copy.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Toggle pin" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding TogglePinShortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="EditPinBtn" Click="OnGenericEdit" Tag="TogglePinShortcut" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit pin shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}"/>

                <!-- Command palette -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/keyboard.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Command palette" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding CommandPaletteShortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="EditPaletteBtn" Click="OnGenericEdit" Tag="CommandPaletteShortcut" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit command palette shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}"/>

                <!-- Copy path -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/copy.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Copy path" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding CopyPathShortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="EditCopyBtn" Click="OnGenericEdit" Tag="CopyPathShortcut" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit copy path shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}"/>

                <!-- Open file location -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/folder.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Open file location" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding OpenFolderLocationShortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="EditFolderBtn" Click="OnGenericEdit" Tag="OpenFolderLocationShortcut" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit open folder shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}"/>

                <!-- Run as admin -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/account.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Run as administrator" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding RunAsAdminShortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="EditAdminBtn" Click="OnGenericEdit" Tag="RunAsAdminShortcut" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit admin shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}"/>

                <!-- Open settings -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/settings.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Open settings" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{Binding OpenSettingsShortcut}" FontFamily="{DynamicResource Token.Font.Mono}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" x:Name="EditSettingsBtn" Click="OnGenericEdit" Tag="OpenSettingsShortcut" Style="{StaticResource SettingsSoftButton}" AutomationProperties.Name="Edit settings shortcut" Padding="12,6">
                        <TextBlock Text="Edit" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
