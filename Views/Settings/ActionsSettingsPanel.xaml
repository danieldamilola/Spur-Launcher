<UserControl x:Class="Spur.Views.Settings.ActionsSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:conv="clr-namespace:Spur.Converters"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">

    <!--
        Per-action settings cards. Each card has a toggle, keyword textbox,
        and action-specific options (password length, kill-process visibility, etc.).
        Bound to SettingsViewModel's per-action properties.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ═══════ Built-in Commands ═══════ -->
            <TextBlock Text="Commands" Style="{StaticResource SettingsKicker}"/>
            <Border Style="{StaticResource Panel}">
                <StackPanel>

                    <!-- ── System ── -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="System commands" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Shutdown, restart, sleep, lock, sign out." Style="{StaticResource SettingsHint}"/>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding SystemKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding SystemEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Divider}"/>

                    <!-- ── Color ── -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Color tools" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Hex, RGB, HSL color conversion and preview." Style="{StaticResource SettingsHint}"/>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ColorKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding ColorEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Divider}"/>

                    <!-- ── Currency ── -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Currency converter" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Real-time exchange rate conversion." Style="{StaticResource SettingsHint}"/>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding CurrencyKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding CurrencyEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Divider}"/>

                    <!-- ── AI assistant ── -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AI assistant" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Ask the configured AI provider from the launcher." Style="{StaticResource SettingsHint}"/>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding AiKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding AiEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Divider}"/>

                    <!-- ── Shell ── -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Shell commands" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Run system commands from Spur." Style="{StaticResource SettingsHint}"/>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ShellKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox Content="Close after execution" IsChecked="{Binding ShellCloseAfterExecution, Mode=TwoWay}"
                                              FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Run as administrator" IsChecked="{Binding ShellAlwaysRunAsAdministrator, Mode=TwoWay}"
                                              FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0"/>
                                    <CheckBox Content="Use Windows Terminal" IsChecked="{Binding ShellUseWindowsTerminal, Mode=TwoWay}"
                                              FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Terminal" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox ItemsSource="{Binding ShellTerminalOptions}"
                                              SelectedItem="{Binding ShellTerminal}"
                                              FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                              Width="120"/>
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding ShellEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══════ Optional tools ═══════ -->
            <TextBlock Text="Optional tools" Style="{StaticResource SettingsKicker}"/>
            <Border Style="{StaticResource Panel}">
                <StackPanel>

                    <!-- ── Timer ── -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Timer" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Countdown directly from the launcher." Style="{StaticResource SettingsHint}"/>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding TimerKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,6,0,0" MaxWidth="300">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Presets" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding TimerPresets, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding TimerEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Divider}"/>

                    <!-- ── Kill Process ── -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kill process" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Find and terminate running processes by name." Style="{StaticResource SettingsHint}"/>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding KillProcessKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="0,8,0,0">
                                    <CheckBox Content="Show window titles" IsChecked="{Binding KillProcessShowWindowTitles, Mode=TwoWay}"
                                              FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                              Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                    <CheckBox Content="Prioritize processes with visible windows" IsChecked="{Binding KillProcessPrioritizeVisibleWindows, Mode=TwoWay}"
                                              FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                              Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding KillProcessEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Divider}"/>

                    <!-- ── Password Generator ── -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Password generator" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Generate strong random passwords." Style="{StaticResource SettingsHint}"/>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding PasswordGenKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="0,8,0,0">
                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock Text="Length" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Border Style="{StaticResource SettingsInputFrame}" Width="60">
                                            <TextBox Text="{Binding PasswordGenLength, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                     Background="Transparent" BorderThickness="0"
                                                     VerticalContentAlignment="Center" Padding="4,2"/>
                                        </Border>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <CheckBox Content="Symbols" IsChecked="{Binding PasswordGenSymbols, Mode=TwoWay}"
                                                  FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0"/>
                                        <CheckBox Content="Numbers" IsChecked="{Binding PasswordGenNumbers, Mode=TwoWay}"
                                                  FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,12,0"/>
                                        <CheckBox Content="Uppercase" IsChecked="{Binding PasswordGenUppercase, Mode=TwoWay}"
                                                  FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding PasswordGenEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Divider}"/>

                    <!-- ── Quick Note ── -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Quick note" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Jot down a note and save it instantly." Style="{StaticResource SettingsHint}"/>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding QuickNoteKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,6,0,0" MaxWidth="360">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Folder" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding QuickNoteSaveFolder, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding QuickNoteEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Divider}"/>

                    <!-- ── Screenshot ── -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Screenshot" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Capture and save screenshots." Style="{StaticResource SettingsHint}"/>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ScreenshotKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Format" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox ItemsSource="{Binding ScreenshotFormatOptions}"
                                              SelectedItem="{Binding ScreenshotFormat}"
                                              FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                              Width="80"/>
                                </StackPanel>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="360">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Folder" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding ScreenshotSaveFolder, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding ScreenshotEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Divider}"/>

                    <!-- ── IP tools ── -->
                    <Border Style="{StaticResource SettingsRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="IP tools" Style="{StaticResource SettingsTitle}"/>
                                <TextBlock Text="Show local and public IP addresses." Style="{StaticResource SettingsHint}"/>
                                <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center" Margin="4,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding IpKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalContentAlignment="Center" Padding="2,4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding IpEnabled, Mode=TwoWay}"
                                             VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
