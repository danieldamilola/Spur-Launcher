<UserControl x:Class="Spur.Views.Settings.ExtrasStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
            <TextBlock Text="Extras Store" Style="{StaticResource SettingsKicker}"/>
            <TextBlock Text="Discover and install community extras." Style="{StaticResource SettingsHint}" Margin="0,0,0,16"/>
        </StackPanel>

        <!-- Loading State -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <ui:ProgressRing IsActive="True" Width="32" Height="32" Margin="0,0,0,16"/>
            <TextBlock Text="Fetching community extras..." Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <!-- Empty / Error State -->
        <StackPanel x:Name="ErrorPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <ui:FontIcon Glyph="&#xe7ba;" FontSize="32" Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,16"/>
            <TextBlock x:Name="ErrorText" Text="Failed to load extras manifest." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center"/>
            <Button Content="Retry" Margin="0,16,0,0" Click="OnRetryClicked"/>
        </StackPanel>

        <!-- Data Grid -->
        <ScrollViewer x:Name="DataPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="StoreItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel}" Margin="6">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceHigh}" Margin="0,0,12,0">
                                        <TextBlock Text="🧩" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SettingsTitle}"/>
                                        <TextBlock Text="{Binding Author, StringFormat='By {0}'}" FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource SettingsHint}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="Install" Style="{DynamicResource AccentButtonStyle}" Click="OnInstallClicked"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
