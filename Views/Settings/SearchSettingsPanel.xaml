<UserControl x:Class="Spur.Views.Settings.SearchSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:conv="clr-namespace:Spur.Converters"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel>
        <!-- Page heading -->
        <TextBlock Text="Search"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- ── What Spur can find ── -->
        <TextBlock Text="WHAT SPUR CAN FIND"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium" 
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
            <WrapPanel Margin="16,14,10,8">
                <CheckBox Content="Apps"             IsChecked="{Binding IndexApps,            Mode=TwoWay}" Margin="0,0,18,8"/>
                <CheckBox Content="Files"            IsChecked="{Binding IndexFiles,           Mode=TwoWay}" Margin="0,0,18,8"/>
                <CheckBox Content="Folders"          IsChecked="{Binding IndexFolders,         Mode=TwoWay}" Margin="0,0,18,8"/>
                <CheckBox Content="Clipboard"        IsChecked="{Binding IndexClipboard,       Mode=TwoWay}" Margin="0,0,18,8"/>
                <CheckBox Content="Calculator"       IsChecked="{Binding IndexCalculator,      Mode=TwoWay}" Margin="0,0,18,8"/>
                <CheckBox Content="Windows settings" IsChecked="{Binding IndexWindowsSettings, Mode=TwoWay}" Margin="0,0,18,8"/>
                <CheckBox Content="URLs"             IsChecked="{Binding IndexUrls,            Mode=TwoWay}" Margin="0,0,18,8"/>
                <CheckBox Content="Web searches"     IsChecked="{Binding IndexWebSearches,     Mode=TwoWay}" Margin="0,0,18,8"/>
            </WrapPanel>
        </Border>

        <!-- ── Search feel ── -->
        <TextBlock Text="SEARCH FEEL"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium" 
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <!-- Fuzzy matching -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/searchengine.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Fuzzy matching" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Find things even when the spelling or order is not exact." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <local:ToggleSwitch Grid.Column="3" IsOn="{Binding FuzzySearch, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- File preview -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/preview.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Show file preview" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Preview text and images when a file result is selected." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <local:ToggleSwitch Grid.Column="3" IsOn="{Binding FilePreviewEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Result count -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/maxresults.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Result count" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Show enough choices without turning the launcher into a list view." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="3" Background="{DynamicResource SelectedBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="5"  IsChecked="{Binding Results5}"  Style="{StaticResource SegmentedRadio}" GroupName="Results"/>
                            <RadioButton Content="8"  IsChecked="{Binding Results8}"  Style="{StaticResource SegmentedRadio}" GroupName="Results"/>
                            <RadioButton Content="10" IsChecked="{Binding Results10}" Style="{StaticResource SegmentedRadio}" GroupName="Results"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Query Search Precision -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/debounce.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Query search precision" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Changes minimum match score required for results." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding QuerySearchPrecisionOptions}" SelectedItem="{Binding QuerySearchPrecision, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Last Query Style -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/history.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Last query style" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Show or hide previous results when launcher is reactivated." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding LastQueryStyleOptions}" SelectedItem="{Binding LastQueryStyle, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Search delay -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/debounce.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Search delay" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Lower values feel snappier but use more CPU." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Slider Width="110" Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True"
                                Value="{Binding SearchDelay, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SearchDelay, StringFormat='{}{0}ms'}"
                                   FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Width="40" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0"/>

                <!-- Web search engine -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceRaised}" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/web.png" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Web search engine" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Used for 'Search the web' results." FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding WebSearchEngineOptions}" SelectedItem="{Binding WebSearchEngine, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Indexed Folders ── -->
        <TextBlock Text="INDEXED FOLDERS"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium" 
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Margin="16,14">
                <!-- Add folder row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource SelectedBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Height="32" Padding="10,0">
                        <TextBox Text="{Binding NewFolderPath, UpdateSourceTrigger=PropertyChanged}" FontSize="12" VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2" Click="OnBrowseFolderClick" Style="{StaticResource SettingsSoftButton}" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE8E5;" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Browse" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Folder list -->
                <ItemsControl ItemsSource="{Binding IndexedFoldersList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Remove"
                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SettingsSoftButton}"
                                        Height="24"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ── Excluded Folders ── -->
        <TextBlock Text="EXCLUDED FOLDERS"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium" 
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,16,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Margin="16,14">
                <TextBlock Text="Folders listed here will be skipped during indexing."
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                <!-- Add excluded folder row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource SelectedBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Height="32" Padding="10,0">
                        <TextBox Text="{Binding NewExcludedFolderPath, UpdateSourceTrigger=PropertyChanged}" FontSize="12" VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2" Click="OnBrowseExcludedFolderClick" Style="{StaticResource SettingsSoftButton}" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE8E5;" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Browse" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Excluded folder list -->
                <ItemsControl ItemsSource="{Binding ExcludedFoldersList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Remove"
                                        Command="{Binding DataContext.RemoveExcludedFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SettingsSoftButton}"
                                        Height="24"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ── Exclusion Patterns ── -->
        <TextBlock Text="EXCLUSION PATTERNS"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium" 
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,16,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Margin="16,14">
                <TextBlock Text="Glob patterns to exclude (e.g. *.tmp, node_modules, .git)."
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>
                <!-- Add pattern row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource SelectedBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Height="32" Padding="10,0">
                        <TextBox Text="{Binding NewExclusionPattern, UpdateSourceTrigger=PropertyChanged}" FontSize="12" VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2" Command="{Binding AddExclusionPatternCommand}" Style="{StaticResource SettingsSoftButton}" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE710;" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Add" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Pattern list -->
                <ItemsControl ItemsSource="{Binding ExclusionPatternsList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Remove"
                                        Command="{Binding DataContext.RemoveExclusionPatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SettingsSoftButton}"
                                        Height="24"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
