<UserControl x:Class="Spur.Views.Settings.AboutSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:conv="clr-namespace:Spur.Converters">
    <StackPanel>
        <TextBlock Text="Maintenance" Style="{StaticResource SettingsKicker}"/>
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="App catalog" Style="{StaticResource SettingsTitle}"/>
                            <TextBlock Text="Refresh if a newly installed app does not show up." Style="{StaticResource SettingsHint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshAppsCommand}" Style="{StaticResource SettingsSoftButton}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Divider}"/>
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Reset settings" Style="{StaticResource SettingsTitle}"/>
                            <TextBlock Text="Restore Spur to a fresh, simple default state." Style="{StaticResource SettingsHint}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reset" Command="{Binding ResetToDefaultsCommand}" Style="{StaticResource SettingsSoftButton}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="About" Style="{StaticResource SettingsKicker}"/>
        <Border Style="{StaticResource Panel}">
            <StackPanel Margin="16,14">
                <TextBlock Text="{Binding Version}" Style="{StaticResource SettingsTitle}"/>
                <TextBlock Text="{Binding Credits}" Style="{StaticResource SettingsHint}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding License}" Style="{StaticResource SettingsHint}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

