<UserControl x:Class="Spur.Views.Settings.AboutSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:conv="clr-namespace:Spur.Converters"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel>
        <!-- Page heading -->
        <TextBlock Text="About"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- ── Maintenance ── -->
        <TextBlock Text="MAINTENANCE"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <!-- App catalog -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="App catalog"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Refresh if a newly installed app does not show up."
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding RefreshAppsCommand}"
                            Style="{StaticResource SettingsSoftButton}"
                            VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{DynamicResource Separator}"/>

                <!-- Reset settings -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reset settings"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Restore Spur to a fresh, simple default state."
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Reset"
                            Command="{Binding ResetToDefaultsCommand}"
                            Style="{StaticResource SettingsSoftButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── About ── -->
        <TextBlock Text="SPUR"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="{DynamicResource Surface}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid Margin="18,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- App icon -->
                <Image Source="pack://application:,,,/Icons/spur-launcher-64x64.ico"
                       Width="56" Height="56"
                       Margin="0,0,20,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Version & credits -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Version}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Credits}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Credits}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="12" Foreground="{DynamicResource TextMuted}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Update section — single source of truth is the UpdateStatus state machine. -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- Status text: always visible, label changes by state. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <ui:FontIcon x:Name="UpdateStatusIcon"
                                     Glyph="&#xE73E;"
                                     FontSize="12"
                                     Foreground="{DynamicResource Accent}"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   x:Name="UpdateStatusLabel"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Accent}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Primary button — label and command swap by state. -->
                    <Button x:Name="UpdatePrimaryButton" Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsSoftButton}">
                                <!-- Idle / NoUpdate / Error → "Check for updates" -->
                                <Setter Property="Command"        Value="{Binding CheckForUpdatesCommand}"/>
                                <Setter Property="IsEnabled"       Value="{Binding CanCheckForUpdates}"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FontIcon Glyph="&#xE895;" FontSize="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="Check for updates" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Checking / Downloading / Installing → "Working…" + disabled -->
                                    <DataTrigger Binding="{Binding IsUpdateBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:FontIcon Glyph="&#xE895;" FontSize="13" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Working…" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <!-- Ready → "Restart now" -->
                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="ReadyToRestart">
                                        <Setter Property="Command" Value="{Binding RestartToUpdateCommand}"/>
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:FontIcon Glyph="&#xE7E7;" FontSize="13" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Restart now" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Cancel — only shown once an update is ready to install. -->
                    <Button Margin="6,0,0,0"
                            Padding="12,6"
                            Command="{Binding CancelUpdateCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsSoftButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateStatus}" Value="ReadyToRestart">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
