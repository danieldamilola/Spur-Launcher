<UserControl x:Class="Spur.Views.Settings.AboutSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:conv="clr-namespace:Spur.Converters"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel>
        <!-- Page heading -->
        <TextBlock Text="About"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- ── Maintenance ── -->
        <TextBlock Text="MAINTENANCE"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="#1C1C1F" CornerRadius="10" BorderBrush="#1AFFFFFF" BorderThickness="1" Margin="0,0,0,20">
            <StackPanel>
                <!-- App catalog -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="App catalog"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Refresh if a newly installed app does not show up."
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Refresh"
                            Command="{Binding RefreshAppsCommand}"
                            Style="{StaticResource SettingsSoftButton}"
                            VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="#12FFFFFF"/>

                <!-- Reset settings -->
                <Grid MinHeight="56" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reset settings"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Restore Spur to a fresh, simple default state."
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Reset"
                            Command="{Binding ResetToDefaultsCommand}"
                            Style="{StaticResource SettingsSoftButton}"
                            VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── About ── -->
        <TextBlock Text="SPUR"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="10" FontWeight="Medium"
                   Foreground="{DynamicResource TextTertiary}"
                   Margin="4,0,0,8"/>
        <Border Background="#1C1C1F" CornerRadius="10" BorderBrush="#1AFFFFFF" BorderThickness="1">
            <Grid Margin="18,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- App icon -->
                <Image Source="pack://application:,,,/Icons/spur-launcher-64x64.ico"
                       Width="56" Height="56"
                       Margin="0,0,20,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Version & credits -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Version}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding Credits}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding License}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
