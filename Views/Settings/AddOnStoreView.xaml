<UserControl x:Class="Spur.Views.Settings.AddOnStoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
            <TextBlock Text="Add-on Store" Style="{StaticResource SettingsKicker}"/>
            <TextBlock Text="Discover and install community add-ons." Style="{StaticResource SettingsHint}" Margin="0,0,0,16"/>

            <!-- Restart Required notice — bound to StoreService.RestartRequired -->
            <Border x:Name="RestartBanner"
                    Background="{DynamicResource SelectedBg}"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/>
                    <TextBlock Text="Restart Spur to load add-on changes."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Loading State -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <ui:ProgressRing IsActive="True" Width="32" Height="32" Margin="0,0,0,16"/>
            <TextBlock Text="Fetching community add-ons..." Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <!-- Empty / Error State -->
        <StackPanel x:Name="ErrorPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <ui:FontIcon Glyph="&#xE8F1;" FontSize="32" Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,16"/>
            <TextBlock x:Name="ErrorText" Text="No community add-ons available yet. Check back soon!" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center"/>
            <TextBlock Text="Built-in add-ons are managed in the Add-ons tab." Foreground="{DynamicResource TextTertiary}" FontSize="12" TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center" Margin="0,6,0,0"/>
            <Button Margin="0,16,0,0" Click="OnBrowseBuiltInClicked" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE113;" FontSize="13" Margin="0,0,6,0"/>
                    <TextBlock Text="Browse Built-in Add-ons" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Data Grid -->
        <ScrollViewer x:Name="DataPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="StoreItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel}" Margin="6">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SurfaceHigh}" Margin="0,0,12,0">
                                        <TextBlock Text="🧩" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SettingsTitle}"/>
                                        <TextBlock Text="{Binding Author, StringFormat='By {0}'}" FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource SettingsHint}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Style="{DynamicResource AccentButtonStyle}" Click="OnInstallClicked" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:FontIcon Glyph="&#xE896;" FontSize="13" Margin="0,0,6,0"/>
                                            <TextBlock Text="Install" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
