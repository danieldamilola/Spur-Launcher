<UserControl x:Class="Spur.Views.Settings.AddOnsSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:conv="clr-namespace:Spur.Converters"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <UserControl.Resources>
        <conv:AddOnSettingsViewConverter x:Key="AddOnSettingsViewConv"/>
    </UserControl.Resources>

    <StackPanel>
        <!-- Page heading -->
        <TextBlock Text="Add-ons"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- Plugin list card (single rounded card, rows divided by hairlines) -->
        <Border Background="{DynamicResource Surface}"
                CornerRadius="10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <ItemsControl ItemsSource="{Binding AllAddOns}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- ── Header row ── -->
                            <Grid Background="Transparent" MinHeight="64">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>           <!-- left pad -->
                                    <ColumnDefinition Width="42"/>           <!-- icon box -->
                                    <ColumnDefinition Width="14"/>           <!-- gap -->
                                    <ColumnDefinition Width="*"/>            <!-- name + desc -->
                                    <ColumnDefinition Width="Auto"/>         <!-- "On" label -->
                                    <ColumnDefinition Width="54"/>          <!-- toggle -->
                                    <ColumnDefinition Width="36"/>           <!-- chevron -->
                                    <ColumnDefinition Width="8"/>            <!-- right pad -->
                                </Grid.ColumnDefinitions>

                                <!-- Icon square -->
                                <Border Grid.Column="1"
                                        Width="36" Height="36"
                                        CornerRadius="9"
                                        Background="{DynamicResource SurfaceRaised}"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <!-- Colored PNG icon (preferred) -->
                                        <Image Source="{Binding IconPath}"
                                               Width="20" Height="20"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                        <!-- Glyph fallback (hidden when IconPath is set) -->
                                        <ui:FontIcon Glyph="{Binding IconGlyph}"
                                                     FontSize="16"
                                                     Foreground="{DynamicResource Accent}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                            <ui:FontIcon.Style>
                                                <Style TargetType="ui:FontIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:FontIcon.Style>
                                        </ui:FontIcon>
                                    </Grid>
                                </Border>

                                <!-- Name + Description -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,2,12,2">
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{DynamicResource Token.Font.Primary}"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontFamily="{DynamicResource Token.Font.Primary}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- "On" / "Off" label -->
                                <TextBlock Grid.Column="4"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Token.Font.Primary}"
                                           FontSize="12"
                                           Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Off"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Text" Value="On"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Toggle switch -->
                                <local:ToggleSwitch Grid.Column="5"
                                                    IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                    VerticalAlignment="Center"/>

                                <!-- Chevron expand button -->
                                <ToggleButton x:Name="ExpandBtn"
                                              Grid.Column="6"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Width="28" Height="28"
                                              Cursor="Hand"
                                              Padding="0">
                                    <ui:FontIcon x:Name="ChevronIcon"
                                                 Glyph="&#xE70D;"
                                                 FontSize="11"
                                                 Foreground="{DynamicResource TextMuted}"/>
                                </ToggleButton>
                            </Grid>

                            <!-- ── Expanded settings area ── -->
                            <Border x:Name="ExpandedArea"
                                    Visibility="{Binding IsChecked, ElementName=ExpandBtn, Converter={StaticResource BoolToVisibility}}"
                                    Background="{DynamicResource SurfaceLow}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="20,14,20,16">
                                <StackPanel>
                                    <!-- Action keyword row -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:FontIcon Glyph="&#xE73A;"
                                                         FontSize="14"
                                                         Foreground="{DynamicResource TextMuted}"
                                                         Margin="0,0,10,0"/>
                                            <TextBlock Text="Action keyword"
                                                       FontFamily="{DynamicResource Token.Font.Primary}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Keyword input pill -->
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource SelectedBg}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Height="28"
                                                MinWidth="72"
                                                Padding="10,0">
                                            <TextBox Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource TextPrimary}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Custom settings (if any) -->
                                    <ContentControl Content="{Binding Converter={StaticResource AddOnSettingsViewConv}}"
                                                    Visibility="{Binding Converter={StaticResource AddOnSettingsViewConv}, ConverterParameter=Visibility}"
                                                    Margin="0,4,0,0"/>

                                    <!-- Footer: author / version / built-in badge -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,12,0,0">
                                        <TextBlock Text="{Binding Author, StringFormat='by {0}'}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  |  "
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <Border Background="{DynamicResource SelectedBg}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Built-in"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Hairline divider -->
                            <Border x:Name="Divider"
                                    Height="1"
                                    Background="{DynamicResource Separator}"
                                    Margin="0"/>
                        </StackPanel>

                        <DataTemplate.Triggers>
                            <Trigger SourceName="ExpandBtn" Property="IsChecked" Value="True">
                                <Setter TargetName="ChevronIcon" Property="Glyph" Value="&#xE70E;"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
