<UserControl x:Class="Spur.Views.Settings.ExtrasSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:conv="clr-namespace:Spur.Converters"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel>
        <TextBlock Text="Optional tools" Style="{StaticResource SettingsKicker}"/>
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="AI assistant" Style="{StaticResource SettingsTitle}"/>
                            <TextBlock Text="Enable only if you want AI commands inside Spur." Style="{StaticResource SettingsHint}"/>
                            <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" Margin="4,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding AiKeyword, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalContentAlignment="Center" Padding="2,4"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding AiEnabled, Mode=TwoWay}" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Divider}"/>
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Timer" Style="{StaticResource SettingsTitle}"/>
                            <TextBlock Text="Small countdown commands from the launcher." Style="{StaticResource SettingsHint}"/>
                            <Border Style="{StaticResource SettingsInputFrame}" Margin="0,8,0,0" MaxWidth="200">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Keyword" FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" Margin="4,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding TimerKeyword, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalContentAlignment="Center" Padding="2,4"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsInputFrame}" Margin="0,6,0,0" MaxWidth="300">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Presets" FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}"
                                               VerticalAlignment="Center" Margin="4,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding TimerPresets, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalContentAlignment="Center" Padding="2,4"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding TimerEnabled, Mode=TwoWay}" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="AI provider" Style="{StaticResource SettingsKicker}"/>
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Provider and model" Style="{StaticResource SettingsTitle}"/>
                            <TextBlock Text="Stored locally. Spur only uses this when AI is enabled." Style="{StaticResource SettingsHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding AiProvider, Mode=TwoWay}" Width="120"/>
                            <ComboBox ItemsSource="{Binding CurrentModels}" SelectedItem="{Binding AiModel, Mode=TwoWay}" Width="180" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Divider}"/>
                <Border Style="{StaticResource SettingsRow}">
                    <StackPanel>
                        <TextBlock Text="API key" Style="{StaticResource SettingsTitle}"/>
                        <TextBlock Text="Protected with Windows user encryption." Style="{StaticResource SettingsHint}"/>
                        <Border Style="{StaticResource SettingsInputFrame}" Margin="0,10,0,0">
                            <PasswordBox x:Name="AiApiKeyBox"
                                         PasswordChanged="OnAiApiKeyChanged"
                                         FontFamily="{DynamicResource Token.Font.Primary}"
                                         FontSize="12"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

