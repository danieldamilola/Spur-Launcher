<UserControl x:Class="Spur.Views.HomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:conv="clr-namespace:Spur.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <conv:PathToIconConverter x:Key="IconConverter"/>
    </UserControl.Resources>

    <!--
        HomePanel — expanded-mode homepage.
        
        Design rationale:
        • Categories are destination cards — elevated surface with icon, title, subtle hint.
          They teach users where to go.
        • Add-ons are typed-to-activate — the keyword IS the primary affordance,
          shown inline next to the name so users learn "type X to use Y".
        • No hard dividers — visual hierarchy comes from spacing and typography weight.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">
        <StackPanel Margin="0,6,0,8">

            <!-- ═══ Browse — three destination cards ═══ -->
            <UniformGrid Columns="3" Margin="14,4,14,0">

                <!-- Files -->
                <Border x:Name="FilesCard" Cursor="Hand"
                        Background="{DynamicResource SurfaceLow}"
                        CornerRadius="{DynamicResource RadiusRow}"
                        Margin="0,0,5,0" Padding="12,10"
                        MouseLeftButtonDown="OnCategoryCardClick" Tag="files">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0.75" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <ui:FontIcon Glyph="&#xE8B7;" FontSize="18"
                                     Foreground="{DynamicResource Accent}"
                                     HorizontalAlignment="Left"/>
                        <TextBlock Text="Files"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="{DynamicResource FontSm}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="Search your files"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="{DynamicResource FontMeta}"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Clipboard -->
                <Border x:Name="ClipCard" Cursor="Hand"
                        Background="{DynamicResource SurfaceLow}"
                        CornerRadius="{DynamicResource RadiusRow}"
                        Margin="3,0,3,0" Padding="12,10"
                        MouseLeftButtonDown="OnCategoryCardClick" Tag="clipboard">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0.75" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <ui:FontIcon Glyph="&#xE77F;" FontSize="18"
                                     Foreground="{DynamicResource Accent}"
                                     HorizontalAlignment="Left"/>
                        <TextBlock Text="Clipboard"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="{DynamicResource FontSm}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="History &amp; pins"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="{DynamicResource FontMeta}"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Commands -->
                <Border x:Name="CmdsCard" Cursor="Hand"
                        Background="{DynamicResource SurfaceLow}"
                        CornerRadius="{DynamicResource RadiusRow}"
                        Margin="5,0,0,0" Padding="12,10"
                        MouseLeftButtonDown="OnCategoryCardClick" Tag="actions">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0.75" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <ui:FontIcon Glyph="&#xE756;" FontSize="18"
                                     Foreground="{DynamicResource Accent}"
                                     HorizontalAlignment="Left"/>
                        <TextBlock Text="Commands"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="{DynamicResource FontSm}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,6,0,0"/>
                        <TextBlock Text="System actions"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="{DynamicResource FontMeta}"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ Quick Actions label ═══ -->
            <TextBlock Text="QUICK ACTIONS"
                       FontFamily="{DynamicResource Token.Font.Primary}"
                       FontSize="{DynamicResource FontNano}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="18,14,0,4"
                       Opacity="0.7"/>

            <!-- ═══ Add-on list ═══ -->
            <ItemsControl x:Name="AddOnsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="{DynamicResource RowHeight}" Cursor="Hand"
                              MouseLeftButtonDown="OnAddOnClick"
                              Background="Transparent">

                            <!-- Hover overlay -->
                            <Border x:Name="HoverOverlay"
                                    Background="{DynamicResource HoverBg}"
                                    Opacity="0"/>

                            <!-- Content row -->
                            <Grid Margin="12,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="30" Height="30"
                                        CornerRadius="8"
                                        Background="Transparent"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="AddOnIcon"
                                               Width="28" Height="28"
                                               Stretch="Uniform"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Source>
                                                <Binding Path="IconPath">
                                                    <Binding.Converter>
                                                        <conv:PathToIconConverter/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </Image.Source>
                                        </Image>

                                        <ui:FontIcon x:Name="GlyphFallback"
                                                     Glyph="{Binding IconGlyph}"
                                                     FontSize="{DynamicResource FontMd}"
                                                     Foreground="{DynamicResource TextSecondary}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                                <!-- Name + inline keyword -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontFamily="{DynamicResource Token.Font.Primary}"
                                               FontSize="{DynamicResource FontResult}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Keyword hint — right side, subtle mono text -->
                                <Border Grid.Column="3"
                                        CornerRadius="4"
                                        Background="{DynamicResource SurfaceLow}"
                                        Padding="6,2,6,3"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayKeyword}"
                                               FontFamily="{DynamicResource Token.Font.Mono}"
                                               FontSize="{DynamicResource FontXs}"
                                               Foreground="{DynamicResource TextMuted}"/>
                                </Border>
                            </Grid>
                        </Grid>

                        <DataTemplate.Triggers>
                            <!-- Hover animation -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- No icon → glyph fallback -->
                            <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                <Setter TargetName="AddOnIcon"     Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="GlyphFallback" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
