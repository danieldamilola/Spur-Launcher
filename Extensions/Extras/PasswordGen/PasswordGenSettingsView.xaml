<UserControl x:Class="Spur.Extensions.Extras.PasswordGen.PasswordGenSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel Margin="0,8">
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Default Length" VerticalAlignment="Center" Style="{StaticResource SettingsHint}"/>
            <ui:NumberBox Grid.Column="1" Value="{Binding DefaultLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="4" Maximum="128" SpinButtonPlacementMode="Compact" Width="100"/>
        </Grid>
        
        <ui:ToggleSwitch IsOn="{Binding IncludeSymbols, Mode=TwoWay}" Header="Include Symbols (!@#$)" Margin="0,0,0,12" OnContent="{x:Null}" OffContent="{x:Null}"/>
        <ui:ToggleSwitch IsOn="{Binding IncludeNumbers, Mode=TwoWay}" Header="Include Numbers (0-9)" Margin="0,0,0,12" OnContent="{x:Null}" OffContent="{x:Null}"/>
        <ui:ToggleSwitch IsOn="{Binding IncludeUppercase, Mode=TwoWay}" Header="Include Uppercase (A-Z)" OnContent="{x:Null}" OffContent="{x:Null}"/>
    </StackPanel>
</UserControl>
