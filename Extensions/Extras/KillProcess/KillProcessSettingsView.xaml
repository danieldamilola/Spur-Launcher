<UserControl x:Class="Spur.Extensions.Extras.KillProcess.KillProcessSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel Margin="0,8">
        <ui:ToggleSwitch IsOn="{Binding ShowWindowTitles, Mode=TwoWay}" Header="Show window titles in results" Margin="0,0,0,12" OnContent="{x:Null}" OffContent="{x:Null}"/>
        <ui:ToggleSwitch IsOn="{Binding PrioritizeVisibleWindows, Mode=TwoWay}" Header="Prioritize processes with visible windows" OnContent="{x:Null}" OffContent="{x:Null}"/>
    </StackPanel>
</UserControl>
