<UserControl x:Class="Spur.Extensions.AddOns.Shell.ShellSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel Margin="0,8">
        <Border Background="Transparent" CornerRadius="6" Padding="0">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Terminal Executor" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedItem="{Binding Terminal, Mode=TwoWay}" Width="100">
                        <sys:String>cmd</sys:String>
                        <sys:String>powershell</sys:String>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Close terminal after execution" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding CloseAfterExecution, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Always run as Administrator" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding AlwaysRunAsAdministrator, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Use Windows Terminal (wt.exe)" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding UseWindowsTerminal, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
