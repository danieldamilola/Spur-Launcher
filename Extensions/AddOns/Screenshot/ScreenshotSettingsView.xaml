<UserControl x:Class="Spur.Extensions.AddOns.Screenshot.ScreenshotSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <StackPanel Margin="0,8">
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Save Format" VerticalAlignment="Center" Style="{StaticResource SettingsHint}"/>
            <ComboBox Grid.Column="1" SelectedItem="{Binding SaveFormat, Mode=TwoWay}" Width="100">
                <sys:String>png</sys:String>
                <sys:String>jpeg</sys:String>
                <sys:String>bmp</sys:String>
            </ComboBox>
        </Grid>

        <StackPanel>
            <TextBlock Text="Save Folder (Optional)" Style="{StaticResource SettingsHint}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource SettingsInputFrame}" HorizontalAlignment="Left" MinWidth="200" MaxWidth="300">
            <TextBox Text="{Binding SaveFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ui:ControlHelper.PlaceholderText="e.g. C:\Pictures\Screenshots" BorderThickness="0" Background="Transparent" Padding="0,0,0,0"/>
        </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
