<UserControl x:Class="Spur.Extensions.AddOns.Ai.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel Margin="0,8">
        <TextBlock Text="Al provider" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,8"/>
        <Border Background="Transparent" CornerRadius="6" Padding="0">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Provider and model" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"/>
                        <TextBlock Text="Stored locally. Spur only uses this when AI is enabled." Foreground="{DynamicResource TextMuted}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding AiProvider, Mode=TwoWay}" Width="120"/>
                        <ComboBox ItemsSource="{Binding CurrentModels}" SelectedItem="{Binding AiModel, Mode=TwoWay}" Width="180" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="API key" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12"/>
                        <TextBlock Text="Protected with Windows user encryption." Foreground="{DynamicResource TextMuted}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource SelectedBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Width="308">
                        <PasswordBox x:Name="AiApiKeyBox"
                                     PasswordChanged="OnAiApiKeyChanged"
                                     FontFamily="{DynamicResource Token.Font.Primary}"
                                     FontSize="12"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimary}"
                                     Padding="10,6"
                                     VerticalContentAlignment="Center"/>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
