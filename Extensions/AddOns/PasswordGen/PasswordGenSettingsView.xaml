<UserControl x:Class="Spur.Extensions.AddOns.PasswordGen.PasswordGenSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Spur.Views"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <StackPanel Margin="0,8">
        <Border Background="Transparent" CornerRadius="6" Padding="0">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Default Length" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" VerticalAlignment="Center"/>
                    <ui:NumberBox Grid.Column="1" Value="{Binding DefaultLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="4" Maximum="128" SpinButtonPlacementMode="Compact" Width="100"/>
                </Grid>
                
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Include Symbols (!@#$)" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding IncludeSymbols, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
                
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Include Numbers (0-9)" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding IncludeNumbers, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Include Uppercase (A-Z)" Foreground="{DynamicResource TextSecondary}" FontFamily="{DynamicResource Token.Font.Primary}" FontSize="12" VerticalAlignment="Center"/>
                    <ui:ToggleSwitch Grid.Column="1" IsOn="{Binding IncludeUppercase, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
