<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Spur</AssemblyName>
    <RootNamespace>Spur</RootNamespace>
    <ApplicationIcon>Icons\spur-256x256.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    
    <!-- CPU/Memory Optimizations -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>

    <!-- Assembly identity -->
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <Product>Spur Launcher</Product>
    <Company>Spur</Company>
    <Copyright>Copyright © 2025 Spur</Copyright>
    <Description>Spur — a fast, beautiful app launcher for Windows</Description>
  </PropertyGroup>

  <!-- Debug builds: optimisation OFF for step-through debugging -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Release builds: full optimisation, no debug symbols -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- ReadyToRun: pre-compile to native for faster cold start -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Disable trimming — COM interop + DI reflection are not trim-safe -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Velopack" Version="0.0.1053" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Spur.Tests\**" />
    <Compile Remove="RefactorApp\**" />
    <!-- Ensure ViewModel sources are compiled -->
    <Page Remove="Spur.Tests\**" />
    <Page Remove="RefactorApp\**" />
    <!-- Font files bundled as resources -->
    <Resource Include="Themes\Fonts\*.ttf" />
    <!-- Colored add-on icons (Flow Launcher, MIT license) -->
    <Resource Include="Assets\Icons\*.png" />
    <!-- Brand icons (tray + UI); exe icon from ApplicationIcon above -->
    <Resource Include="Icons\spur-16x16.ico" />
    <Resource Include="Icons\spur-24x24.ico" />
    <Resource Include="Icons\spur-32x32.ico" />
    <Resource Include="Icons\spur-48x48.ico" />
    <Resource Include="Icons\spur-64x64.ico" />
    <Resource Include="Icons\spur-96x96.ico" />
    <Resource Include="Icons\spur-128x128.ico" />
    <Resource Include="Icons\spur-256x256.ico" />
    <Resource Include="Icons\spur-512x512.ico" />
    <Resource Include="Icons\spur-1024x1024.ico" />
    <!-- Legacy copy for publish.ps1 / Velopack (synced from 256px source) -->
    <Content Include="Assets\spur.ico" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>

