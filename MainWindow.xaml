<Window x:Class="Spur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:views="clr-namespace:Spur.Views"
        xmlns:conv="clr-namespace:Spur.Converters"
        Title=""
        Width="{Binding Config.BarWidth, FallbackValue=640}"
        MinHeight="56"
        Height="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0"
        Loaded="OnLoaded"
         MouseEnter="OnWindowMouseEnter"
         MouseLeave="OnWindowMouseLeave">

  <Window.Resources>
  </Window.Resources>

  <Border x:Name="RootBorder"
          Background="Transparent"
          Padding="20"
          SnapsToDevicePixels="True">

    <Border.RenderTransform>
      <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>
    <Border.RenderTransformOrigin>0.5,0.08</Border.RenderTransformOrigin>

    <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
        <!-- Search capsule — shrinks/grows with SizeToContent -->
        <ColumnDefinition Width="*"/>
        <!-- File preview panel -->
        <ColumnDefinition x:Name="PreviewColumn" Width="Auto"/>
        <!-- Category circles — float outside to the right -->
        <ColumnDefinition x:Name="CategoryColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <!-- ── File preview panel ── -->
      <views:FilePreviewPanel x:Name="FilePreviewControl"
                               Grid.Column="1"
                               DataContext="{Binding}"
                               VerticalAlignment="Top"
                               Margin="8,0,0,0"
                               Visibility="{Binding IsFloatingPreview, Converter={StaticResource BoolToVisibility}}"/>

      <!-- ── Floating clipboard preview panel ── -->
      <Border x:Name="ClipboardPreviewFloat"
              Grid.Column="1"
              VerticalAlignment="Top"
              Margin="8,0,0,0"
              Visibility="Collapsed"
              Background="{DynamicResource SurfaceAcrylic}"
              Opacity="{Binding Config.WindowOpacity}"
              BorderBrush="{DynamicResource GlassBorder}"
              BorderThickness="1"
              CornerRadius="{DynamicResource RadiusWindow}"
                Width="300">
        <Border.RenderTransform>
          <TranslateTransform/>
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Header -->
          <StackPanel Grid.Row="0" Margin="14,12,14,8">
            <TextBlock Text="Preview"
                       FontFamily="{DynamicResource Token.Font.Primary}"
                       FontSize="{DynamicResource FontBody}" FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="ClipFloatMetadata"
                       FontFamily="{DynamicResource Token.Font.Primary}"
                       FontSize="{DynamicResource FontCaption}"
                       Foreground="{DynamicResource TextTertiary}"
                       Margin="0,3,0,0"/>
          </StackPanel>

          <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Separator}"/>

          <!-- Action buttons -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,8,10,4">
            <Button x:Name="ClipFloatCopyBtn"
                    Style="{StaticResource SettingsSoftButton}"
                    ToolTip="Copy" Padding="6" Width="30" Height="30"
                    Click="OnFloatCopyClick">
              <ui:FontIcon Glyph="&#xE8C8;" FontSize="14"/>
            </Button>
            <Button x:Name="ClipFloatPinBtn"
                    Style="{StaticResource SettingsSoftButton}"
                    Margin="4,0,0,0"
                    ToolTip="Pin" Padding="6" Width="30" Height="30"
                    Click="OnFloatPinClick">
              <ui:FontIcon x:Name="ClipFloatPinGlyph" Glyph="&#xE718;" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource SettingsSoftButton}"
                    Margin="4,0,0,0"
                    ToolTip="Delete" Padding="6" Width="30" Height="30"
                    Click="OnFloatDeleteClick">
              <ui:FontIcon Glyph="&#xE74D;" FontSize="14"/>
            </Button>
          </StackPanel>

          <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Separator}" Margin="10,0"/>

          <!-- Content -->
          <ScrollViewer Grid.Row="3"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        MaxHeight="280">
            <Grid Margin="14,8,14,10">
              <Image x:Name="ClipFloatImage"
                     MaxHeight="280" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     Visibility="Collapsed"/>
              <TextBlock x:Name="ClipFloatText"
                         FontFamily="{DynamicResource Token.Font.Mono}"
                         FontSize="{DynamicResource FontCaption}"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap"/>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- ── Search capsule (search bar + results only, no categories) ── -->
      <Grid Grid.Column="0" Background="Transparent">
          <Border x:Name="Capsule"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                CornerRadius="{DynamicResource RadiusWindow}"
                BorderBrush="{DynamicResource GlassBorder}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                Margin="0,0,0,8">
          <Border.Effect>
          <DropShadowEffect BlurRadius="20" ShadowDepth="0" Direction="0" Opacity="0.5" Color="Black"/>
          </Border.Effect>

          <Grid x:Name="CapsuleRoot" ClipToBounds="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="56"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Background Plate for WindowOpacity -->
            <Border Grid.RowSpan="5" 
                    CornerRadius="{DynamicResource RadiusWindow}"
                    Background="{DynamicResource SurfaceAcrylic}" 
                    Opacity="{Binding Config.WindowOpacity}"/>

            <!-- Liquid glass: subtle top-edge luminosity highlight -->
            <Border Grid.RowSpan="5"
                    CornerRadius="{DynamicResource RadiusWindow}"
                    IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#0AFFFFFF" Offset="0"/>
                  <GradientStop Color="#00FFFFFF" Offset="0.4"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <!-- Search bar row (no category column here anymore) -->
            <views:SearchBar x:Name="SearchBarControl"
                             Grid.Row="0"
                             DataContext="{Binding}"/>



              <Grid Grid.Row="2"
                  x:Name="ContentArea"
                  Visibility="Collapsed"
                  MaxHeight="424"
                  Margin="0,4,0,0">
              <Grid.LayoutTransform>
                <ScaleTransform x:Name="ExpandedScale" ScaleY="1" />
              </Grid.LayoutTransform>
              <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Background="{DynamicResource Separator}"/>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                  <views:HomePanel x:Name="HomePanelControl"
                                   DataContext="{Binding}"
                                   Visibility="Collapsed"/>
                   <ListBox x:Name="ResultsListBox"
                            ItemsSource="{Binding ResultsVm.GroupedView}"
                            ItemTemplate="{StaticResource ResultTemplate}"
                            ItemContainerStyle="{StaticResource ResultItemStyle}"
                            SelectedIndex="{Binding ResultsVm.SelectedIndex, Mode=TwoWay}"
                            PreviewMouseLeftButtonUp="OnResultsListMouseClick"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            MaxHeight="352"
                            Focusable="False"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            VirtualizingStackPanel.IsVirtualizing="True"
                            VirtualizingStackPanel.VirtualizationMode="Recycling"
                            ScrollViewer.CanContentScroll="False"
                            AutomationProperties.Name="Search results"
                            AutomationProperties.LiveSetting="Polite">
                        <ListBox.GroupStyle>
                          <GroupStyle>
                            <GroupStyle.ContainerStyle>
                              <Style TargetType="GroupItem">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                              </Style>
                            </GroupStyle.ContainerStyle>
                            <GroupStyle.HeaderTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="{DynamicResource Token.Font.Primary}"
                                           FontSize="{DynamicResource FontHint}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextMuted}"
                                           Padding="16,8,16,4"
                                           TextOptions.TextFormattingMode="Display"/>
                              </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                          </GroupStyle>
                        </ListBox.GroupStyle>
                     </ListBox>
                     <!-- Empty state: shown when query is active but no results -->
                     <TextBlock x:Name="NoResultsText"
                                Text="No results found"
                                FontFamily="{DynamicResource Token.Font.Primary}"
                                FontSize="{DynamicResource FontBody}"
                                Foreground="{DynamicResource TextMuted}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,8,0,0"
                                Visibility="Collapsed"
                                AutomationProperties.LiveSetting="Polite">
                         <TextBlock.Style>
                             <Style TargetType="TextBlock">
                                 <Setter Property="Visibility" Value="Collapsed"/>
                                 <Style.Triggers>
                                     <MultiDataTrigger>
                                         <MultiDataTrigger.Conditions>
                                             <Condition Binding="{Binding HasResults}" Value="False"/>
                                             <Condition Binding="{Binding HomePanelControl.Visibility}" Value="Collapsed"/>
                                         </MultiDataTrigger.Conditions>
                                         <Setter Property="Visibility" Value="Visible"/>
                                     </MultiDataTrigger>
                                 </Style.Triggers>
                             </Style>
                         </TextBlock.Style>
                     </TextBlock>
                   <ListBox x:Name="ContextMenuListBox"
                            ItemsSource="{Binding ContextMenuVm.Results}"
                            ItemTemplate="{StaticResource ResultTemplate}"
                            ItemContainerStyle="{StaticResource ResultItemStyle}"
                            SelectedIndex="{Binding ContextMenuVm.SelectedIndex, Mode=TwoWay}"
                           Visibility="Collapsed"
                           HorizontalContentAlignment="Stretch"
                           Padding="0"
                           MaxHeight="352"
                           Focusable="False"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           VirtualizingStackPanel.IsVirtualizing="True"
                           VirtualizingStackPanel.VirtualizationMode="Recycling"
                           ScrollViewer.CanContentScroll="False"
                           AutomationProperties.Name="Context menu"/>
                   <ListBox x:Name="HistoryListBox"
                            ItemsSource="{Binding HistoryVm.Results}"
                            ItemTemplate="{StaticResource ResultTemplate}"
                            ItemContainerStyle="{StaticResource ResultItemStyle}"
                            SelectedIndex="{Binding HistoryVm.SelectedIndex, Mode=TwoWay}"
                           Visibility="Collapsed"
                           HorizontalContentAlignment="Stretch"
                           Padding="0"
                           MaxHeight="352"
                           Focusable="False"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           VirtualizingStackPanel.IsVirtualizing="True"
                           VirtualizingStackPanel.VirtualizationMode="Recycling"
                           ScrollViewer.CanContentScroll="False"
                           AutomationProperties.Name="Search history"/>
                  <views:ClipboardManager x:Name="ClipboardManagerControl"
                                          DataContext="{Binding Clipboard}"
                                          Visibility="Collapsed"/>
                  <views:AddOnPanel x:Name="AddOnPanelControl"
                                    DataContext="{Binding}"
                                    Visibility="Collapsed"/>
                </Grid>
                <!-- Inline preview divider -->
                <Border Grid.Column="1"
                        Width="1"
                        Margin="0,8"
                        Background="{DynamicResource Separator}"
                        Visibility="{Binding IsInlinePreview, Converter={StaticResource BoolToVisibility}}"/>
                <!-- Inline preview content -->
                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="424"
                              Visibility="{Binding IsInlinePreview, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Width="260" Margin="12,10">
                    <TextBlock Text="{Binding PreviewFileName}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="{DynamicResource FontBody}" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding PreviewFileName}"/>
                    <TextBlock Text="{Binding PreviewFileInfo}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="{DynamicResource FontCaption}"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,3,0,8"/>
                    <!-- Text preview -->
                    <TextBlock Text="{Binding PreviewContent}"
                               FontFamily="{DynamicResource Token.Font.Mono}"
                               FontSize="{DynamicResource FontCaption}"
                               LineHeight="16"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Visibility="{Binding PreviewContent, Converter={StaticResource NullToVis}}"/>
                    <!-- Image preview -->
                    <Image Source="{Binding PreviewImage}"
                           MaxHeight="260"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibility}}"/>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>



            <Border Grid.Row="4"
                    x:Name="FooterArea"
                    Visibility="Collapsed"
                    Height="34"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0">
              <TextBlock x:Name="FooterText"
                         Margin="16,0"
                         VerticalAlignment="Center"
                          FontFamily="{DynamicResource Token.Font.Primary}"
                          FontSize="{DynamicResource FontHint}"
                         Foreground="{DynamicResource TextTertiary}"
                         Text="{Binding FooterHint}"
                         AutomationProperties.LiveSetting="Polite"/>
            </Border>

            <!-- ═══ Toast notification bar ═══ -->
            <Border Grid.Row="3"
                    x:Name="ToastBar"
                    Visibility="Collapsed"
                    Opacity="0"
                    Height="32"
                    Background="{DynamicResource Depth2}"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
              <TextBlock Text="{Binding ToastMessage}"
                         VerticalAlignment="Center"
                         FontFamily="{DynamicResource Token.Font.Primary}"
                         FontSize="{DynamicResource FontSm}"
                         Foreground="{DynamicResource TextSecondary}"
                         AutomationProperties.LiveSetting="Assertive"/>
            </Border>

            <!-- Command palette overlay -->
            <views:CommandPalette x:Name="CommandPaletteControl"
                                  Grid.RowSpan="5"
                                  DataContext="{Binding CommandPalette}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsHitTestVisible="True"
                                  Panel.ZIndex="100"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ── Category circles — outside the capsule, slide in on hover ── -->
      <Grid x:Name="CategoryZone"
            Grid.Column="2"
            VerticalAlignment="Top"
            Height="56"
            Margin="6,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="CategoryBackButton"
                Grid.Column="0"
                Width="28"
                Height="28"
                Margin="0,0,8,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Visibility="Collapsed"
                Click="OnBackClick"
                AutomationProperties.Name="Back">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="BackButtonBg"
                      Background="{DynamicResource Depth2}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Width="28" Height="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="esc"
                           FontFamily="{DynamicResource Token.Font.Mono}"
                           FontSize="{DynamicResource FontNano}"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,0,0,1"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="BackButtonBg" Property="Background" Value="{DynamicResource HoverBg}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <Border x:Name="CategoryDivider"
                Grid.Column="1"
                Width="1"
                Margin="0,10"
                Background="{DynamicResource Separator}"
                Opacity="0"/>

        <ItemsControl x:Name="CategoryButtons"
                      Grid.Column="2"
                      Margin="6,0,0,0"
                      Opacity="0"
                      ItemsSource="{Binding PinnedCategories}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <views:CategoryCircle Tag="{Binding Id}"
                                    Label="{Binding Label}"
                                    AutomationProperties.Name="{Binding Label}"
                                    Margin="0,0,4,0"
                                    IconGlyph="{Binding IconGlyph}"
                                    Click="OnCategoryClick"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>
  </Border>
</Window>
