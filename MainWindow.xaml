<Window x:Class="Spur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:views="clr-namespace:Spur.Views"
        xmlns:conv="clr-namespace:Spur.Converters"
        Title=""
        Width="{Binding Config.BarWidth, FallbackValue=640}"
        MinWidth="{Binding Config.BarWidth, FallbackValue=640}"
        MaxWidth="{Binding Config.BarWidth, FallbackValue=640}"
        MinHeight="56"
        Height="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0"
        Loaded="OnLoaded"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave">

  <Border x:Name="RootBorder"
          Background="Transparent"
          Padding="0"
          SnapsToDevicePixels="True">

    <Border.RenderTransform>
      <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>
    <Border.RenderTransformOrigin>0.5,0.08</Border.RenderTransformOrigin>

    <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
        <!-- Search capsule — shrinks/grows with SizeToContent -->
        <ColumnDefinition Width="*"/>
        <!-- Category circles — float outside to the right -->
        <ColumnDefinition x:Name="CategoryColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <!-- ── Search capsule (search bar + results only, no categories) ── -->
      <Grid Grid.Column="0" Background="Transparent">
        <Border x:Name="Capsule"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                CornerRadius="{DynamicResource RadiusWindow}"
                BorderBrush="{DynamicResource GlassBorder}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                ClipToBounds="True">

          <Grid x:Name="CapsuleRoot">
            <Grid.RowDefinitions>
              <RowDefinition Height="56"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Background Plate for WindowOpacity -->
            <Border Grid.RowSpan="4" 
                    CornerRadius="{DynamicResource RadiusWindow}"
                    Background="{DynamicResource SurfaceAcrylic}" 
                    Opacity="{Binding Config.WindowOpacity}"/>

            <!-- Liquid glass: subtle top-edge luminosity highlight -->
            <Border Grid.RowSpan="4"
                    CornerRadius="{DynamicResource RadiusWindow}"
                    IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#0AFFFFFF" Offset="0"/>
                  <GradientStop Color="#00FFFFFF" Offset="0.4"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <!-- Search bar row (no category column here anymore) -->
            <views:SearchBar x:Name="SearchBarControl"
                             Grid.Row="0"
                             DataContext="{Binding}"/>

            <views:ScopeBar x:Name="ScopeBarControl"
                            Grid.Row="1"
                            DataContext="{Binding}"
                            Visibility="{Binding IsScopeBarVisible, Converter={StaticResource BoolToVisibility}}"/>

            <Grid Grid.Row="2"
                  x:Name="ContentArea"
                  Visibility="Collapsed"
                  MaxHeight="424">
              <Grid.LayoutTransform>
                <ScaleTransform x:Name="ExpandedScale" ScaleY="1" />
              </Grid.LayoutTransform>
              <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Background="{DynamicResource Separator}"/>

              <Grid Grid.Row="1">
                <views:UnifiedResultsView x:Name="UnifiedResultsControl" DataContext="{Binding}" />
                <views:ClipboardManager x:Name="ClipboardManagerControl"
                                        DataContext="{Binding Clipboard}"
                                        Visibility="Collapsed"/>
              </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- Action Preview / Feedback Panel                            -->
            <!-- Shows timer countdown, AI response, color swatch, IP, etc. -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    x:Name="ActionPreviewPanel"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0"
                    Padding="12,10">
              <Grid>

              <!-- ─── TIMER ──────────────────────────────────────────────── -->
              <Grid x:Name="TimerPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="timer">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Timer.TimerDisplay}"
                           FontSize="28" FontWeight="Bold"
                           FontFamily="{DynamicResource Token.Font.Mono}"
                           HorizontalAlignment="Center"
                           Margin="0,4"/>
                <ProgressBar Grid.Row="1"
                             Value="{Binding Timer.TimerProgress}"
                             Minimum="0" Maximum="100"
                             Height="4"
                             Margin="0,8"/>
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0">
                  <Button Content="Start"
                          Command="{Binding Timer.StartCommand}"
                          Width="72" Margin="0,0,8,0"/>
                  <Button Content="Cancel"
                          Command="{Binding Timer.CancelCommand}"
                          Width="72"/>
                </StackPanel>
              </Grid>

              <!-- ─── AI ─────────────────────────────────────────────────── -->
              <Grid x:Name="AiPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="ai">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="AI Response"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,4"/>
                <ScrollViewer Grid.Row="1"
                              MaxHeight="200"
                              VerticalScrollBarVisibility="Auto">
                  <TextBlock Text="{Binding AiChat.AiText}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextPrimary}"
                             FontSize="13"/>
                </ScrollViewer>
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                  <Button Content="Copy" Click="OnActionCopyClick"
                          Width="60" Margin="0,0,8,0"/>
                  <Button Content="Close" Click="OnCloseActionPanelClick"
                          Width="60"/>
                </StackPanel>
              </Grid>

              <!-- ─── COLOR ──────────────────────────────────────────────── -->
              <Grid x:Name="ColorPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="color">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="ColorSwatch"
                          Width="36" Height="36"
                          CornerRadius="4"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"/>
                  <TextBlock Text="{Binding ActionResultText}"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="— copied"
                             VerticalAlignment="Center"
                             Margin="4,0,0,0"
                             Foreground="{DynamicResource TextTertiary}"/>
                </StackPanel>
              </Grid>

              <!-- ─── IP ─────────────────────────────────────────────────── -->
              <Grid x:Name="IpPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="ip">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel>
                  <TextBlock Text="{Binding IpPreviewText}"
                             TextWrapping="Wrap"
                             FontSize="13"/>
                </StackPanel>
              </Grid>

              <!-- ─── CURRENCY ───────────────────────────────────────────── -->
              <Grid x:Name="CurrencyPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="currency">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <TextBlock Text="{Binding ActionResultText}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           FontWeight="SemiBold"/>
              </Grid>

              <!-- ─── PASSWORD ───────────────────────────────────────────── -->
              <Grid x:Name="PasswordPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="pw">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel>
                  <TextBlock Text="{Binding ActionResultText}"
                             FontFamily="{DynamicResource Token.Font.Mono}"
                             FontSize="14"
                             TextWrapping="Wrap"
                             Margin="0,0,0,4"/>
                  <TextBlock Text="Password copied to clipboard"
                             Foreground="{DynamicResource TextTertiary}"
                             FontSize="11"/>
                </StackPanel>
              </Grid>

              <!-- ─── GENERIC (kill / screenshot / note / system / calc) ─── -->
              <Grid x:Name="GenericPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="kill">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="screenshot">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="note">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="system">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="calc">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel>
                  <TextBlock Text="{Binding ActionResultText}"
                             TextWrapping="Wrap"
                             FontSize="13"
                             FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding ActionResultSubText}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextTertiary}"
                             FontSize="11"
                             Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
              </Grid>
            </Border>

            <Border Grid.Row="4"
                    x:Name="FooterArea"
                    Visibility="Collapsed"
                    Height="34"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0">
              <TextBlock x:Name="FooterText"
                         Margin="16,0"
                         VerticalAlignment="Center"
                         FontFamily="{DynamicResource UIFont}"
                         FontSize="{DynamicResource FontHint}"
                         Foreground="{DynamicResource TextTertiary}"
                         Text="{Binding FooterHint}"/>
            </Border>

            <!-- Command palette overlay -->
            <views:CommandPalette x:Name="CommandPaletteControl"
                                  Grid.RowSpan="5"
                                  DataContext="{Binding CommandPalette}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsHitTestVisible="True"
                                  Panel.ZIndex="100"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ── Category circles — outside the capsule, slide in on hover ── -->
      <Grid x:Name="CategoryZone"
            Grid.Column="1"
            VerticalAlignment="Top"
            Height="56"
            Margin="6,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="CategoryBackButton"
                Grid.Column="0"
                Width="28"
                Height="28"
                Margin="0,0,8,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Visibility="Collapsed"
                Click="OnBackClick"
                AutomationProperties.Name="Back">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="BackButtonBg"
                      Background="{DynamicResource Depth2}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Width="28" Height="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="esc"
                           FontFamily="{DynamicResource Token.Font.Mono}"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,0,0,1"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="BackButtonBg" Property="Background" Value="{DynamicResource HoverBg}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <Border x:Name="CategoryDivider"
                Grid.Column="1"
                Width="1"
                Margin="0,10"
                Background="{DynamicResource Separator}"
                Opacity="0"/>

        <StackPanel x:Name="CategoryButtons"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="6,0,0,0"
                    Opacity="0">

          <views:CategoryCircle x:Name="CircleFiles"
                                Tag="files"
                                Label="Files"
                                AutomationProperties.Name="Files"
                                Margin="0,0,4,0"
                                IconGlyph="&#xE8A5;"
                                Click="OnCategoryClick"/>

          <views:CategoryCircle x:Name="CircleCommands"
                                Tag="actions"
                                Label="Commands"
                                AutomationProperties.Name="Commands"
                                Margin="0,0,4,0"
                                IconGlyph="&#xE756;"
                                Click="OnCategoryClick"/>

          <views:CategoryCircle x:Name="CircleClipboard"
                                Tag="clipboard"
                                Label="Clips"
                                AutomationProperties.Name="Clips"
                                IconGlyph="&#xE8C8;"
                                Click="OnCategoryClick"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>







