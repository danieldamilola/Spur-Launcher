<Window x:Class="Spur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Spur.Views"
        xmlns:conv="clr-namespace:Spur.Converters"
        Title="Spur"
        Width="640"
        MinWidth="640"
        MaxWidth="640"
        MinHeight="56"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0"
        Loaded="OnLoaded"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave">

  <Border x:Name="RootBorder"
          Background="Transparent"
          Padding="12"
          SnapsToDevicePixels="True">

    <Border.RenderTransform>
      <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>
    <Border.RenderTransformOrigin>0.5,0.08</Border.RenderTransformOrigin>

    <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
        <!-- Search capsule — shrinks/grows with SizeToContent -->
        <ColumnDefinition Width="*"/>
        <!-- Category circles — float outside to the right -->
        <ColumnDefinition x:Name="CategoryColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <!-- ── Search capsule (search bar + results only, no categories) ── -->
      <Grid Grid.Column="0" Background="Transparent">
        <Border x:Name="ShadowPlate"
                Margin="0,10,0,-4"
                CornerRadius="18"
                Background="{DynamicResource ShadowPlateBrush}"
                SnapsToDevicePixels="True"/>

        <Border x:Name="Capsule"
                HorizontalAlignment="Stretch"
                CornerRadius="{DynamicResource RadiusWindow}"
                Background="{DynamicResource SurfaceAcrylic}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                ClipToBounds="True">

          <Grid x:Name="CapsuleRoot">
            <Grid.RowDefinitions>
              <RowDefinition Height="56"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search bar row (no category column here anymore) -->
            <views:SearchBar x:Name="SearchBarControl"
                             Grid.Row="0"
                             DataContext="{Binding}"/>

            <views:ScopeBar x:Name="ScopeBarControl"
                            Grid.Row="1"
                            DataContext="{Binding}"
                            Visibility="{Binding IsScopeBarVisible, Converter={StaticResource BoolToVisibility}}"/>

            <Grid Grid.Row="2"
                  x:Name="ContentArea"
                  Visibility="Collapsed"
                  MaxHeight="424">
              <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Background="{DynamicResource Separator}"/>

              <Grid Grid.Row="1">
                <views:UnifiedResultsView DataContext="{Binding}" />
                <views:ClipboardManager x:Name="ClipboardManagerControl"
                                        DataContext="{Binding Clipboard}"
                                        Visibility="Collapsed"/>
              </Grid>
            </Grid>

            <Border Grid.Row="3"
                    x:Name="FooterArea"
                    Visibility="Collapsed"
                    Height="34"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0">
              <TextBlock x:Name="FooterText"
                         Margin="16,0"
                         VerticalAlignment="Center"
                         FontFamily="{DynamicResource UIFont}"
                         FontSize="{DynamicResource FontHint}"
                         Foreground="{DynamicResource TextTertiary}"
                         Text="{Binding FooterHint}"/>
            </Border>

            <!-- Command palette overlay -->
            <views:CommandPalette x:Name="CommandPaletteControl"
                                  Grid.RowSpan="4"
                                  DataContext="{Binding CommandPalette}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsHitTestVisible="True"
                                  Panel.ZIndex="100"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ── Category circles — outside the capsule, slide in on hover ── -->
      <Grid x:Name="CategoryZone"
            Grid.Column="1"
            VerticalAlignment="Center"
            Height="56"
            Margin="6,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="CategoryBackButton"
                Grid.Column="0"
                Width="28"
                Height="28"
                Margin="0,0,8,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Visibility="Collapsed"
                Click="OnBackClick"
                AutomationProperties.Name="Back">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="BackButtonBg"
                      Background="Transparent"
                      CornerRadius="6">
                <Path Width="14"
                      Height="14"
                      Stretch="Uniform"
                      Stroke="{DynamicResource TextSecondary}"
                      StrokeThickness="1.5"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Fill="Transparent"
                      Data="M15 18l-6-6 6-6M9 12h10"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="BackButtonBg" Property="Background" Value="{DynamicResource HoverBg}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <Border x:Name="CategoryDivider"
                Grid.Column="1"
                Width="1"
                Margin="0,10"
                Background="{DynamicResource Separator}"
                Opacity="0"/>

        <StackPanel x:Name="CategoryButtons"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="6,0,0,0"
                    Opacity="0">

          <views:CategoryCircle x:Name="CircleFiles"
                                Tag="files"
                                Label="Files"
                                AutomationProperties.Name="Files"
                                Margin="0,0,4,0"
                                IconData="{Binding Source={StaticResource Icon.Category.Files}, Converter={x:Static conv:LucideIconConverter.Instance}}"
                                Click="OnCategoryClick"/>

          <views:CategoryCircle x:Name="CircleCommands"
                                Tag="actions"
                                Label="Commands"
                                AutomationProperties.Name="Commands"
                                Margin="0,0,4,0"
                                IconData="{Binding Source={StaticResource Icon.Category.Commands}, Converter={x:Static conv:LucideIconConverter.Instance}}"
                                Click="OnCategoryClick"/>

          <views:CategoryCircle x:Name="CircleClipboard"
                                Tag="clipboard"
                                Label="Clips"
                                AutomationProperties.Name="Clips"
                                IconData="{Binding Source={StaticResource Icon.Category.Clipboard}, Converter={x:Static conv:LucideIconConverter.Instance}}"
                                Click="OnCategoryClick"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>




