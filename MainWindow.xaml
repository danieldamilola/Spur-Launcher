<Window x:Class="Spur.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:views="clr-namespace:Spur.Views"
        xmlns:conv="clr-namespace:Spur.Converters"
        Title=""
        Width="{Binding Config.BarWidth, FallbackValue=640}"
        MinHeight="56"
        Height="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0"
        Loaded="OnLoaded"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave">

  <Border x:Name="RootBorder"
          Background="Transparent"
          Padding="0"
          SnapsToDevicePixels="True">

    <Border.RenderTransform>
      <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>
    <Border.RenderTransformOrigin>0.5,0.08</Border.RenderTransformOrigin>

    <Grid Background="Transparent">
      <Grid.ColumnDefinitions>
        <!-- Search capsule — shrinks/grows with SizeToContent -->
        <ColumnDefinition Width="*"/>
        <!-- Category circles — float outside to the right -->
        <ColumnDefinition x:Name="CategoryColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <!-- ── Search capsule (search bar + results only, no categories) ── -->
      <Grid Grid.Column="0" Background="Transparent">
        <Border x:Name="Capsule"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                CornerRadius="{DynamicResource RadiusWindow}"
                BorderBrush="{DynamicResource GlassBorder}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                Margin="0,0,0,8">
          <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Direction="0" Opacity="0.35" Color="#000000"/>
          </Border.Effect>

          <Grid x:Name="CapsuleRoot" ClipToBounds="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="56"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Background Plate for WindowOpacity -->
            <Border Grid.RowSpan="5" 
                    CornerRadius="{DynamicResource RadiusWindow}"
                    Background="{DynamicResource SurfaceAcrylic}" 
                    Opacity="{Binding Config.WindowOpacity}"/>

            <!-- Liquid glass: subtle top-edge luminosity highlight -->
            <Border Grid.RowSpan="5"
                    CornerRadius="{DynamicResource RadiusWindow}"
                    IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#0AFFFFFF" Offset="0"/>
                  <GradientStop Color="#00FFFFFF" Offset="0.4"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <!-- Search bar row (no category column here anymore) -->
            <views:SearchBar x:Name="SearchBarControl"
                             Grid.Row="0"
                             DataContext="{Binding}"/>

            <views:ScopeBar x:Name="ScopeBarControl"
                            Grid.Row="1"
                            DataContext="{Binding}"
                            Visibility="{Binding IsScopeBarVisible, Converter={StaticResource BoolToVisibility}}"/>

            <Grid Grid.Row="2"
                  x:Name="ContentArea"
                  Visibility="Collapsed"
                  MaxHeight="424">
              <Grid.LayoutTransform>
                <ScaleTransform x:Name="ExpandedScale" ScaleY="1" />
              </Grid.LayoutTransform>
              <Grid.RowDefinitions>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Background="{DynamicResource Separator}"/>

              <Grid Grid.Row="1">
                <views:UnifiedResultsView x:Name="UnifiedResultsControl" DataContext="{Binding}" />
                <views:ClipboardManager x:Name="ClipboardManagerControl"
                                        DataContext="{Binding Clipboard}"
                                        Visibility="Collapsed"/>

                <!-- ═══ Quick AI Panel (Raycast-style inline AI) ═══ -->
                <Grid x:Name="QuickAiPanel" Visibility="Collapsed">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <!-- Header bar -->
                  <Border Grid.Row="0" Padding="16,10"
                          Background="{DynamicResource Depth2}"
                          BorderBrush="{DynamicResource Separator}"
                          BorderThickness="0,0,0,1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Icons/find.png" Width="16" Height="16"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Quick AI"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2"
                                 Text="Thinking..."
                                 FontFamily="{DynamicResource Token.Font.Primary}"
                                 FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                 VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding AiChat.AiLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>

                  <!-- AI response content -->
                  <ScrollViewer Grid.Row="1"
                                x:Name="QuickAiScroll"
                                VerticalScrollBarVisibility="Auto"
                                Padding="16,12">
                    <StackPanel>
                      <!-- Error message -->
                      <TextBlock Text="{Binding AiChat.AiError}"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource Red}"
                                 FontFamily="{DynamicResource Token.Font.Primary}"
                                 FontSize="13" Margin="0,0,0,8">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding AiChat.AiError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>

                      <!-- Thinking indicator -->
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <StackPanel.Style>
                          <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding AiChat.AiLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,8,0" VerticalAlignment="Center"
                                Opacity="0.6"/>
                        <TextBlock Text="Thinking..."
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="13" FontStyle="Italic"
                                   Foreground="{DynamicResource TextTertiary}"
                                   VerticalAlignment="Center"/>
                      </StackPanel>

                      <!-- AI response text -->
                      <TextBlock Text="{Binding AiChat.AiText}"
                                 TextWrapping="Wrap"
                                 FontFamily="{DynamicResource Token.Font.Primary}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 FontSize="13.5" LineHeight="21"/>
                    </StackPanel>
                  </ScrollViewer>

                  <!-- Bottom hint bar -->
                  <Border Grid.Row="2" Padding="16,8"
                          Background="{DynamicResource Depth2}"
                          BorderBrush="{DynamicResource Separator}"
                          BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="{DynamicResource Token.Font.Primary}"
                                 FontSize="11" Foreground="{DynamicResource TextTertiary}">
                        <Run Text="↵ Follow-up" FontWeight="Medium"/>
                        <Run Text="  ·  Esc Close"/>
                        <Run Text="  ·  Ctrl+C Copy"/>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- Action Preview / Feedback Panel                            -->
            <!-- Shows timer countdown, AI response, color swatch, IP, etc. -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    x:Name="ActionPreviewPanel"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0"
                    Padding="12,12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource Depth2}"
                        BorderBrush="{DynamicResource Separator}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding ActionPreviewTitle}"
                                 FontSize="13"
                                 FontWeight="Medium"
                                 Foreground="{DynamicResource TextPrimary}"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding ActionPreviewSubtitle}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextTertiary}"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                </Border>

              <!-- ─── TIMER ──────────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="TimerPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="timer">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Timer.TimerDisplay}"
                           FontSize="28" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           FontFamily="{DynamicResource Token.Font.Mono}"
                           HorizontalAlignment="Center"
                           Margin="0,4"/>
                <TextBlock Grid.Row="1"
                           Text="{Binding Timer.TimerStatus}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2"/>
                <ProgressBar Grid.Row="2"
                             Value="{Binding Timer.TimerProgress}"
                             Minimum="0" Maximum="100"
                             Height="4"
                             Margin="0,8"/>
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0">
                  <Button Command="{Binding Timer.StartCommand}" Margin="0,0,8,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                      <ui:FontIcon Glyph="&#xE768;" FontSize="13" Margin="0,0,6,0"/>
                      <TextBlock Text="Start" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Command="{Binding Timer.CancelCommand}" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                      <ui:FontIcon Glyph="&#xE711;" FontSize="13" Margin="0,0,6,0"/>
                      <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- ─── AI ─────────────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="AiPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="ai">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                  <ui:FontIcon Glyph="&#xE9D9;" FontSize="14"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Ask AI"
                             FontFamily="{DynamicResource Token.Font.Primary}"
                             FontWeight="SemiBold"
                             FontSize="13"
                             Foreground="{DynamicResource TextSecondary}"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Welcome state (shown when AiText is empty and not loading) -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,24">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding AiChat.AiLoading}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <!-- Only show when AiText is empty (no conversation yet) -->
                  <StackPanel.Resources>
                    <Style x:Key="WelcomeVis" TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding AiChat.AiText}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Resources>
                  <StackPanel Style="{StaticResource WelcomeVis}">
                    <ui:FontIcon Glyph="&#xE9D9;" FontSize="28"
                                 Foreground="{DynamicResource TextTertiary}"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,8"/>
                    <TextBlock Text="Ask AI anything"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="15"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Press Enter to ask a question"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>

                <!-- Thinking indicator -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Margin="0,24,0,24">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding AiChat.AiLoading}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <ui:FontIcon Glyph="&#xE9D9;" FontSize="14"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Thinking..."
                             FontFamily="{DynamicResource Token.Font.Primary}"
                             FontSize="13"
                             Foreground="{DynamicResource TextTertiary}"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Conversation display -->
                <ScrollViewer Grid.Row="1"
                              x:Name="AiScrollViewer"
                              MaxHeight="280"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,4">
                  <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding AiChat.AiText}" Value="">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ScrollViewer.Style>
                  <StackPanel>
                    <!-- Error message -->
                    <TextBlock Text="{Binding AiChat.AiError}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Red}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="13"
                               Margin="0,0,0,6">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Visible"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding AiChat.AiError}" Value="">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <!-- AI response text -->
                    <TextBlock Text="{Binding AiChat.AiText}"
                               TextWrapping="Wrap"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="14"
                               LineHeight="20"/>
                  </StackPanel>
                </ScrollViewer>

                <!-- Follow-up input -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSm}"
                        Padding="10,0"
                        Margin="0,4,0,0"
                        Height="36">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveActionPanel}" Value="ai">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <TextBox x:Name="AiFollowUpInput"
                             VerticalAlignment="Center"
                             FontFamily="{DynamicResource Token.Font.Primary}"
                             FontSize="13"
                             Foreground="{DynamicResource TextPrimary}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             KeyDown="OnAiFollowUpKeyDown"
                             AutomationProperties.Name="Ask a follow-up"/>
                    <TextBlock Text="Ask a follow-up..."
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="13"
                               Foreground="{DynamicResource TextTertiary}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=AiFollowUpInput}" Value="">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Border>

                <!-- Action buttons -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                  <Button Click="OnActionCopyClick" Margin="0,0,8,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                      <ui:FontIcon Glyph="&#xE8C8;" FontSize="13" Margin="0,0,6,0"/>
                      <TextBlock Text="Copy" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Click="OnCloseActionPanelClick" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                      <ui:FontIcon Glyph="&#xE711;" FontSize="13" Margin="0,0,6,0"/>
                      <TextBlock Text="Close" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- ─── COLOR ──────────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="ColorPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="color">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="ColorSwatch"
                          Width="36" Height="36"
                          CornerRadius="4"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"/>
                  <TextBlock Text="{Binding ActionResultText}"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             FontWeight="Medium"/>
                  <TextBlock Text="— copied"
                             VerticalAlignment="Center"
                             Margin="4,0,0,0"
                             Foreground="{DynamicResource TextTertiary}"/>
                </StackPanel>
              </Grid>

              <!-- ─── IP ─────────────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="IpPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="ip">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel>
                  <TextBlock Text="{Binding IpPreviewText}"
                             TextWrapping="Wrap"
                             FontSize="13"/>
                </StackPanel>
              </Grid>

              <!-- ─── CURRENCY ───────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="CurrencyPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="currency">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <TextBlock Text="{Binding ActionResultText}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           FontWeight="Medium"/>
              </Grid>

              <!-- ─── PASSWORD ───────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="PasswordPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="pw">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel>
                  <TextBlock Text="{Binding ActionResultText}"
                             FontFamily="{DynamicResource Token.Font.Mono}"
                             FontSize="14"
                             TextWrapping="Wrap"
                             Margin="0,0,0,4"/>
                  <TextBlock Text="Password copied to clipboard"
                             Foreground="{DynamicResource TextTertiary}"
                             FontSize="11"/>
                </StackPanel>
              </Grid>

              <!-- ─── CALCULATOR ──────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="CalcPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="calc">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel>
                  <TextBlock Text="{Binding ActionPreviewQuery}"
                             Foreground="{DynamicResource TextTertiary}"
                             FontSize="11"
                             Margin="0,0,0,2"/>
                  <TextBlock Text="{Binding ActionResultText}"
                             TextWrapping="Wrap"
                             FontSize="24"
                             FontFamily="{DynamicResource Token.Font.Mono}"
                             FontWeight="Medium"
                             Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
              </Grid>

              <!-- ─── KILL PROCESS ─────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="KillPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="kill">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel Orientation="Horizontal">
                  <ui:FontIcon Glyph="&#xE747;" FontSize="20"
                                 Foreground="{DynamicResource TextSecondary}"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <StackPanel>
                    <TextBlock Text="{Binding ActionResultText}"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding ActionResultSubText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- ─── SCREENSHOT ───────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="ScreenshotPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="screenshot">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel Orientation="Horizontal">
                  <ui:FontIcon Glyph="&#xE74C;" FontSize="20"
                                 Foreground="{DynamicResource TextSecondary}"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <StackPanel>
                    <TextBlock Text="{Binding ActionResultText}"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding ActionResultSubText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- ─── QUICK NOTE ───────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="NotePreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="note">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel Orientation="Horizontal">
                  <ui:FontIcon Glyph="&#xE727;" FontSize="20"
                                 Foreground="{DynamicResource TextSecondary}"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <StackPanel>
                    <TextBlock Text="{Binding ActionResultText}"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding ActionResultSubText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- ─── SYSTEM ───────────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="SystemPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="system">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel Orientation="Horizontal">
                  <ui:FontIcon Glyph="&#xE117;" FontSize="20"
                                 Foreground="{DynamicResource TextSecondary}"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <StackPanel>
                    <TextBlock Text="{Binding ActionResultText}"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding ActionResultSubText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- ─── SHELL ──────────────────────────────────────────────── -->
              <Grid Grid.Row="1" x:Name="ShellPreview">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ActiveActionPanel}" Value="shell">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>
                <StackPanel Orientation="Horizontal">
                  <ui:FontIcon Glyph="&#xE765;" FontSize="20"
                                 Foreground="{DynamicResource TextSecondary}"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <StackPanel>
                    <TextBlock Text="{Binding ActionResultText}"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{Binding ActionResultSubText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
              </Grid>
            </Border>

            <Border Grid.Row="4"
                    x:Name="FooterArea"
                    Visibility="Collapsed"
                    Height="34"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="0,1,0,0">
              <TextBlock x:Name="FooterText"
                         Margin="16,0"
                         VerticalAlignment="Center"
                          FontFamily="{DynamicResource Token.Font.Primary}"
                          FontSize="{DynamicResource FontHint}"
                         Foreground="{DynamicResource TextTertiary}"
                         Text="{Binding FooterHint}"/>
            </Border>

            <!-- Command palette overlay -->
            <views:CommandPalette x:Name="CommandPaletteControl"
                                  Grid.RowSpan="5"
                                  DataContext="{Binding CommandPalette}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsHitTestVisible="True"
                                  Panel.ZIndex="100"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ── Category circles — outside the capsule, slide in on hover ── -->
      <Grid x:Name="CategoryZone"
            Grid.Column="1"
            VerticalAlignment="Top"
            Height="56"
            Margin="6,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="CategoryBackButton"
                Grid.Column="0"
                Width="28"
                Height="28"
                Margin="0,0,8,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Visibility="Collapsed"
                Click="OnBackClick"
                AutomationProperties.Name="Back">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="BackButtonBg"
                      Background="{DynamicResource Depth2}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Width="28" Height="20"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="esc"
                           FontFamily="{DynamicResource Token.Font.Mono}"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,0,0,1"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="BackButtonBg" Property="Background" Value="{DynamicResource HoverBg}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <Border x:Name="CategoryDivider"
                Grid.Column="1"
                Width="1"
                Margin="0,10"
                Background="{DynamicResource Separator}"
                Opacity="0"/>

        <ItemsControl x:Name="CategoryButtons"
                      Grid.Column="2"
                      Margin="6,0,0,0"
                      Opacity="0"
                      ItemsSource="{Binding PinnedCategories}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <views:CategoryCircle Tag="{Binding Id}"
                                    Label="{Binding Label}"
                                    AutomationProperties.Name="{Binding Label}"
                                    Margin="0,0,4,0"
                                    IconGlyph="{Binding IconGlyph}"
                                    Click="OnCategoryClick"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>
  </Border>
</Window>
