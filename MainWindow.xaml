<Window x:Class="Arc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Arc.Views"
        Title="Arc"
        Width="440"
        MinWidth="440"
        MaxWidth="560"
        MinHeight="52"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Opacity="0"
        Loaded="OnLoaded"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave">

    <!-- Shadow bleed only — no large margin (avoids white halo) -->
    <Border x:Name="RootBorder"
            Background="Transparent"
            Padding="20"
            SnapsToDevicePixels="True">

        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.RenderTransformOrigin>0.5,0.08</Border.RenderTransformOrigin>

        <!-- Single morphing capsule (Spotlight-style) -->
        <Border x:Name="Capsule"
                HorizontalAlignment="Center"
                CornerRadius="{DynamicResource RadiusWindow}"
                Background="{DynamicResource Surface}"
                BorderThickness="0"
                SnapsToDevicePixels="True"
                ClipToBounds="True"
                Effect="{DynamicResource WindowShadow}">

            <Grid x:Name="CapsuleRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Bar row: search grows left, categories reveal on the right -->
                <Grid x:Name="BarRow" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="CategoryColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <views:SearchBar x:Name="SearchBarControl"
                                     Grid.Column="0"
                                     DataContext="{Binding}"/>

                    <Grid x:Name="CategoryZone"
                          Grid.Column="1"
                          ClipToBounds="True"
                          Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CategoryDivider"
                                Grid.Column="0"
                                Width="1"
                                Margin="0,12"
                                Background="{DynamicResource Separator}"
                                Opacity="0"/>

                        <StackPanel x:Name="CategoryButtons"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0">

                            <Button x:Name="BtnFiles"
                                    Tag="files"
                                    ToolTip="Files (Ctrl+1)"
                                    Click="OnCategoryClick"
                                    Style="{StaticResource CategoryButtonStyle}">
                                <Path x:Name="IconFiles"
                                      Data="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"
                                      Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondary}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                            </Button>

                            <Button x:Name="BtnCommands"
                                    Tag="actions"
                                    ToolTip="Commands (Ctrl+3)"
                                    Margin="4,0,0,0"
                                    Click="OnCategoryClick"
                                    Style="{StaticResource CategoryButtonStyle}">
                                <Path x:Name="IconCommands"
                                      Data="M4 17l6-6-6-6M12 19h8"
                                      Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondary}"
                                      StrokeThickness="1.5"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"/>
                            </Button>

                            <Button x:Name="BtnClipboard"
                                    Tag="clipboard"
                                    ToolTip="Clipboard (Ctrl+2)"
                                    Margin="4,0,0,0"
                                    Click="OnCategoryClick"
                                    Style="{StaticResource CategoryButtonStyle}">
                                <Path x:Name="IconClipboard"
                                      Data="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2"
                                      Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondary}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <views:ScopeBar x:Name="ScopeBarControl"
                                Grid.Row="1"
                                DataContext="{Binding}"
                                Visibility="{Binding IsScopeBarVisible, Converter={StaticResource BoolToVisibility}}"/>

                <Grid Grid.Row="2"
                      x:Name="ContentArea"
                      Visibility="Collapsed"
                      MaxHeight="420">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource Separator}"/>

                    <Grid Grid.Row="1">
                        <views:ResultsList x:Name="ResultsListControl" DataContext="{Binding}"/>
                        <views:BrowsePanel x:Name="BrowsePanelControl"
                                           DataContext="{Binding}"
                                           Visibility="Collapsed"/>
                    </Grid>
                </Grid>

                <Border Grid.Row="3"
                        x:Name="FooterArea"
                        Visibility="Collapsed"
                        Height="36"
                        BorderBrush="{DynamicResource Separator}"
                        BorderThickness="0,1,0,0">
                    <TextBlock x:Name="FooterText"
                               Margin="16,0"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource UIFont}"
                               FontSize="{DynamicResource FontHint}"
                               Foreground="{DynamicResource TextTertiary}"
                               Text="{Binding FooterHint}"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
