<ResourceDictionary xmlns:models="clr-namespace:Spur.Models" xmlns:conv="clr-namespace:Spur.Converters" xmlns:views="clr-namespace:Spur.Views"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">

    <!-- ═══════════════════════════════════════════════════════════
         COMMON CONTROL STYLES — Spur Design System
         All colour/font/geometry references use DynamicResource so
         they are resolved from whichever theme file is active.
         ═══════════════════════════════════════════════════════════ -->

    <!-- TextBox: transparent, no border, DM Sans -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily"               Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize"                 Value="{DynamicResource FontLg}"/>
        <Setter Property="Foreground"               Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background"               Value="Transparent"/>
        <Setter Property="BorderThickness"          Value="0"/>
        <Setter Property="CaretBrush"               Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush"           Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionOpacity"         Value="{DynamicResource TextSelectionOpacity}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding"                  Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="Center"
                                  Margin="0" Focusable="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: ghost style -->
    <Style TargetType="Button">
        <Setter Property="FontFamily"      Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontBase}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="12,6"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusButton}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource SurfaceLow}"/>
                            <Setter Property="Foreground"                  Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Surface}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollBar: minimal 4 px strip -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width"      Value="4"/>
        <Setter Property="MinWidth"   Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource TextMuted}"
                                                    CornerRadius="2" Width="4"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListBox: no chrome -->
    <Style TargetType="ListBox">
        <Setter Property="Background"                                    Value="Transparent"/>
        <Setter Property="BorderThickness"                               Value="0"/>
        <Setter Property="Padding"                                       Value="0"/>
        <Setter Property="HorizontalContentAlignment"                    Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"    Value="Disabled"/>
        <Setter Property="VirtualizingStackPanel.IsVirtualizing"         Value="True"/>
        <Setter Property="VirtualizingStackPanel.VirtualizationMode"     Value="Recycling"/>
        <Setter Property="ScrollViewer.CanContentScroll"                 Value="True"/>
    </Style>

    <!-- ListBoxItem: strip all default chrome; selection state is driven by XAML DataTriggers in each DataTemplate -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="Foreground"                 Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderThickness"            Value="0"/>
        <Setter Property="Padding"                    Value="0"/>
        <Setter Property="Margin"                     Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Border BorderBrush="{DynamicResource Accent}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusRow}"
                                        Margin="1"
                                        SnapsToDevicePixels="True"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton: ghost -->
    <Style TargetType="ToggleButton">
        <Setter Property="FontFamily"      Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource RadiusButton}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceLow}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Category button: 44x44 circle for floating mode controls -->
    <Style x:Key="CategoryButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Width"           Value="{DynamicResource CategoryButtonSize}"/>
        <Setter Property="Height"          Value="{DynamicResource CategoryButtonSize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource RadiusCircle}"
                            Width="{DynamicResource CategoryButtonSize}"
                            Height="{DynamicResource CategoryButtonSize}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented radio button (used in settings and elsewhere) -->
    <Style x:Key="SegmentedRadio" TargetType="RadioButton">
        <Setter Property="FontFamily"      Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSm}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextMuted}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="10,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                            <Setter Property="Foreground"                 Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: flat Spur style -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily"       Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize"         Value="{DynamicResource FontSm}"/>
        <Setter Property="Foreground"       Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background"       Value="{DynamicResource SelectedBg}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Height"           Value="32"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Full-width toggle-button just for the border + hover + chevron -->
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="6">
                                        <!-- chevron pinned to right edge -->
                                        <ui:FontIcon Glyph="&#xE70D;" FontSize="10"
                                                     Foreground="{DynamicResource TextTertiary}"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Selected item label — on top of toggle, left-aligned, no hit-test -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="10,0,26,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>

                        <!-- Required for editable mode -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Visibility="Hidden"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.4" Color="Black"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBoxItem: flat -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily"      Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize"        Value="{DynamicResource FontSm}"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Padding"         Value="12,8"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceLow}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            <Setter Property="Foreground"                 Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox: matches TextBox -->
    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily"               Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize"                 Value="{DynamicResource FontSm}"/>
        <Setter Property="Foreground"               Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background"               Value="Transparent"/>
        <Setter Property="BorderThickness"          Value="0"/>
        <Setter Property="CaretBrush"               Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush"           Value="{DynamicResource Accent}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding"                  Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="Center"
                                  Margin="0" Focusable="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider support styles (must be declared before Slider style) -->
    <!-- Filled (left of thumb) -->
    <Style x:Key="SliderRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background"            Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Height"                Value="3"/>
        <Setter Property="Focusable"             Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Empty (right of thumb) -->
    <Style x:Key="SliderIncreaseRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background"            Value="{DynamicResource SurfaceLow}"/>
        <Setter Property="Height"                Value="3"/>
        <Setter Property="Focusable"             Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width"                 Value="14"/>
        <Setter Property="Height"                Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Fill="{DynamicResource TextPrimary}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: flat Spur style -->
    <Style TargetType="Slider">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Height"           Value="22"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderRepeatButtonStyle}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderIncreaseRepeatButtonStyle}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>




    <!-- ═══════════════════════════════════════════════════════════
         SHARED RESULT TEMPLATES
         Used by ResultsList and BrowsePanel — single source of truth
         for how a SearchResult is rendered.
         ═══════════════════════════════════════════════════════════ -->


    <!-- ===== Settings Styles ===== -->
    <Style x:Key="SettingsNavButton" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{DynamicResource Token.Font.Primary}"
                                   FontSize="{DynamicResource FontBody}"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXl}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="SettingsDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="16,0"/>
        <Setter Property="Background" Value="{DynamicResource Separator}"/>
    </Style>

    <Style x:Key="SettingsKicker" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSm}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Margin" Value="4,8,0,8"/>
    </Style>

    <Style x:Key="SettingsTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="SettingsHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SettingsIconBox" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <Setter Property="Background" Value="{DynamicResource AccentGhost}"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <Style x:Key="SettingsPillGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceLow}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}"/>
        <Setter Property="Padding" Value="2"/>
    </Style>

    <Style x:Key="SettingsSoftButton" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSm}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceLow}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusMd}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsToken" TargetType="Button" BasedOn="{StaticResource SettingsSoftButton}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>

    <!-- ── Homepage category pill button ── -->
    <Style x:Key="HomeCategoryButton" TargetType="Button" BasedOn="{StaticResource SettingsSoftButton}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="SettingsInputFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceLow}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- â”€â”€ Premium CheckBox Style â”€â”€ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Border" 
                                Width="16" Height="16" 
                                Background="{DynamicResource SurfaceLow}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckMark" 
                                  Width="9" Height="9" 
                                  Stretch="Uniform" 
                                  Data="M3.5,8 L1,5.5 L2,4.5 L3.5,6 L8.5,1 L9.5,2 Z" 
                                  Fill="{DynamicResource Accent}" 
                                  Opacity="0"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" 
                                          Margin="8,0,0,0" 
                                          VerticalAlignment="Center" 
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentGhost}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Scope chip (pill-shaped filter toggle) ── -->
    <Style x:Key="ScopeChip" TargetType="Button">
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontHint}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="999"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScopeChipActive" TargetType="Button" BasedOn="{StaticResource ScopeChip}">
        <Setter Property="Background" Value="{DynamicResource SelectedBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>


    <!-- ═══════════════════════════════════════════════════════════
         Polish-pass additions
         ═══════════════════════════════════════════════════════════ -->

    <!-- Panel: card container used throughout SettingsView -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Depth1}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Divider: alias for SettingsDivider -->
    <Style x:Key="Divider" TargetType="Border" BasedOn="{StaticResource SettingsDivider}"/>

    <!-- Onboarding theme-preview surfaces (static colours; they must show
         the target theme regardless of the current theme) -->
    <SolidColorBrush x:Key="OnboardingPreviewDark"  Color="{DynamicResource Depth2}"/>
    <SolidColorBrush x:Key="OnboardingPreviewLight" Color="#F2F2F4"/>

    <!-- Shadow plate for MainWindow launcher backdrop (design.md: #000 @ 40 %) -->
    <SolidColorBrush x:Key="ShadowPlateBrush" Color="#00000000"/>

</ResourceDictionary>





