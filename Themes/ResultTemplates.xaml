<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:models="clr-namespace:Spur.Models"
    xmlns:conv="clr-namespace:Spur.Converters"
    xmlns:controls="clr-namespace:Spur.Controls">

    <!-- ═══════════════════════════════════════════════════════════
         RESULT ROW — lean template.
         Layout: [3px rail in ListBoxItem] [36px icon] [* text]
         Hover/select handled via ListBoxItem style (no storyboards).
         ═══════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="ResultTemplate" DataType="{x:Type models:SearchResult}">
        <Grid Height="{DynamicResource RowHeight}" Margin="10,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <Border Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center"
                    CornerRadius="{DynamicResource RadiusMd}">
                <Grid>
                    <Image x:Name="ItemIcon"
                           Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="Fant" RenderOptions.CachingHint="Cache">
                        <Image.Source>
                            <Binding Path="IconPath">
                                <Binding.Converter>
                                    <conv:PathToIconConverter/>
                                </Binding.Converter>
                            </Binding>
                        </Image.Source>
                    </Image>
                    <ui:FontIcon x:Name="GlyphIcon"
                                 Glyph="{Binding IconGlyph}" FontSize="15"
                                 Foreground="{DynamicResource TextSecondary}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="Collapsed"/>
                    <Image x:Name="ClipImage"
                           Width="32" Height="32" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="Fant" RenderOptions.CachingHint="Cache"
                           Source="{Binding ClipImage}" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Name + subtitle -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <controls:HighlightTextBlock SourceText="{Binding Name}"
                                             HighlightIndices="{Binding TitleHighlightData}"
                                             FontFamily="{DynamicResource Token.Font.Primary}"
                                             FontSize="{DynamicResource FontResult}" FontWeight="Medium"
                                             Foreground="{DynamicResource TextPrimary}"
                                             TextTrimming="CharacterEllipsis"
                                             ToolTip="{Binding Name}"/>
                <TextBlock Text="{Binding DisplaySubtitle}"
                           FontFamily="{DynamicResource Token.Font.Primary}"
                           FontSize="{DynamicResource FontMeta}"
                           Foreground="{DynamicResource TextTertiary}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DisplaySubtitle}"
                           Margin="0,1,0,0"/>
            </StackPanel>

            <!-- Enter hint (selected only) -->
            <TextBlock x:Name="EnterHint" Grid.Column="3"
                       Text="&#x21B5;" FontFamily="{DynamicResource Token.Font.Mono}"
                       FontSize="{DynamicResource FontMono13}"
                       Foreground="{DynamicResource TextTertiary}"
                       VerticalAlignment="Center" Margin="6,0,0,0"
                       Visibility="Collapsed"/>
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                <Setter TargetName="ItemIcon" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="GlyphIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsClipImage}" Value="True">
                <Setter TargetName="ClipImage" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ItemIcon" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="GlyphIcon" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                <Setter TargetName="EnterHint" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── ListBoxItem style: selection rail + hover/select backgrounds ── -->
    <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="3,0,0,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            SnapsToDevicePixels="True"
                            Cursor="Hand">
                        <Grid>
                            <Border x:Name="SelectionRail"
                                    Width="3" HorizontalAlignment="Left"
                                    Background="Transparent"
                                    CornerRadius="0,2,2,0"/>
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                            <Setter TargetName="SelectionRail" Property="Background" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
