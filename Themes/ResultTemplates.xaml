<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:models="clr-namespace:Spur.Models"
    xmlns:conv="clr-namespace:Spur.Converters"
    xmlns:views="clr-namespace:Spur.Views">

    <!-- ═══════════════════════════════════════════════════════════
         RESULT TEMPLATES — Spur Design System
         Single unified result row template replaces the previous
         three divergent templates (ResultRow, ClipResult, Action).
         All spacing follows 4px grid. FontWeight Medium only.
         Hover: 100ms. Selection: 50ms.
         ═══════════════════════════════════════════════════════════ -->

    <!-- ── AnimEaseOut/In are provided by Animations.xaml ── -->

    <!-- Section header (e.g. "Apps", "Files", "Clipboard") -->
    <DataTemplate x:Key="SectionHeaderTemplate" DataType="{x:Type models:SectionLabel}">
        <TextBlock Text="{Binding Title}"
                   FontFamily="{DynamicResource Token.Font.Primary}"
                   FontSize="{DynamicResource FontHint}"
                   FontWeight="Medium"
                   Foreground="{DynamicResource TextMuted}"
                   Padding="16,8,16,4"
                   TextOptions.TextFormattingMode="Display"/>
    </DataTemplate>

    <!-- Section label (with optional Clear button for Clipboard) -->
    <DataTemplate x:Key="SectionTemplate" DataType="{x:Type models:SectionLabel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       FontFamily="{DynamicResource Token.Font.Primary}"
                       FontSize="{DynamicResource FontHint}"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextMuted}"
                       Padding="16,8,16,4"
                       TextOptions.TextFormattingMode="Display"/>
            <Button Grid.Column="1"
                    Content="Clear"
                    FontFamily="{DynamicResource Token.Font.Primary}"
                    FontSize="10"
                    Foreground="{DynamicResource TextMuted}"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="8,2,10,0"
                    VerticalAlignment="Bottom"
                    Command="{Binding DataContext.ClearClipboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    AutomationProperties.Name="Clear clipboard">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Title}" Value="Clipboard">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </DataTemplate>

    <!-- ═══════════════════════════════════════════════════════════
         UNIFIED RESULT ROW — used by all result types
         Used as: ResultTemplate (full-featured), ResultRowTemplate (light)
         ═══════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="ResultTemplate" DataType="{x:Type models:SearchResult}">
        <Grid x:Name="RowRoot"
              Height="{DynamicResource RowHeight}"
              Background="Transparent"
              Cursor="Hand"
              ToolTip="{Binding Name}"
              AutomationProperties.Name="{Binding Name}">

            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Run as Administrator"
                              Command="{Binding DataContext.RunAsAdminCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              InputGestureText="Ctrl+Enter"/>
                    <MenuItem Header="Open file location"
                              Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              InputGestureText="Ctrl+Shift+E"/>
                    <MenuItem Header="Copy path"
                              Command="{Binding DataContext.CopySelectedPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              InputGestureText="Ctrl+C"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Selection rail -->
            <Border x:Name="SelectionRail"
                    Grid.Column="1"
                    Background="Transparent"
                    CornerRadius="2"
                    Margin="0,8,0,8"/>

            <!-- Row background base -->
            <Border x:Name="RowBg"
                    Grid.Column="2"
                    Background="Transparent"
                    CornerRadius="{DynamicResource RadiusRow}"/>
            <!-- Hover overlay (animated) -->
            <Border x:Name="HoverOverlay"
                    Grid.Column="2"
                    Background="{DynamicResource HoverBg}"
                    CornerRadius="{DynamicResource RadiusRow}"
                    Opacity="0"/>
            <!-- Selected overlay (animated) -->
            <Border x:Name="SelectedOverlay"
                    Grid.Column="2"
                    Background="{DynamicResource SelectedBg}"
                    CornerRadius="{DynamicResource RadiusRow}"
                    Opacity="0"/>

            <Grid Grid.Column="2" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon container -->
                <Border Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceLow}"
                        VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="AppIcon"
                               Width="24" Height="24"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="LowQuality"
                               RenderOptions.CachingHint="Cache">
                            <Image.Source>
                                <Binding Path="IconPath">
                                    <Binding.Converter>
                                        <conv:PathToIconConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <Path x:Name="LucideIcon"
                              Width="15" Height="15"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"/>
                        <!-- Clipboard image icon -->
                        <Image x:Name="ClipImage"
                               Width="28" Height="28"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="LowQuality"
                               RenderOptions.CachingHint="Cache"
                               Source="{Binding ClipImage}"
                               Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Name + subtitle -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText"
                               Text="{Binding Name}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="{DynamicResource FontResult}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="{DynamicResource FontMeta}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding DisplaySubtitle}"/>
                </StackPanel>

                <!-- Enter hint -->
                <Border x:Name="EnterHint"
                        Grid.Column="3"
                        CornerRadius="6"
                        Background="{DynamicResource SurfaceRaised}"
                        Padding="8,4"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <TextBlock Text="↵"
                               FontFamily="{DynamicResource Token.Font.Mono}"
                               FontSize="10"
                               Foreground="{DynamicResource TextTertiary}"/>
                </Border>

                <!-- Clipboard actions -->
                <StackPanel x:Name="ClipActions"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="4,0,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="PinBtn"
                            Width="26" Height="26"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Pin"
                            Tag="{Binding IsPinned}"
                            Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="4">
                                    <ui:FontIcon x:Name="PinPath" Glyph="&#xE718;" FontSize="11">
                                        <ui:FontIcon.Style>
                                            <Style TargetType="ui:FontIcon">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Tag}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:FontIcon.Style>
                                    </ui:FontIcon>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Depth3}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="26" Height="26"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Remove"
                            Command="{Binding DataContext.RemoveClipboardItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="4">
                                    <Path Width="11" Height="11" Stretch="Uniform"
                                          Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Data="M3 6h18M19 6l-1 14H6L5 6M9 6V4h6v2"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Depth3}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <DataTemplate.Triggers>
            <!-- Hover animation (unselected) — 100ms enter/exit -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.1"
                                             EasingFunction="{StaticResource AnimEaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.1"
                                             EasingFunction="{StaticResource AnimEaseIn}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>

            <!-- Selected — 50ms -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                <Setter TargetName="SelectionRail" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="EnterHint" Property="Visibility" Value="Visible"/>
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.05"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SelectedOverlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.05"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>

            <!-- No icon path → Lucide fallback -->
            <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                <Setter TargetName="AppIcon" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="LucideIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>

            <!-- Clipboard image overlay -->
            <DataTrigger Binding="{Binding IsClipImage}" Value="True">
                <Setter TargetName="ClipImage" Property="Visibility" Value="Visible"/>
                <Setter TargetName="AppIcon" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="LucideIcon" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>

            <!-- Clipboard actions on hover -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                    <Condition Binding="{Binding Type}" Value="Clipboard"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="ClipActions" Property="Visibility" Value="Visible"/>
                <Setter TargetName="EnterHint" Property="Visibility" Value="Collapsed"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Lightweight result row (no context menu, used where menus aren't needed) -->
    <DataTemplate x:Key="ResultRowTemplate" DataType="{x:Type models:SearchResult}">
        <Grid x:Name="RowRoot"
              Height="{DynamicResource RowHeight}"
              Background="Transparent"
              Cursor="Hand"
              ToolTip="{Binding Name}"
              AutomationProperties.Name="{Binding Name}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SelectionRail"
                    Grid.Column="1"
                    Background="Transparent"
                    CornerRadius="2"/>

            <Border x:Name="RowBg"
                    Grid.Column="2"
                    Background="Transparent"
                    CornerRadius="{DynamicResource RadiusRow}"/>
            <Border x:Name="HoverOverlay"
                    Grid.Column="2"
                    Background="{DynamicResource HoverBg}"
                    CornerRadius="{DynamicResource RadiusRow}"
                    Opacity="0"/>

            <Grid Grid.Column="2" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="8"
                        Background="{DynamicResource SurfaceLow}"
                        VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="AppIcon"
                               Width="24" Height="24"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="LowQuality"
                               RenderOptions.CachingHint="Cache">
                            <Image.Source>
                                <Binding Path="IconPath">
                                    <Binding.Converter>
                                        <conv:PathToIconConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <ui:FontIcon x:Name="LucideIcon"
                                       Glyph="{Binding IconGlyph}"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText"
                               Text="{Binding Name}"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="{DynamicResource FontResult}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubtitleText"
                               FontFamily="{DynamicResource Token.Font.Primary}"
                               FontSize="{DynamicResource FontMeta}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding DisplaySubtitle}"/>
                </StackPanel>

                <Border x:Name="EnterHint"
                        Grid.Column="3"
                        CornerRadius="6"
                        Background="{DynamicResource SurfaceRaised}"
                        Padding="8,4"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                    <TextBlock Text="↵"
                               FontFamily="{DynamicResource Token.Font.Mono}"
                               FontSize="10"
                               Foreground="{DynamicResource TextTertiary}"/>
                </Border>
            </Grid>
        </Grid>

        <DataTemplate.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.1"
                                             EasingFunction="{StaticResource AnimEaseOut}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.1"
                                             EasingFunction="{StaticResource AnimEaseIn}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>

            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                <Setter TargetName="SelectionRail" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="EnterHint" Property="Visibility" Value="Visible"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                <Setter TargetName="AppIcon" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="LucideIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ── Filter chip styles ── -->
    <Style x:Key="FilterChipStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontXs}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceLow}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="999"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource HoverBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterChipActiveStyle" TargetType="Button" BasedOn="{StaticResource FilterChipStyle}">
        <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <Style x:Key="ShelfHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Token.Font.Primary}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontHint}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Padding" Value="16,8,16,4"/>
    </Style>

    <!-- ResultTemplateSelector — maps data types to templates -->
    <views:ResultTemplateSelector x:Key="SharedResultTemplateSelector"
                                  SectionTemplate="{StaticResource SectionHeaderTemplate}"
                                  ResultTemplate="{StaticResource ResultRowTemplate}"/>

</ResourceDictionary>