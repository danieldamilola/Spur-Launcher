<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/DesignTokens/Colors.xaml"/>
        <ResourceDictionary Source="/Themes/DesignTokens/Typography.xaml"/>
        <ResourceDictionary Source="/Themes/DesignTokens/Spacing.xaml"/>
        <ResourceDictionary Source="/Themes/DesignTokens/Radii.xaml"/>
        <ResourceDictionary Source="/Themes/CommonStyles.xaml"/>
        <ResourceDictionary Source="/Themes/ResultTemplates.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════════════════════
         LIGHT THEME — Arc v2 (design.md §2.2)
         ═══════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="Void"            Color="#F2F2F4"/>
    <SolidColorBrush x:Key="Depth1"          Color="#F2F2F4"/>
    <SolidColorBrush x:Key="Depth2"          Color="#F7F7F8"/>
    <SolidColorBrush x:Key="Depth3"          Color="#EEEEF0"/>
    <SolidColorBrush x:Key="Depth4"          Color="#E8E8EA"/>

    <SolidColorBrush x:Key="GlassBg"         Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="GlassBorder"     Color="#1A000000"/>
    <SolidColorBrush x:Key="PreviewBg"       Color="#D9FFFFFF"/>

    <SolidColorBrush x:Key="Surface"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAcrylic"  Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceLow"      Color="#F2F2F4"/>
    <SolidColorBrush x:Key="SurfaceRaised"   Color="#F7F7F8"/>

    <SolidColorBrush x:Key="TextPrimary"     Color="#1A1A1D"/>
    <SolidColorBrush x:Key="TextSecondary"   Color="#6E6E73"/>
    <SolidColorBrush x:Key="TextMuted"       Color="#6E6E73"/>
    <SolidColorBrush x:Key="TextTertiary"    Color="#AEAEB2"/>
    <SolidColorBrush x:Key="TextInverse"     Color="#FFFFFF"/>

    <SolidColorBrush x:Key="BorderBrush"     Color="#0F000000"/>
    <SolidColorBrush x:Key="BorderStrong"    Color="#1A000000"/>
    <SolidColorBrush x:Key="Separator"       Color="#0F000000"/>

    <SolidColorBrush x:Key="SelectedBg"      Color="#EEEEF0"/>
    <SolidColorBrush x:Key="SelectedText"    Color="#1A1A1D"/>
    <SolidColorBrush x:Key="SelectedMuted"   Color="#6E6E73"/>
    <SolidColorBrush x:Key="HoverBg"         Color="#F7F7F8"/>

    <SolidColorBrush x:Key="Accent"          Color="#3A3A3D"/>
    <SolidColorBrush x:Key="BrandHighlight"  Color="#1A1A1D"/>
    <SolidColorBrush x:Key="AccentWash"      Color="#0F000000"/>
    <SolidColorBrush x:Key="AccentGhost"     Color="#0A000000"/>

    <SolidColorBrush x:Key="Green"           Color="#6B8F71"/>
    <SolidColorBrush x:Key="Orange"          Color="#A8947A"/>
    <SolidColorBrush x:Key="Red"             Color="#C45C5C"/>

    <SolidColorBrush x:Key="ToggleKnob"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleTrackOff"  Color="#AEAEB2"/>

    <sys:Double x:Key="TextSelectionOpacity">0.25</sys:Double>

    <FontFamily x:Key="UIFont">pack://application:,,,/Themes/Fonts/#Inter, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Themes/Fonts/#DM Mono, Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="FontXxs">10</sys:Double>
    <sys:Double x:Key="FontXs">11</sys:Double>
    <sys:Double x:Key="FontSm">12</sys:Double>
    <sys:Double x:Key="FontMono13">13</sys:Double>
    <sys:Double x:Key="FontBase">14</sys:Double>
    <sys:Double x:Key="FontMd">15</sys:Double>
    <sys:Double x:Key="FontIp">16</sys:Double>
    <sys:Double x:Key="FontLg">17</sys:Double>
    <sys:Double x:Key="FontXl">20</sys:Double>
    <sys:Double x:Key="FontXxl">32</sys:Double>
    <sys:Double x:Key="FontDisplay">48</sys:Double>
    <sys:Double x:Key="FontSearch">17</sys:Double>
    <sys:Double x:Key="FontResult">15</sys:Double>
    <sys:Double x:Key="FontMeta">12</sys:Double>
    <sys:Double x:Key="FontHint">11</sys:Double>
    <sys:Double x:Key="FontLabel">11</sys:Double>

    <CornerRadius x:Key="RadiusPill">14</CornerRadius>
    <CornerRadius x:Key="RadiusWindow">14</CornerRadius>
    <CornerRadius x:Key="RadiusRow">8</CornerRadius>
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusButton">6</CornerRadius>
    <CornerRadius x:Key="RadiusCircle">18</CornerRadius>

    <sys:Double x:Key="SearchBarHeight">56</sys:Double>
    <sys:Double x:Key="RowHeight">44</sys:Double>
    <sys:Double x:Key="RowHeightTall">52</sys:Double>
    <sys:Double x:Key="CategoryButtonSize">36</sys:Double>
    <sys:Double x:Key="AnchorHitSize">40</sys:Double>
    <sys:Double x:Key="WindowWidth">640</sys:Double>
    <sys:Double x:Key="WindowWidthCompact">640</sys:Double>
    <sys:Double x:Key="WindowWidthExpanded">640</sys:Double>

</ResourceDictionary>
