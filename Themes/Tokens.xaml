<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══════════════════════════════════════════════════════════════
         TOKENS — Spur Design System Shared Primitives
         Font families live here because they are shared between themes.
         All other tokens (colors, font sizes, radii, layout) are
         defined in DarkTheme.xaml / LightTheme.xaml.
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ──────────── TYPOGRAPHY — Font families ──────────────── -->
    <FontFamily x:Key="Token.Font.Primary">pack://application:,,,/Themes/Fonts/#Inter, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="Token.Font.Secondary">pack://application:,,,/Themes/Fonts/#Inter, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="Token.Font.Mono">Cascadia Code, JetBrains Mono, Fira Code, Consolas</FontFamily>

    <!-- ──────────── MISC ────────────────────────────────────── -->
    <sys:Double x:Key="Token.Misc.TextSelectionOpacity">0.25</sys:Double>

</ResourceDictionary>