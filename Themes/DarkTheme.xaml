<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Tokens.xaml"/>
        <ResourceDictionary Source="/Themes/Animations.xaml"/>
        <ResourceDictionary Source="/Themes/CommonStyles.xaml"/>
        <ResourceDictionary Source="/Themes/ResultTemplates.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════════════════════
         DARK THEME — Semantic aliases
         Color values are defined directly. All geometry/layout/font
         values are in Tokens.xaml (shared between themes).
         This file and LightTheme.xaml have the EXACT same key list.
         ═══════════════════════════════════════════════════════════ -->

    <!-- ── Surface colors ── -->
    <SolidColorBrush x:Key="Void"            Color="#09090A"/>
    <SolidColorBrush x:Key="Depth1"          Color="#101012"/>
    <SolidColorBrush x:Key="Depth2"          Color="#171719"/>
    <SolidColorBrush x:Key="Depth3"          Color="{DynamicResource HoverBg}"/>
    <SolidColorBrush x:Key="Depth4"          Color="#29292D"/>
    <SolidColorBrush x:Key="GlassBg"         Color="#80101012"/>
    <SolidColorBrush x:Key="GlassBorder"     Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="PreviewBg"       Color="#B0101012"/>
    <SolidColorBrush x:Key="Surface"         Color="#171719"/>
    <SolidColorBrush x:Key="SurfaceAcrylic"  Color="#FF171719"/>
    <SolidColorBrush x:Key="SurfaceLow"      Color="#101012"/>
    <SolidColorBrush x:Key="SurfaceRaised"   Color="{DynamicResource HoverBg}"/>

    <!-- ── Text colors ── -->
    <SolidColorBrush x:Key="TextPrimary"     Color="#F7F3EC"/>
    <SolidColorBrush x:Key="TextSecondary"   Color="#B2ADA4"/>
    <SolidColorBrush x:Key="TextMuted"       Color="#87827A"/>
    <SolidColorBrush x:Key="TextTertiary"    Color="#6B665F"/>
    <SolidColorBrush x:Key="TextInverse"     Color="#101012"/>

    <!-- ── Border colors ── -->
    <SolidColorBrush x:Key="BorderBrush"     Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="BorderStrong"    Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Separator"       Color="#10FFFFFF"/>

    <!-- ── Selection colors ── -->
    <SolidColorBrush x:Key="SelectedBg"      Color="{DynamicResource SelectedBg}"/>
    <SolidColorBrush x:Key="SelectedText"    Color="#F4F2EF"/>
    <SolidColorBrush x:Key="SelectedMuted"   Color="#9B9893"/>
    <SolidColorBrush x:Key="HoverBg"         Color="{DynamicResource HoverBg}"/>

    <!-- ── Accent colors ── -->
    <SolidColorBrush x:Key="Accent"          Color="#D7CFC2"/>
    <SolidColorBrush x:Key="BrandHighlight"  Color="#F1E9DC"/>
    <SolidColorBrush x:Key="AccentWash"      Color="#24D7CFC2"/>
    <SolidColorBrush x:Key="AccentGhost"     Color="#12D7CFC2"/>

    <!-- ── Category accent colors ── -->
    <SolidColorBrush x:Key="AccentTime"      Color="#9B9893"/>
    <SolidColorBrush x:Key="AccentAi"        Color="#9B9893"/>
    <SolidColorBrush x:Key="AccentMath"      Color="#9B9893"/>
    <SolidColorBrush x:Key="AccentNetwork"   Color="#9B9893"/>
    <SolidColorBrush x:Key="AccentFiles"     Color="#9B9893"/>
    <SolidColorBrush x:Key="AccentClipboard" Color="#9B9893"/>

    <!-- ── Semantic colors ── -->
    <SolidColorBrush x:Key="Green"           Color="#6B8F71"/>
    <SolidColorBrush x:Key="Orange"          Color="#A8947A"/>
    <SolidColorBrush x:Key="Red"             Color="#C45C5C"/>
    <SolidColorBrush x:Key="ToggleKnob"      Color="#F4F2EF"/>
    <SolidColorBrush x:Key="ToggleTrackOff"  Color="#5C5A57"/>

    <!-- ── Font sizes (legacy aliases — shared values from Tokens.xaml) ── -->
    <sys:Double x:Key="FontNano">10</sys:Double>
    <sys:Double x:Key="FontXxs">10</sys:Double>
    <sys:Double x:Key="FontMicro">11</sys:Double>
    <sys:Double x:Key="FontXs">11</sys:Double>
    <sys:Double x:Key="FontCaption">12</sys:Double>
    <sys:Double x:Key="FontSm">12</sys:Double>
    <sys:Double x:Key="FontBody">13</sys:Double>
    <sys:Double x:Key="FontMono13">13</sys:Double>
    <sys:Double x:Key="FontBase">14</sys:Double>
    <sys:Double x:Key="FontMd">15</sys:Double>
    <sys:Double x:Key="FontHeading">16</sys:Double>
    <sys:Double x:Key="FontIp">16</sys:Double>
    <sys:Double x:Key="FontLg">17</sys:Double>
    <sys:Double x:Key="FontSearch">18</sys:Double>
    <sys:Double x:Key="FontResult">13</sys:Double>
    <sys:Double x:Key="FontMeta">11</sys:Double>
    <sys:Double x:Key="FontHint">11</sys:Double>
    <sys:Double x:Key="FontLabel">11</sys:Double>
    <sys:Double x:Key="FontTitle">24</sys:Double>
    <sys:Double x:Key="FontXl">20</sys:Double>
    <sys:Double x:Key="FontXxl">32</sys:Double>
    <sys:Double x:Key="FontHero">48</sys:Double>
    <sys:Double x:Key="FontDisplay">48</sys:Double>

    <!-- ── Radii ── -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">16</CornerRadius>
    <CornerRadius x:Key="RadiusWindow">8</CornerRadius>
    <CornerRadius x:Key="RadiusRow">8</CornerRadius>
    <CornerRadius x:Key="RadiusButton">6</CornerRadius>
    <CornerRadius x:Key="RadiusCircle">18</CornerRadius>

    <!-- ── Layout ── -->
    <sys:Double x:Key="SearchBarHeight">56</sys:Double>
    <sys:Double x:Key="RowHeight">44</sys:Double>
    <sys:Double x:Key="RowHeightTall">52</sys:Double>
    <sys:Double x:Key="CategoryButtonSize">36</sys:Double>
    <sys:Double x:Key="AnchorHitSize">40</sys:Double>
    <sys:Double x:Key="WindowWidth">640</sys:Double>
    <sys:Double x:Key="WindowWidthCompact">640</sys:Double>
    <sys:Double x:Key="WindowWidthExpanded">640</sys:Double>

    <!-- ── Other ── -->
    <sys:Double x:Key="TextSelectionOpacity">0.25</sys:Double>

</ResourceDictionary>