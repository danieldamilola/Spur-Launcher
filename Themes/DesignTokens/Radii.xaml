<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════
       CORNER RADII — Spur v2 "Premium & Calm"
       Consistent 8–12px rounding. No sharp edges.
       ═══════════════════════════════════════════════════════════════ -->

  <CornerRadius x:Key="Token.Radius.None">0</CornerRadius>
  <CornerRadius x:Key="Token.Radius.Xs">2</CornerRadius>
  <CornerRadius x:Key="Token.Radius.Sm">4</CornerRadius>
  <CornerRadius x:Key="Token.Radius.Md">8</CornerRadius>
  <CornerRadius x:Key="Token.Radius.Lg">12</CornerRadius>
  <CornerRadius x:Key="Token.Radius.Xl">16</CornerRadius>
  <CornerRadius x:Key="Token.Radius.Pill">999</CornerRadius>
  <CornerRadius x:Key="Token.Radius.Circle">999</CornerRadius>

  <!-- ── Semantic aliases (backward compat) ── -->
  <CornerRadius x:Key="Token.Radius.Button">6</CornerRadius>
  <CornerRadius x:Key="Token.Radius.Window">8</CornerRadius>
  <CornerRadius x:Key="Token.Radius.Row">8</CornerRadius>
  <CornerRadius x:Key="Token.Radius.SearchBar">999</CornerRadius>

</ResourceDictionary>


