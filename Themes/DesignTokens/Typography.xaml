<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Inter when bundled in Themes/Fonts; Segoe fallbacks per design.md §3 -->
  <FontFamily x:Key="Token.Font.Primary">pack://application:,,,/Themes/Fonts/#Inter, Segoe UI Variable, Segoe UI</FontFamily>
  <FontFamily x:Key="Token.Font.Mono">pack://application:,,,/Themes/Fonts/#DM Mono, Cascadia Mono, Consolas</FontFamily>

  <sys:Double x:Key="Token.Font.Search">17</sys:Double>
  <sys:Double x:Key="Token.Font.Result">15</sys:Double>
  <sys:Double x:Key="Token.Font.Meta">12</sys:Double>
  <sys:Double x:Key="Token.Font.Caption">11</sys:Double>
  <sys:Double x:Key="Token.Font.Label">11</sys:Double>

  <sys:Double x:Key="Token.Spacing.Base">8</sys:Double>
  <sys:Double x:Key="Token.Spacing.Small">4</sys:Double>
  <sys:Double x:Key="Token.Spacing.Md">16</sys:Double>
  <sys:Double x:Key="Token.Spacing.Lg">24</sys:Double>

</ResourceDictionary>
