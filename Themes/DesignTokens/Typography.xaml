<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Typography tokens aligned with design system -->
  <FontFamily x:Key="Token.Font.Primary">pack://application:,,,/Themes/Fonts/#DM Sans</FontFamily>
  <FontFamily x:Key="Token.Font.Mono">pack://application:,,,/Themes/Fonts/#DM Mono</FontFamily>

  <!-- Type scale (8pt base grid where applicable) -->
  <sys:Double x:Key="Token.Font.Display">17</sys:Double>
  <sys:Double x:Key="Token.Font.BodyLg">15</sys:Double>
  <sys:Double x:Key="Token.Font.Body">13</sys:Double>
  <sys:Double x:Key="Token.Font.Caption">11</sys:Double>
  <sys:Double x:Key="Token.Font.MonoSize">13</sys:Double>

  <!-- We expose a few convenience keys used by controls -->
  <sys:Double x:Key="Token.Spacing.Base">8</sys:Double>
  <sys:Double x:Key="Token.Spacing.Small">4</sys:Double>
  <sys:Double x:Key="Token.Spacing.Md">16</sys:Double>
  <sys:Double x:Key="Token.Spacing.Lg">24</sys:Double>

</ResourceDictionary>
