<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ═══════════════════════════════════════════════════════════════
       SPACING — Spur v2 "Premium & Calm"
       Base unit 4px. Multiples: 0.5×, 1×, 1.5×, 2×, 3×, 4×, 5×, 6× ...
       ═══════════════════════════════════════════════════════════════ -->

  <!-- ── Primitive scale ── -->
  <sys:Double x:Key="Token.Spacing.2">2</sys:Double>
  <sys:Double x:Key="Token.Spacing.4">4</sys:Double>
  <sys:Double x:Key="Token.Spacing.6">6</sys:Double>
  <sys:Double x:Key="Token.Spacing.8">8</sys:Double>
  <sys:Double x:Key="Token.Spacing.12">12</sys:Double>
  <sys:Double x:Key="Token.Spacing.16">16</sys:Double>
  <sys:Double x:Key="Token.Spacing.20">20</sys:Double>
  <sys:Double x:Key="Token.Spacing.24">24</sys:Double>
  <sys:Double x:Key="Token.Spacing.32">32</sys:Double>
  <sys:Double x:Key="Token.Spacing.40">40</sys:Double>
  <sys:Double x:Key="Token.Spacing.48">48</sys:Double>
  <sys:Double x:Key="Token.Spacing.56">56</sys:Double>
  <sys:Double x:Key="Token.Spacing.64">64</sys:Double>

  <!-- ── Semantic aliases (kept for backward compat with v1 code) ── -->
  <sys:Double x:Key="Token.Spacing.Hairline">2</sys:Double>
  <sys:Double x:Key="Token.Spacing.Small">4</sys:Double>
  <sys:Double x:Key="Token.Spacing.Base">8</sys:Double>
  <sys:Double x:Key="Token.Spacing.Md">16</sys:Double>
  <sys:Double x:Key="Token.Spacing.Lg">24</sys:Double>
  <sys:Double x:Key="Token.Spacing.Xl">32</sys:Double>

  <!-- ── Layout constants ── -->
  <sys:Double x:Key="Token.Layout.SearchBarHeight">56</sys:Double>
  <sys:Double x:Key="Token.Layout.RowHeight">44</sys:Double>
  <sys:Double x:Key="Token.Layout.RowHeightTall">52</sys:Double>
  <sys:Double x:Key="Token.Layout.CategoryButtonSize">36</sys:Double>
  <sys:Double x:Key="Token.Layout.AnchorHitSize">40</sys:Double>
  <sys:Double x:Key="Token.Layout.WindowWidth">640</sys:Double>
  <sys:Double x:Key="Token.Layout.WindowWidthCompact">640</sys:Double>
  <sys:Double x:Key="Token.Layout.WindowWidthExpanded">640</sys:Double>

</ResourceDictionary>

