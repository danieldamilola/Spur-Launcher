<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Design tokens — Colors
       These tokens mirror the visual design system (light/dark variants included).
       Keys are intentionally namespaced to avoid colliding with existing theme keys.
  -->

  <!-- Backgrounds -->
  <SolidColorBrush x:Key="Token.Bg.Base.Light" Color="#F5F5F7" />
  <SolidColorBrush x:Key="Token.Bg.Surface.Light" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Token.Bg.Elevated.Light" Color="#FFFFFF" />

  <SolidColorBrush x:Key="Token.Bg.Base.Dark" Color="#141414" />
  <SolidColorBrush x:Key="Token.Bg.Surface.Dark" Color="#1C1C1E" />
  <SolidColorBrush x:Key="Token.Bg.Elevated.Dark" Color="#242426" />

  <!-- Text -->
  <SolidColorBrush x:Key="Token.Text.Primary.Light" Color="#1C1C1E" />
  <SolidColorBrush x:Key="Token.Text.Secondary.Light" Color="#6E6E73" />
  <SolidColorBrush x:Key="Token.Text.Tertiary.Light" Color="#AEAEB2" />

  <SolidColorBrush x:Key="Token.Text.Primary.Dark" Color="#F5F5F7" />
  <SolidColorBrush x:Key="Token.Text.Secondary.Dark" Color="#8E8E93" />
  <SolidColorBrush x:Key="Token.Text.Tertiary.Dark" Color="#48484A" />

  <!-- Accent -->
  <SolidColorBrush x:Key="Token.Accent" Color="#0A84FF" />
  <SolidColorBrush x:Key="Token.Accent.Subtle.Light" Color="#1A84FF1F" />
  <SolidColorBrush x:Key="Token.Accent.Subtle.Dark" Color="#261A84FF" />

  <!-- Semantic -->
  <SolidColorBrush x:Key="Token.Destructive.Light" Color="#FF3B30" />
  <SolidColorBrush x:Key="Token.Destructive.Dark" Color="#FF453A" />

  <!-- Borders -->
  <SolidColorBrush x:Key="Token.Border.Light" Color="#14000000" />
  <SolidColorBrush x:Key="Token.Border.Dark" Color="#0FFFFFFF" />

</ResourceDictionary>
