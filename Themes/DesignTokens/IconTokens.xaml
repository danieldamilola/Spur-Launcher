<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon Tokens — Semantic icon keys mapped to Lucide icon names.
  
  All icons use Lucide (lucide.dev, MIT license). The LucideIconConverter
  resolves these string names to Path geometries at runtime.
  
  Data-driven icons (SearchResult.LucideIcon assigned in C#) also use Lucide
  names directly — those will be migrated to token keys in a follow-up pass
  once a TokenKey → LucideName lookup is added to LucideIconConverter.
  
  References in XAML:
    IconData="{Binding Source={StaticResource Icon.Category.Files},
                       Converter={x:Static conv:LucideIconConverter.Instance}}"
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  Category Icons (MainWindow navigation tabs)                   -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <sys:String x:Key="Icon.Category.Files"     >folder</sys:String>
    <sys:String x:Key="Icon.Category.Commands"  >terminal</sys:String>
    <sys:String x:Key="Icon.Category.Clipboard" >clipboard</sys:String>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  Settings Icons (SettingsView tabs)                            -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <sys:String x:Key="Icon.Settings.Close"      >x</sys:String>
    <sys:String x:Key="Icon.Settings.Appearance" >palette</sys:String>
    <sys:String x:Key="Icon.Settings.Theme"      >moon</sys:String>
    <sys:String x:Key="Icon.Settings.Hotkey"     >zap</sys:String>
    <sys:String x:Key="Icon.Settings.Behavior"   >cpu</sys:String>
    <sys:String x:Key="Icon.Settings.AI"         >sparkles</sys:String>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  Action Icons (assigned via SearchResult.LucideIcon in C#)     -->
    <!--  Documented here for discoverability; used at runtime.         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--
    Icon.Action.Calculator   = calculator
    Icon.Action.Timer        = timer
    Icon.Action.ColorPicker  = palette
